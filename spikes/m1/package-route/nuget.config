<?xml version="1.0" encoding="utf-8"?>
<!-- The SDK isn't published yet: `dotnet pack src/Sprig.Sdk -c Release -o artifacts/feed` puts it here. IDEs read
     this file too, so IntelliSense restores the same package as dotnet run. -->
<configuration>
  <packageSources>
    <add key="sprig-local" value="../../../artifacts/feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="sprig-local">
      <package pattern="Sprig.Sdk" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
