<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="using:System"
             xmlns:local="clr-namespace:Sprig.App"
             x:Class="Sprig.App.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <FluentTheme />

        <!-- Fluent's default selection is an off-palette purple. It was invisible while no page
             auto-selected a row; the Shared page does, so bring it in line with the nav's active
             state (the same accent tint) for every list in the app. -->
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2660A5FA" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3360A5FA" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2660A5FA" />
        </Style>
        <Style Selector="ListBoxItem:selected:focus:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#3360A5FA" />
        </Style>
    </Application.Styles>

    <Application.Resources>
        <!-- Max width of the list pane on every page; past this only the detail pane grows. -->
        <sys:Double x:Key="ListPaneMaxWidth">600</sys:Double>

        <!-- Dark palette (shared with perch's look). -->
        <SolidColorBrush x:Key="FormBgBrush" Color="#181820" />
        <SolidColorBrush x:Key="PanelBgBrush" Color="#1F1F2A" />
        <SolidColorBrush x:Key="FgBrush" Color="#E1E1EB" />
        <SolidColorBrush x:Key="TitleBrush" Color="#F5F5FA" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8C8CA0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#60A5FA" />
        <SolidColorBrush x:Key="BorderBrush" Color="#2D2D3C" />
        <SolidColorBrush x:Key="ButtonBgBrush" Color="#2D2D3C" />
        <SolidColorBrush x:Key="OkBrush" Color="#4ADE80" />
        <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
        <SolidColorBrush x:Key="DangerBrush" Color="#F87171" />
        <SolidColorBrush x:Key="DevBrush" Color="#FF5FB0" />
        <!-- Shared/pooled infrastructure. Teal throughout, so "shared with other workspaces" never
             reads the same as the blue used for a workspace's own isolated resources. -->
        <SolidColorBrush x:Key="PoolBrush" Color="#2DD4BF" />
        <SolidColorBrush x:Key="PoolDimBrush" Color="#1D5C52" />
    </Application.Resources>
</Application>
