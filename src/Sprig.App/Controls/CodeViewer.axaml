<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ae="using:AvaloniaEdit"
             x:Class="Sprig.App.Controls.CodeViewer">
    <ae:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True" FontSize="13"
                   FontFamily="Cascadia Code,Cascadia Mono,Consolas,monospace"
                   Foreground="{StaticResource FgBrush}" Background="Transparent"
                   LineNumbersForeground="{StaticResource MutedBrush}" Padding="8"
                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />
</UserControl>
