<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sprig.App.ViewModels"
             xmlns:controls="using:Sprig.App.Controls"
             x:Class="Sprig.App.Controls.ComposeOverlay"
             x:DataType="vm:ComposeOverlayViewModel"
             x:Name="Root">

  <UserControl.Styles>
    <Style Selector="TextBlock.phead">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.run">
      <Setter Property="FontFamily" Value="Consolas,monospace" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.mono">
      <Setter Property="FontFamily" Value="Consolas,monospace" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
    </Style>

    <!-- Inline clickable value token -->
    <Style Selector="Button.tok">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="BorderBrush" Value="#664ADE80" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Padding" Value="2,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="FontFamily" Value="Consolas,monospace" />
      <Setter Property="FontSize" Value="12.5" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.tok /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.tok:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1A4ADE80" />
    </Style>
    <Style Selector="Button.tok.applied">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.tok.applied /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#2660A5FA" />
    </Style>
    <!-- applied, but references an input that isn't declared yet → red, like the token editor -->
    <Style Selector="Button.tok.applied.invalidref">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
    <Style Selector="Button.tok.applied.invalidref /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#26F87171" />
    </Style>

    <!-- replacements list value: accent normally, red when it names an undeclared input -->
    <Style Selector="TextBlock.rw">
      <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.rw.invalid">
      <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    </Style>
  </UserControl.Styles>

  <StackPanel Spacing="10">

    <TextBlock Classes="phead" TextWrapping="Wrap"
               Text="Click any value to replace it with a ${sprig.*} template — resolved per workspace when it's created." />

    <!-- Parse failure: show the file read-only, no tokens -->
    <Border IsVisible="{Binding HasError}" CornerRadius="6" Padding="10,8"
            Background="#332A1D05" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1">
      <StackPanel Spacing="4">
        <TextBlock Text="Couldn't parse this compose file for the interactive view."
                   Foreground="{StaticResource WarnBrush}" FontWeight="SemiBold" FontSize="12" />
        <TextBlock Text="{Binding Error}" Classes="mono" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}" />
      </StackPanel>
    </Border>

    <!-- YAML stage -->
    <Border CornerRadius="6" Background="{StaticResource FormBgBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <!-- Horizontal scroll disabled so the width is constrained and long lines wrap (WrapPanel)
           instead of running off-screen. -->
      <!-- Inset lives on the content (Margin), not the ScrollViewer (Padding): ScrollViewer.Padding
           insets the viewport, so the bottom inset never scrolls into view and the last line sits
           flush against the fold. A Margin is part of the scrollable extent, so it scrolls in. -->
      <ScrollViewer HorizontalScrollBarVisibility="Disabled" MaxHeight="420">
        <ItemsControl ItemsSource="{Binding Lines}" Margin="14,12">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComposeLineViewModel">
              <ItemsControl ItemsSource="{Binding Runs}" MinHeight="19">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ComposeRunViewModel">
                    <Panel>
                      <Button Classes="tok" Classes.applied="{Binding IsApplied}"
                              Classes.invalidref="{Binding ReferencesUnknownInput}"
                              IsVisible="{Binding IsToken}">
                        <TextBlock Text="{Binding Display}" TextWrapping="Wrap" />
                        <Button.Flyout>
                          <Flyout FlyoutPresenterClasses="cardflyout">
                            <Border Padding="14" MinWidth="380" MaxWidth="480">
                            <StackPanel Spacing="9">
                              <StackPanel Spacing="2">
                                <TextBlock Text="{Binding KindLabel}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding PopoverName}" Classes="mono" FontWeight="SemiBold" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Spacing="3">
                                <TextBlock Text="CURRENT" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding OriginalText}" Classes="mono" TextWrapping="Wrap" />
                              </StackPanel>
                              <StackPanel Spacing="3">
                                <TextBlock Text="REPLACE WITH" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                <controls:SprigTokenBox Value="{Binding Draft, Mode=TwoWay}"
                                                        Variables="{Binding #Root.((vm:ComposeOverlayViewModel)DataContext).Variables}"
                                                        Watermark="${sprig.workspace}" />
                              </StackPanel>
                              <TextBlock Text="{Binding Note}" Foreground="{StaticResource MutedBrush}"
                                         FontSize="12" TextWrapping="Wrap" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Apply"
                                        Background="{StaticResource AccentBrush}" Foreground="#0B1220"
                                        Command="{Binding #Root.((vm:ComposeOverlayViewModel)DataContext).ApplyCommand}"
                                        CommandParameter="{Binding}" />
                                <Button Content="Remove" IsVisible="{Binding IsApplied}"
                                        Foreground="{StaticResource DangerBrush}"
                                        Command="{Binding #Root.((vm:ComposeOverlayViewModel)DataContext).RemoveCommand}"
                                        CommandParameter="{Binding}" />
                              </StackPanel>
                            </StackPanel>
                            </Border>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                      <TextBlock Classes="run" Text="{Binding Display}" IsVisible="{Binding !IsToken}"
                                 TextWrapping="Wrap" />
                    </Panel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Inspector: the applied replacements -->
    <Border CornerRadius="6" Padding="14,12" IsVisible="{Binding HasOverrides}"
            Background="{StaticResource FormBgBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
      <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Grid.Column="0" Text="REPLACEMENTS" Classes="phead" VerticalAlignment="Center" />
          <TextBlock Grid.Column="1" Text="{Binding OverrideCount}" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </Grid>
        <ItemsControl ItemsSource="{Binding Overrides}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ComposeOverrideViewModel">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" Margin="0,3">
                <TextBlock Grid.Column="0" Text="{Binding Group}" Classes="mono" Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" MinWidth="56" />
                <StackPanel Grid.Column="1" Spacing="1">
                  <TextBlock Text="{Binding Label}" FontSize="12.5" Foreground="{StaticResource FgBrush}" />
                  <TextBlock Text="{Binding Rewrite}" Classes="mono rw" TextWrapping="Wrap"
                             Classes.invalid="{Binding ReferencesUnknownInput}" />
                </StackPanel>
                <Button Grid.Column="2" Content="✕" VerticalAlignment="Center" Foreground="{StaticResource DangerBrush}"
                        Command="{Binding #Root.((vm:ComposeOverlayViewModel)DataContext).RemoveCommand}"
                        CommandParameter="{Binding Run}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
