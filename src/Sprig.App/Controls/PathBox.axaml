<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sprig.App.Controls.PathBox">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
        <AutoCompleteBox x:Name="Box" Grid.Column="0" MinWidth="0"
                         FilterMode="None" MinimumPrefixLength="0" IsTextCompletionEnabled="False"
                         FontFamily="Cascadia Mono,Consolas,monospace" />
        <Button x:Name="BrowseButton" Grid.Column="1" Padding="9,5" VerticalAlignment="Stretch"
                Background="{StaticResource ButtonBgBrush}" ToolTip.Tip="Browse…">
            <PathIcon Width="16" Height="16" Foreground="{StaticResource FgBrush}"
                      Data="M2 4.5A1.5 1.5 0 0 1 3.5 3h4.38a1.5 1.5 0 0 1 1.06.44L10.5 5H20.5A1.5 1.5 0 0 1 22 6.5v12A1.5 1.5 0 0 1 20.5 20h-17A1.5 1.5 0 0 1 2 18.5z" />
        </Button>
    </Grid>
</UserControl>
