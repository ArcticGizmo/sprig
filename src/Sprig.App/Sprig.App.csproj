<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>WinExe</OutputType>
    <RootNamespace>Sprig.App</RootNamespace>
    <AssemblyName>sprig-gui</AssemblyName>
    <Product>Sprig</Product>
    <Company>Sprig</Company>
    <Description>Worktree + infrastructure isolation for any git repo.</Description>
    <Version>0.7.4</Version>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\sprig.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Publish-only size settings: the untrimmed self-contained runtime is most of the install. Partial
       mode trims just the framework and trim-annotated libraries (Avalonia), keeping sprig's own
       assemblies whole so ViewLocator's Type.GetType and the reflection-based JSON/YAML models still
       work. Trimming switches STJ's reflection serializer off by default; sprig relies on it. The analyzer
       would flag that reflection on every build even though partial mode keeps it safe, so it's left to
       the publish-time trimmer to report. -->
  <PropertyGroup>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- The changelog is embedded so the app can render it at runtime — the About "What's new"
         viewer and the post-update window both read it (assembly manifest name "Sprig.CHANGELOG.md"). -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="Sprig.CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sprig.Core\Sprig.Core.csproj" />
  </ItemGroup>

</Project>
