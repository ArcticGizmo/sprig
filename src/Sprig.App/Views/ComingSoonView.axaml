<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sprig.App.ViewModels"
             x:Class="Sprig.App.Views.ComingSoonView"
             x:DataType="vm:ComingSoonViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="680" Margin="32,36,32,32" HorizontalAlignment="Stretch" Spacing="20">
            <TextBlock Text="{Binding Title}" FontSize="22" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}" />

            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="24,22">
                <StackPanel Spacing="10">
                    <TextBlock Text="{Binding MilestoneLabel}" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.5"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Body}" FontSize="13.5" TextWrapping="Wrap"
                               Foreground="{StaticResource FgBrush}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
