<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sprig.App.ViewModels"
             xmlns:controls="clr-namespace:Sprig.App.Controls"
             x:Class="Sprig.App.Views.DefinitionEditorView"
             x:DataType="vm:DefinitionEditorViewModel">

    <UserControl.Styles>
        <!-- Colours that change with state live in styles: a local Foreground would beat them. -->
        <Style Selector="TextBlock.msg">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="TextBlock.bad">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
    </UserControl.Styles>

    <!-- Saving approves what was saved, then the page says what the save means -->
    <DockPanel>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel Spacing="2">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                <TextBlock Text="{Binding Note}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" VerticalAlignment="Top"
                    HotKey="Ctrl+S" ToolTip.Tip="Save, approve and check again (Ctrl+S)"
                    Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="14,6" />
            <Button Grid.Column="2" Content="Close" Command="{Binding CloseCommand}" VerticalAlignment="Top"
                    Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="14,6" />
        </Grid>
        <Border DockPanel.Dock="Top" Margin="0,10,0,0" Padding="12,8" CornerRadius="8" Background="#3A2F12"
                IsVisible="{Binding ConfirmingDiscard}">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="It has changes you haven't saved." FontSize="12.5" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="Keep editing" Command="{Binding KeepEditingCommand}"
                        Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="10,4" />
                <Button Grid.Column="2" Content="Discard them" Command="{Binding CloseCommand}"
                        Background="Transparent" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}"
                        BorderThickness="1" Padding="10,3" />
            </Grid>
        </Border>
        <!-- Always takes its line, so the editor below doesn't jump when a message comes or goes -->
        <TextBlock DockPanel.Dock="Top" Classes="msg" Margin="0,8,0,0" Height="18" Text="{Binding Status}" FontSize="12.5"
                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Status}"
                   Classes.bad="{Binding StatusBad}" />
        <Border Margin="0,12,0,0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" ClipToBounds="True">
            <controls:CodeEditor Text="{Binding Text}" Language="{Binding Language}" FilePath="{Binding Path}" />
        </Border>
    </DockPanel>
</UserControl>
