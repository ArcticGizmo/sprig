<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sprig.App.ViewModels"
             x:Class="Sprig.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">

    <UserControl.Styles>
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.pill TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Border.pill.done"><Setter Property="Background" Value="#264ADE80" /></Style>
        <Style Selector="Border.pill.done TextBlock"><Setter Property="Foreground" Value="{StaticResource OkBrush}" /></Style>
        <Style Selector="Border.pill.next"><Setter Property="Background" Value="#2660A5FA" /></Style>
        <Style Selector="Border.pill.next TextBlock"><Setter Property="Foreground" Value="{StaticResource AccentBrush}" /></Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="760" Margin="32,36,32,32" HorizontalAlignment="Stretch" Spacing="24">

            <StackPanel Spacing="8">
                <TextBlock Text="EXPERIMENTAL BRANCH" FontSize="11" FontWeight="SemiBold" LetterSpacing="1.5"
                           Foreground="{StaticResource WarnBrush}" />
                <TextBlock Text="Sprig, rebuilt around code" FontSize="26" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}" TextWrapping="Wrap" />
                <TextBlock FontSize="14" Foreground="{StaticResource FgBrush}" TextWrapping="Wrap" MaxWidth="640"
                           HorizontalAlignment="Left"
                           Text="Repos describe themselves in C#, a system joins them, and sprig brings the whole thing up: worktrees, ports, env files, containers and, later, your apps in the right order. This build keeps its own store, so it never touches the released app's maps or workspaces." />
                <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           Text="The full plan is in docs/experimental-roadmap.md." />
            </StackPanel>

            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="8">
                <ItemsControl ItemsSource="{Binding Milestones}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:MilestoneItem">
                            <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="12" Margin="12,10">
                                <TextBlock Grid.Column="0" Text="{Binding Id}" FontFamily="Consolas,monospace"
                                           FontSize="13" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Top" />
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{StaticResource TitleBrush}" />
                                    <TextBlock Text="{Binding Summary}" FontSize="12.5" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="pill" Classes.done="{Binding IsDone}"
                                        Classes.next="{Binding IsNext}" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding StatusLabel}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
