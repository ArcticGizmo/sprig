<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sprig.App.ViewModels"
        x:Class="Sprig.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1280" Height="820"
        MinWidth="720" MinHeight="480"
        Background="{StaticResource FormBgBrush}"
        Icon="/Assets/sprig.ico"
        Title="Sprig">

    <Window.Styles>
        <!-- Left-nav items: chromeless buttons whose inner Border carries hover + active state. -->
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.nav /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.nav:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.navitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Button.nav:pointerover Border.navitem">
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}" />
        </Style>
        <Style Selector="Border.navitem.active">
            <Setter Property="Background" Value="#2660A5FA" />
        </Style>
        <Style Selector="Border.navitem.active > Grid > TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="216,*">

        <!-- Left nav -->
        <Border Grid.Column="0" Background="{StaticResource PanelBgBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0"
                IsEnabled="{Binding !Updater.IsActive}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,18">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image x:Name="LogoImage" Width="30" Height="30" VerticalAlignment="Center" />
                        <TextBlock Text="sprig" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Foreground="{StaticResource TitleBrush}" />
                        <!-- Dev instances write to a separate store; flag it so it's obvious at a glance. -->
                        <TextBlock Text="- DEV" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"
                                   Foreground="{StaticResource DevBrush}" IsVisible="{Binding IsDevInstance}" />
                    </StackPanel>
                    <TextBlock Text="experimental build"
                               Foreground="{StaticResource WarnBrush}" FontSize="11" Margin="0,6,0,0" />
                </StackPanel>

                <!-- Pinned to the bottom of the nav -->
                <StackPanel DockPanel.Dock="Bottom" Margin="8,4,8,10" Spacing="2">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="4,0,4,4" />
                    <!-- The accent Background is a local value so the nav hover style can't grey it out. -->
                    <Button Classes="nav" Command="{Binding UpdateNowCommand}" IsVisible="{Binding ShowUpdateNotice}">
                        <Border Classes="navitem" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="{Binding UpdateNotice}" FontSize="12.5" TextWrapping="Wrap"
                                       VerticalAlignment="Center" Foreground="#0B1220" />
                        </Border>
                    </Button>
                    <Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="{Binding Settings}">
                        <Border Classes="navitem" Classes.active="{Binding Settings.IsActive}">
                            <TextBlock Text="Settings" FontSize="14"
                                       VerticalAlignment="Center" Foreground="{StaticResource FgBrush}" />
                        </Border>
                    </Button>
                    <Button Classes="nav" Command="{Binding NavigateCommand}" CommandParameter="{Binding About}">
                        <Border Classes="navitem" Classes.active="{Binding About.IsActive}">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="About" FontSize="14"
                                           VerticalAlignment="Center" Foreground="{StaticResource FgBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding About.Version}" FontSize="11"
                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding NavItems}" Margin="8,4">
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="vm:PageViewModel" x:CompileBindings="False">
                                <Button Classes="nav"
                                        AutomationProperties.AutomationId="{Binding Title, StringFormat='nav:{0}'}"
                                        Command="{Binding $parent[ItemsControl].DataContext.NavigateCommand}"
                                        CommandParameter="{Binding}">
                                    <Border Classes="navitem" Classes.active="{Binding IsActive}">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}" FontSize="14" Foreground="{StaticResource FgBrush}" />
                                                <TextBlock Text="{Binding NavSubtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                           IsVisible="{Binding HasNavSubtitle}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Border Grid.Column="1" IsVisible="{Binding ShowNavCount}"
                                                    Background="{StaticResource ButtonBgBrush}" CornerRadius="10"
                                                    Padding="7,1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding NavCount}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" IsEnabled="{Binding !Updater.IsActive}" />

        <!-- Update overlay: dims and blocks the whole window from the "update" click until Velopack takes the
             process over, so nothing can be changed mid-install. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" ZIndex="100" Background="#B3060A12"
                IsVisible="{Binding Updater.IsActive}">
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Image x:Name="UpdateLogoImage" Width="26" Height="26" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Updater.Heading}" FontSize="17" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Foreground="{StaticResource TitleBrush}" />
                    </StackPanel>
                    <ProgressBar Height="6" Minimum="0" Maximum="100"
                                 Value="{Binding Updater.Percent}"
                                 IsIndeterminate="{Binding Updater.IsIndeterminate}" />
                    <TextBlock Text="{Binding Updater.Detail}" FontSize="13" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
