<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sprig.App.ViewModels"
             xmlns:core="clr-namespace:Sprig.Core.Maps;assembly=Sprig.Core"
             xmlns:controls="clr-namespace:Sprig.App.Controls"
             x:Class="Sprig.App.Views.MapsView"
             x:DataType="vm:MapsViewModel">
    <UserControl.Styles>
        <!-- The wiring summary: red while checkout would stop, green once every need is met. -->
        <Style Selector="Border.health">
            <Setter Property="Background" Value="#24F87171" />
            <Setter Property="BorderBrush" Value="#73F87171" />
        </Style>
        <Style Selector="Border.health.ready">
            <Setter Property="Background" Value="#1C4ADE80" />
            <Setter Property="BorderBrush" Value="#664ADE80" />
        </Style>
        <Style Selector="Border.health.empty">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style Selector="TextBlock.eyebrow">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Status pills: blue wired, red unmet, amber ambiguous or fixed, violet constant, grey own use/unused. -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#2160A5FA" />
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Border.pill.gap"><Setter Property="Background" Value="#24F87171" /></Style>
        <Style Selector="Border.pill.gap > TextBlock"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></Style>
        <Style Selector="Border.pill.ambiguous, Border.pill.fixed"><Setter Property="Background" Value="#24FBBF24" /></Style>
        <Style Selector="Border.pill.ambiguous > TextBlock, Border.pill.fixed > TextBlock"><Setter Property="Foreground" Value="{StaticResource WarnBrush}" /></Style>
        <Style Selector="Border.pill.constant"><Setter Property="Background" Value="#26A78BFA" /></Style>
        <Style Selector="Border.pill.constant > TextBlock"><Setter Property="Foreground" Value="{StaticResource ConstantBrush}" /></Style>
        <Style Selector="Border.pill.quiet"><Setter Property="Background" Value="#14FFFFFF" /></Style>
        <Style Selector="Border.pill.quiet > TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}" /></Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>
        <Style Selector="Border.fix">
            <Setter Property="Background" Value="{StaticResource FormBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,10" />
        </Style>
        <Style Selector="ToggleButton.tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="ToggleButton.tab:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
        </Style>
        <Style Selector="Button.ledger-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        </Style>
        <Style Selector="Button.menu-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="10,6" />
        </Style>
    </UserControl.Styles>
    <Grid Margin="28,20,24,16">
        <!-- Narrower than other pages' lists: map entries are short, and the wiring graph needs the room. -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: header, naming a new map, the map list -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,16,0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBlock Grid.Column="0" Text="Maps" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="New map" Command="{Binding NewMapCommand}"
                        Background="{StaticResource AccentBrush}" Foreground="#0B1220" IsVisible="{Binding !IsNaming}" />
            </Grid>

            <Border Grid.Row="1" Classes="card" IsVisible="{Binding IsNaming}" Margin="0,0,0,12">
                <StackPanel Spacing="8">
                    <TextBlock Classes="eyebrow" Text="NEW MAP" />
                    <TextBox PlaceholderText="map name" Text="{Binding NewMapName}" />
                    <TextBlock Text="{Binding NameError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12"
                               IsVisible="{Binding NameError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Create" Command="{Binding CreateMapCommand}" IsDefault="True"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                        <Button Content="Cancel" Command="{Binding CancelNewMapCommand}" />
                    </StackPanel>
                    <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="It opens as an empty graph; add repos to it from there." />
                </StackPanel>
            </Border>

            <ListBox Grid.Row="2" IsVisible="{Binding HasMaps}"
                     ItemsSource="{Binding Maps}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:MapDefinition">
                        <StackPanel Spacing="3" Margin="2,6" Background="Transparent">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <ItemsControl ItemsSource="{Binding Repos}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="core:MapRepo">
                                        <TextBlock Text="{Binding Name}" FontSize="11" Margin="0,0,6,0" Foreground="{StaticResource MutedBrush}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" IsVisible="{Binding !HasMaps}" VerticalAlignment="Top"
                    Padding="16" CornerRadius="8" Background="{StaticResource PanelBgBrush}"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <StackPanel Spacing="8">
                    <TextBlock Text="No maps yet" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               Text="A map lists the repos in play and wires them from their own provides/needs. Click New map to compose one." />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Right: the selected map -->
        <ScrollViewer Grid.Column="1">
            <StackPanel Spacing="16" Margin="4,2,4,4"
                        IsVisible="{Binding Selected, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding Selected.Name}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsRenaming}" />
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsRenaming}">
                        <TextBox Width="260" Text="{Binding RenameText}" />
                        <Button Content="Save" Command="{Binding SaveRenameCommand}" IsDefault="True" />
                        <Button Content="Cancel" Command="{Binding CancelRenameCommand}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Content="Rename" Command="{Binding BeginRenameCommand}" IsVisible="{Binding !IsRenaming}" />
                        <Button Content="Delete" Command="{Binding DeleteSelectedCommand}"
                                Foreground="{StaticResource DangerBrush}" />
                    </StackPanel>
                </Grid>
                <TextBlock Text="{Binding NameError}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" FontSize="12"
                           IsVisible="{Binding IsRenaming}" />

                <!-- WIRING: how a checkout would meet each need, and the fixes for what it can't -->
                <StackPanel Spacing="12" IsVisible="{Binding Wiring.HasMap}">
                    <Border Classes="health" Classes.ready="{Binding Wiring.IsReady}" Classes.empty="{Binding Wiring.IsEmpty}"
                            BorderThickness="1" CornerRadius="8" Padding="14,12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding Wiring.Headline}" FontWeight="SemiBold"
                                       Foreground="{StaticResource TitleBrush}" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding Wiring.UnreadableRepos}" IsVisible="{Binding Wiring.HasUnreadableRepos}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:UnreadableRepoRow">
                                        <Grid ColumnDefinitions="*,Auto" Margin="0,1">
                                            <TextBlock Grid.Column="0" TextWrapping="Wrap" VerticalAlignment="Center">
                                                <Run Text="• " /><Run Text="{Binding Repo}" FontWeight="SemiBold" /><Run Text=" " /><Run Text="{Binding Message}" />
                                            </TextBlock>
                                            <Button Grid.Column="1" Content="Remove from map" Command="{Binding RemoveCommand}" Margin="8,0,0,0" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding Wiring.Blockers}" IsVisible="{Binding Wiring.HasBlockers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding Wiring.Counts}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                       IsVisible="{Binding Wiring.Counts, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Wiring.Error}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding Wiring.Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                            <ToggleButton Classes="tab" Content="Graph" IsChecked="{Binding Wiring.ShowGraph, Mode=OneWay}"
                                          Command="{Binding Wiring.ShowGraphViewCommand}" />
                            <ToggleButton Classes="tab" Content="Ledger" IsChecked="{Binding Wiring.ShowLedger, Mode=OneWay}"
                                          Command="{Binding Wiring.ShowLedgerViewCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="Drag to move · Ctrl+scroll to zoom · click a node to focus it" FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"
                                       IsVisible="{Binding Wiring.ShowGraph}" />
                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding Wiring.ShowGraph}">
                                <Button Content="−" Command="{Binding Wiring.ZoomOutCommand}" Padding="10,2" ToolTip.Tip="Zoom out" />
                                <Button Content="{Binding Wiring.ZoomText}" Command="{Binding Wiring.ZoomResetCommand}" Padding="8,2"
                                        MinWidth="56" ToolTip.Tip="Back to 100%" />
                                <Button Content="+" Command="{Binding Wiring.ZoomInCommand}" Padding="10,2" ToolTip.Tip="Zoom in" />
                                <Button Content="Fit" Click="FitClicked" Padding="8,2" ToolTip.Tip="Show the whole graph" />
                            </StackPanel>
                            <!-- composing the map: add a registered repo to the graph -->
                            <Button Content="Add repo" Margin="8,0,0,0" Padding="10,2"
                                    Background="{StaticResource AccentBrush}" Foreground="#0B1220">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <StackPanel Spacing="4" MinWidth="240" MaxWidth="360">
                                            <TextBlock Classes="eyebrow" Text="ADD A REPO TO THIS MAP" Margin="4,0,4,4" />
                                            <ItemsControl ItemsSource="{Binding Wiring.AvailableRepos}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="x:String">
                                                        <Button Classes="menu-item" Content="{Binding}"
                                                                Command="{Binding $parent[UserControl].((vm:MapsViewModel)DataContext).Wiring.AddRepoCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock IsVisible="{Binding !Wiring.HasAvailableRepos}" TextWrapping="Wrap" FontSize="12" Margin="4"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       Text="Every registered repo is already in this map. Register more on the Repos page." />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="8" IsVisible="{Binding Wiring.ShowGraph}">
                        <Border Background="{StaticResource FormBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="8" Height="540" ClipToBounds="True">
                            <Panel>
                                <controls:MapWiringCanvas x:Name="Canvas" Graph="{Binding Wiring.Layout}"
                                                          SelectedId="{Binding Wiring.SelectedNodeId}"
                                                          Zoom="{Binding Wiring.Zoom}"
                                                          FitKey="{Binding Wiring.MapName}" />
                                <StackPanel IsVisible="{Binding !Wiring.HasNodes}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6">
                                    <TextBlock Text="No repos on this map yet" FontWeight="SemiBold" HorizontalAlignment="Center"
                                               Foreground="{StaticResource TitleBrush}" IsVisible="{Binding Wiring.IsEmpty}" />
                                    <TextBlock Text="Add one with Add repo, top right. Its modules appear here, wired to each other."
                                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" IsVisible="{Binding Wiring.IsEmpty}" />
                                    <TextBlock Text="None of this map's repos can be read yet, so there's nothing to draw."
                                               Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" IsVisible="{Binding !Wiring.IsEmpty}" />
                                </StackPanel>
                            </Panel>
                        </Border>
                        <WrapPanel Orientation="Horizontal" IsVisible="{Binding Wiring.HasNodes}">
                            <TextBlock FontSize="11" Margin="0,0,14,2" Foreground="{StaticResource MutedBrush}">
                                <Run Text="━━ " Foreground="{StaticResource AccentBrush}" /><Run Text="needs (points at the provider)" />
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="0,0,14,2" Foreground="{StaticResource MutedBrush}">
                                <Run Text="╍╍ " Foreground="{StaticResource WarnBrush}" /><Run Text="two providers, map must pick" />
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="0,0,14,2" Foreground="{StaticResource MutedBrush}">
                                <Run Text="╍╍ " Foreground="{StaticResource DangerBrush}" /><Run Text="nothing provides it" />
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="0,0,14,2" Foreground="{StaticResource MutedBrush}">
                                <Run Text="┈┈ " Foreground="{StaticResource WarnBrush}" /><Run Text="similar name" />
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="0,0,14,2" Foreground="{StaticResource MutedBrush}">
                                <Run Text="╍╍ " Foreground="{StaticResource ConstantBrush}" /><Run Text="constant set on the map" />
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="0,0,14,2" Foreground="{StaticResource MutedBrush}">
                                <Run Text="◆ " Foreground="{StaticResource ConstantBrush}" /><Run Text="constant provided by a module" />
                            </TextBlock>
                            <TextBlock FontSize="11" Margin="0,0,14,2" Foreground="{StaticResource MutedBrush}">
                                <Run Text="○ " /><Run Text="only its own repo uses it" />
                            </TextBlock>
                        </WrapPanel>
                    </StackPanel>

                    <Border IsVisible="{Binding Wiring.ShowLedger}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <StackPanel>
                            <Grid ColumnDefinitions="2*,2*,2*,Auto" Background="{StaticResource PanelBgBrush}">
                                <TextBlock Grid.Column="0" Classes="eyebrow" Text="CAPABILITY" Margin="10,8" />
                                <TextBlock Grid.Column="1" Classes="eyebrow" Text="PROVIDED BY" Margin="10,8" />
                                <TextBlock Grid.Column="2" Classes="eyebrow" Text="NEEDED BY" Margin="10,8" />
                                <TextBlock Grid.Column="3" Classes="eyebrow" Text="STATUS" Margin="10,8" Width="110" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Wiring.Ledger}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WiringLedgerRow">
                                        <Button Classes="ledger-row"
                                                Command="{Binding $parent[UserControl].((vm:MapsViewModel)DataContext).Wiring.SelectNodeCommand}"
                                                CommandParameter="{Binding NodeId}">
                                            <Grid ColumnDefinitions="2*,2*,2*,Auto">
                                                <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Capability}" FontSize="12"
                                                           Foreground="{StaticResource TitleBrush}" TextWrapping="Wrap" />
                                                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding ProvidedBy}" FontSize="11.5"
                                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="10,0,0,0" />
                                                <TextBlock Grid.Column="2" Classes="mono" Text="{Binding NeededBy}" FontSize="11.5"
                                                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="10,0,0,0" />
                                                <Panel Grid.Column="3" Width="110" Margin="10,0,0,0">
                                                    <Border Classes="pill" Classes.gap="{Binding IsGap}" Classes.ambiguous="{Binding IsAmbiguous}"
                                                            Classes.constant="{Binding IsConstant}" Classes.quiet="{Binding IsQuiet}"
                                                            HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Status}" />
                                                    </Border>
                                                </Panel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- VARIABLES: every need and every fixed env value, one list; a row expands to choose its value's source -->
                    <Border Classes="card" IsVisible="{Binding !Wiring.IsEmpty}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Classes="eyebrow" Text="VARIABLES" />
                                    <TextBlock Text="{Binding Wiring.VariablesTitle}" FontSize="16" FontWeight="SemiBold"
                                               Foreground="{StaticResource TitleBrush}" TextWrapping="Wrap" />
                                    <TextBlock Classes="mono" Text="{Binding Wiring.SelectionSubtitle}" FontSize="11.5"
                                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                    <Button Content="{Binding Wiring.SelectedRepo, StringFormat='Remove {0} from map'}"
                                            Command="{Binding Wiring.RemoveRepoCommand}" CommandParameter="{Binding Wiring.SelectedRepo}"
                                            IsVisible="{Binding Wiring.SelectedRepo, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                            Foreground="{StaticResource DangerBrush}" />
                                    <Button Content="Show all" Command="{Binding Wiring.ClearSelectionCommand}"
                                            IsVisible="{Binding Wiring.IsFiltered}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding Wiring.SelectionNote}" TextWrapping="Wrap" FontSize="12.5"
                                       IsVisible="{Binding Wiring.SelectionNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                            <StackPanel Spacing="6" IsVisible="{Binding Wiring.HasSelectedProvides}">
                                <TextBlock Classes="eyebrow" Text="PROVIDES" />
                                <ItemsControl ItemsSource="{Binding Wiring.SelectedProvides}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WiringProvideRow">
                                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,16,4" ToolTip.Tip="{Binding Tip}">
                                                <TextBlock Classes="mono" Text="{Binding Capability}" FontSize="12" VerticalAlignment="Center" />
                                                <Border Classes="pill" Classes.quiet="{Binding IsQuiet}" Classes.constant="{Binding IsConstant}">
                                                    <TextBlock Text="{Binding UseLabel}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <TextBlock IsVisible="{Binding !Wiring.HasVariables}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                       Text="Nothing here needs anything from the map." />
                            <StackPanel Grid.IsSharedSizeScope="True" IsVisible="{Binding Wiring.HasVariables}">
                                <Grid Background="{StaticResource FormBgBrush}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="module" />
                                        <ColumnDefinition Width="Auto" SharedSizeGroup="status" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="1" Classes="eyebrow" Text="VARIABLE" Margin="0,7" />
                                    <TextBlock Grid.Column="2" Classes="eyebrow" Text="MODULE" Margin="12,7" IsVisible="{Binding Wiring.ShowModuleColumn}" />
                                    <TextBlock Grid.Column="3" Classes="eyebrow" Text="STATUS" Margin="12,7" />
                                    <TextBlock Grid.Column="4" Classes="eyebrow" Text="VALUE" Margin="12,7" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Wiring.Variables}">
                                    <ItemsControl.DataTemplates>
                                        <DataTemplate DataType="vm:WiringNeedRow">
                                            <StackPanel>
                                                <Button Classes="ledger-row" Command="{Binding ToggleCommand}" Padding="0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="module" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="status" />
                                                            <ColumnDefinition Width="3*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Panel Grid.Column="0" HorizontalAlignment="Center">
                                                            <TextBlock Text="▸" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !IsExpanded}" />
                                                            <TextBlock Text="▾" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding IsExpanded}" />
                                                        </Panel>
                                                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Name}" FontSize="12.5"
                                                                   Foreground="{StaticResource TitleBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Module}" FontSize="11.5" Margin="12,0"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   IsVisible="{Binding $parent[UserControl].((vm:MapsViewModel)DataContext).Wiring.ShowModuleColumn}" />
                                                        <Border Grid.Column="3" Classes="pill" Margin="12,0" HorizontalAlignment="Left"
                                                                Classes.gap="{Binding IsGap}" Classes.ambiguous="{Binding IsAmbiguous}"
                                                                Classes.constant="{Binding IsConstant}">
                                                            <TextBlock Text="{Binding Status}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="4" Classes="mono" Text="{Binding Value}" FontSize="12" Margin="12,0,8,0"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </Button>
                                                <Border Classes="fix" IsVisible="{Binding IsExpanded}" Margin="22,4,0,10">
                                                    <StackPanel Spacing="10">
                                                        <TextBlock Text="{Binding UsedIn}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding FallbackNote}" FontSize="12" TextWrapping="Wrap" IsVisible="{Binding IsFallback}" />

                                                        <!-- quick fixes the inspection spotted -->
                                                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasSimilar}">
                                                            <TextBlock Text="{Binding SimilarText}" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" />
                                                            <Button Content="{Binding WireSimilarLabel}" Command="{Binding WireSimilarCommand}"
                                                                    Background="{StaticResource AccentBrush}" Foreground="#0B1220" IsVisible="{Binding IsGap}" />
                                                        </StackPanel>
                                                        <StackPanel Spacing="6" IsVisible="{Binding IsAmbiguous}">
                                                            <TextBlock Text="Two repos provide it. Pick the one this variable takes its value from:" FontSize="12" TextWrapping="Wrap" />
                                                            <ItemsControl ItemsSource="{Binding Providers}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:ProviderChoice">
                                                                        <Button Content="{Binding Label}" Command="{Binding PickCommand}" />
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>

                                                        <!-- where the value comes from: a provider, whatever it's called, or a constant -->
                                                        <Grid ColumnDefinitions="120,*,Auto,Auto" ColumnSpacing="6" IsVisible="{Binding HasLinkTargets}">
                                                            <TextBlock Grid.Column="0" Classes="label" Text="From a provider" />
                                                            <ComboBox Grid.Column="1" ItemsSource="{Binding LinkTargets}" SelectedItem="{Binding LinkTarget}"
                                                                      HorizontalAlignment="Stretch" PlaceholderText="pick a provide in this map" FontSize="12">
                                                                <ComboBox.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:LinkTarget">
                                                                        <TextBlock Text="{Binding Label}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                                                                    </DataTemplate>
                                                                </ComboBox.ItemTemplate>
                                                            </ComboBox>
                                                            <Button Grid.Column="2" Content="Link" Command="{Binding LinkCommand}"
                                                                    ToolTip.Tip="Take this variable's value from that provide, even under a different name. Replaces any constant." />
                                                            <Button Grid.Column="3" Content="Unlink" Command="{Binding UnwireCommand}" IsVisible="{Binding IsWiredByEntry}"
                                                                    ToolTip.Tip="Remove the map's link and go back to matching by name" />
                                                        </Grid>

                                                        <Grid ColumnDefinitions="120,*" ColumnSpacing="6" IsVisible="{Binding !IsConstant}">
                                                            <TextBlock Grid.Column="0" Classes="label" Text="Or a constant" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                            <StackPanel Grid.Column="1" Spacing="4">
                                                                <Grid ColumnDefinitions="90,*,Auto" ColumnSpacing="6">
                                                                    <TextBox Grid.Column="0" Text="{Binding NewOutput}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" PlaceholderText="output" />
                                                                    <TextBox Grid.Column="1" Text="{Binding NewValue}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" PlaceholderText="value" />
                                                                    <Button Grid.Column="2" Content="Set constant" Command="{Binding SetConstantCommand}"
                                                                            ToolTip.Tip="The map gives it this value in every workspace, whatever repos provide" />
                                                                </Grid>
                                                                <TextBlock Text="{Binding HintSource}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                                                           TextWrapping="Wrap" IsVisible="{Binding HasHint}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <Grid ColumnDefinitions="120,*" ColumnSpacing="6" IsVisible="{Binding IsConstant}">
                                                            <TextBlock Grid.Column="0" Classes="label" Text="Constant" VerticalAlignment="Top" Margin="0,6,0,0" />
                                                            <StackPanel Grid.Column="1" Spacing="6">
                                                                <ItemsControl ItemsSource="{Binding Constants}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ConstantValueRow">
                                                                            <Grid ColumnDefinitions="90,*" ColumnSpacing="6" Margin="0,0,0,4">
                                                                                <TextBlock Grid.Column="0" Classes="mono" Text="{Binding Output}" FontSize="12"
                                                                                           VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                                                                <TextBox Grid.Column="1" Text="{Binding Value}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                                                                            </Grid>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                                    <Button Content="Save" Command="{Binding SaveConstantsCommand}" />
                                                                    <Button Content="Remove constant" Command="{Binding RemoveConstantCommand}"
                                                                            Foreground="{StaticResource DangerBrush}"
                                                                            ToolTip.Tip="Go back to taking the value from a provider" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding IsGap}"
                                                                   Text="Or add the repo that provides it with Add repo, above the graph." />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>

                                        <DataTemplate DataType="vm:FixedValueRow">
                                            <StackPanel>
                                                <Button Classes="ledger-row" Command="{Binding ToggleCommand}" Padding="0,7">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22" />
                                                            <ColumnDefinition Width="2*" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="module" />
                                                            <ColumnDefinition Width="Auto" SharedSizeGroup="status" />
                                                            <ColumnDefinition Width="3*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Panel Grid.Column="0" HorizontalAlignment="Center">
                                                            <TextBlock Text="▸" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !IsExpanded}" />
                                                            <TextBlock Text="▾" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding IsExpanded}" />
                                                        </Panel>
                                                        <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Name}" FontSize="12.5"
                                                                   Foreground="{StaticResource TitleBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Grid.Column="2" Classes="mono" Text="{Binding Module}" FontSize="11.5" Margin="12,0"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   IsVisible="{Binding $parent[UserControl].((vm:MapsViewModel)DataContext).Wiring.ShowModuleColumn}" />
                                                        <Border Grid.Column="3" Classes="pill fixed" Margin="12,0" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Status}" />
                                                        </Border>
                                                        <TextBlock Grid.Column="4" Classes="mono" Text="{Binding Value}" FontSize="12" Margin="12,0,8,0"
                                                                   TextWrapping="Wrap" />
                                                    </Grid>
                                                </Button>
                                                <Border Classes="fix" IsVisible="{Binding IsExpanded}" Margin="22,4,0,10">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="{Binding UsedIn}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Advice}" FontSize="12" TextWrapping="Wrap" />
                                                        <Grid ColumnDefinitions="Auto,160,Auto,120,Auto" ColumnSpacing="6" IsVisible="{Binding CanConvert}">
                                                            <TextBlock Grid.Column="0" Text="need" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                                            <TextBox Grid.Column="1" Text="{Binding Capability}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                                                            <TextBlock Grid.Column="2" Text="output" FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                                                            <TextBox Grid.Column="3" Text="{Binding Output}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" />
                                                            <Button Grid.Column="4" Content="Make it a need" Command="{Binding ConvertCommand}"
                                                                    ToolTip.Tip="Declares the need in the repo's config, points the env key at it, and sets today's value as the map's constant" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.DataTemplates>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
