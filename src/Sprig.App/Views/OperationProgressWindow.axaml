<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sprig.App.ViewModels"
        x:Class="Sprig.App.Views.OperationProgressWindow"
        x:DataType="vm:OperationProgressViewModel"
        Width="620" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource FormBgBrush}"
        Title="Sprig: working">

    <Window.Styles>
        <!-- A partial ring (from the dash gap) turning while a step runs. -->
        <Style Selector="Ellipse.spinner">
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto" Margin="24">
        <TextBlock Grid.Row="0" Text="{Binding Heading}" FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource TitleBrush}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" MaxHeight="460" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Steps}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:OperationStepViewModel">
                        <StackPanel Margin="0,4,0,2">
                            <Grid ColumnDefinitions="24,Auto,*" ColumnSpacing="8">
                                <Panel Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0" HorizontalAlignment="Center">
                                    <Ellipse Width="16" Height="16" StrokeThickness="1.6" Stroke="{Binding IndicatorBrush}"
                                             IsVisible="{Binding ShowStaticIndicator}" />
                                    <TextBlock Text="{Binding Glyph}" FontSize="11" FontWeight="Bold" Foreground="{Binding IndicatorBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding ShowStaticIndicator}" />
                                    <Ellipse Classes="spinner" Width="16" Height="16" StrokeThickness="2"
                                             Stroke="{StaticResource AccentBrush}" StrokeDashArray="18,7" IsVisible="{Binding IsRunning}" />
                                </Panel>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="13" Foreground="{Binding LabelBrush}"
                                           VerticalAlignment="Top" />
                                <!-- Selectable, so a failure (a docker error, say) can be copied out. -->
                                <SelectableTextBlock Grid.Column="2" Text="{Binding Detail}" FontSize="11.5" Margin="0,1,0,0"
                                                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                     IsVisible="{Binding HasDetail}" />
                            </Grid>
                            <Border IsVisible="{Binding ShowOutput}" Margin="32,4,0,2" Background="#12000000"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6">
                                <SelectableTextBlock Text="{Binding LiveOutput}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="11"
                                                     Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,18,0,0">
            <SelectableTextBlock Text="{Binding Summary}" IsVisible="{Binding HasSummary}" Foreground="{Binding SummaryBrush}"
                                 FontSize="12.5" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" />
            <Button Grid.Column="1" Content="Close" Click="OnCloseClick" IsEnabled="{Binding CanClose}" Padding="16,8"
                    FontWeight="SemiBold" Background="{StaticResource AccentBrush}" Foreground="#0B1220" VerticalAlignment="Center" />
        </Grid>
    </Grid>
</Window>
