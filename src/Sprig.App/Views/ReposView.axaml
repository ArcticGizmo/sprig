<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sprig.App.ViewModels"
             xmlns:controls="clr-namespace:Sprig.App.Controls"
             x:Class="Sprig.App.Views.ReposView"
             x:DataType="vm:ReposViewModel">

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="TextBlock.phead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.name">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
        </Style>
        <Style Selector="TextBlock.msg">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.state.up">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="TextBlock.state.failed">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.bad">
            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
        </Style>
        <!-- Where a definition is kept: the same badge everywhere -->
        <Style Selector="Border.kept">
            <Setter Property="BorderBrush" Value="#4A4A5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.kept TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#D4D4E0" />
        </Style>
        <Style Selector="Border.kept.sprig">
            <Setter Property="BorderBrush" Value="#5B4A92" />
            <Setter Property="Background" Value="#2A2340" />
        </Style>
        <Style Selector="Border.kept.sprig TextBlock">
            <Setter Property="Foreground" Value="#CFC2FF" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource SideListWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The Repos list -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="18,24,14,16">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Repos" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="+ Add" Command="{Binding OpenChooseCommand}" IsEnabled="{Binding !Editor.IsEditing}"
                                VerticalAlignment="Center"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="12,5" />
                    </Grid>
                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding IsEmpty}"
                               Text="None yet. + Add uses a repo's own sprig.cs, or writes one kept in sprig." />
                </StackPanel>
                <!-- Locked while a definition is open, so unsaved edits can't be left behind by picking another. -->
                <ListBox ItemsSource="{Binding Repos}" SelectedItem="{Binding Selected}" Background="Transparent" Margin="0,10,0,0"
                         IsEnabled="{Binding !Editor.IsEditing}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RepoItem">
                            <StackPanel Spacing="3" Margin="0,3">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding Id}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}"
                                               TextTrimming="CharacterEllipsis" />
                                    <Border Grid.Column="1" Classes="kept" Classes.sprig="{Binding !InRepo}">
                                        <TextBlock Text="{Binding Kept}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Summary}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !Editor.IsEditing}">
                <StackPanel Margin="28,24,28,28" Spacing="16" MaxWidth="1100" HorizontalAlignment="Stretch" IsVisible="{Binding HasSelection}">

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="3">
                            <TextBlock Text="{Binding Selected.Id, FallbackValue=''}" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                            <SelectableTextBlock Text="{Binding Selected.DisplayFolder, FallbackValue=''}" FontSize="12"
                                                 FontFamily="Cascadia Mono,Consolas,monospace" Foreground="{StaticResource MutedBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                                <TextBlock Text="Used by" FontSize="13" Foreground="{StaticResource FgBrush}" IsVisible="{Binding HasUsedBy}" />
                                <ItemsControl ItemsSource="{Binding UsedBy}" IsVisible="{Binding HasUsedBy}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Button Classes="link" Content="{Binding}" CommandParameter="{Binding}"
                                                    Command="{Binding $parent[UserControl].((vm:ReposViewModel)DataContext).OpenOrchestrationByIdCommand}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No orchestration uses it yet" FontSize="13" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HasUsedBy}" />
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="1" Classes="small" Content="Open definition" Command="{Binding EditCommand}" VerticalAlignment="Top"
                                IsEnabled="{Binding !Selected.Missing, FallbackValue=False}" />
                        <Button Grid.Column="2" Content="New workspace" Command="{Binding StartCommand}" VerticalAlignment="Top"
                                IsEnabled="{Binding HasModel}" ToolTip.Tip="Run this repo on its own: in place, or in worktrees of its own"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="12,6" />
                        <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveCommand}" VerticalAlignment="Top"
                                Background="Transparent" Foreground="{StaticResource DangerBrush}"
                                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Padding="12,5" />
                    </Grid>

                    <Border Classes="panel" BorderBrush="{StaticResource DangerBrush}" IsVisible="{Binding ConfirmingRemove}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="cell" Text="{Binding RemoveNote}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="small" Content="Keep it" Command="{Binding CancelRemoveCommand}" />
                                <Button Content="Remove it" Command="{Binding RemoveCommand}" Background="{StaticResource DangerBrush}"
                                        Foreground="#0B1220" FontWeight="SemiBold" Padding="12,5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Its own workspaces: the repo run on its own. Each opens on the Workspaces page, where its apps run. -->
                    <Border Classes="panel">
                        <StackPanel Spacing="9">
                            <TextBlock Classes="phead" Text="WORKSPACES" />
                            <TextBlock Classes="cell" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HasWorkspaces}"
                                       Text="None yet. New workspace runs it where it's checked out, or in worktrees of its own." />
                            <ItemsControl ItemsSource="{Binding WorkspacesOfIt}" IsVisible="{Binding HasWorkspaces}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:RepoWorkspaceRow">
                                        <Grid ColumnDefinitions="140,*,Auto" ColumnSpacing="12" Margin="0,3">
                                            <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                <TextBlock Classes="cell state" Text="{Binding State}"
                                                           Classes.up="{Binding IsUp}" Classes.failed="{Binding IsFailed}" />
                                                <TextBlock Classes="cell" Text="{Binding Where}" Foreground="{StaticResource MutedBrush}" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="link" Content="Open" CommandParameter="{Binding}"
                                                    AutomationProperties.AutomationId="{Binding Name, StringFormat='repo-workspace:{0}'}"
                                                    Command="{Binding $parent[UserControl].((vm:ReposViewModel)DataContext).OpenWorkspaceRowCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Where the file lives. Fixed for the ID; the other kind is a new entry. -->
                    <Border Classes="panel">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="16">
                            <Border Classes="kept" Classes.sprig="{Binding !Selected.InRepo, FallbackValue=False}">
                                <TextBlock Text="{Binding Selected.Kept, FallbackValue=''}" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                <TextBlock Classes="cell" Text="{Binding KeptExplanation}" />
                                <TextBlock Text="{Binding DeriveNote}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2" Classes="small" Content="{Binding DeriveLabel}" Command="{Binding OpenDeriveCommand}"
                                    VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- Running it, or why it doesn't -->
                    <StackPanel Spacing="8" IsVisible="{Binding Check, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Classes="msg" Text="{Binding Check}" FontSize="13" TextWrapping="Wrap" Classes.bad="{Binding CheckBad}" />
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NeedsApproval}">
                            <Button Classes="small" Content="Read it" Command="{Binding EditCommand}" />
                            <Button Content="Approve" Command="{Binding ApproveCommand}" Background="{StaticResource WarnBrush}"
                                    Foreground="#0B1220" FontWeight="SemiBold" Padding="12,6" />
                        </StackPanel>
                    </StackPanel>

                    <UniformGrid Columns="2" IsVisible="{Binding HasModel}">
                        <Border Classes="panel" Margin="0,0,7,14">
                            <StackPanel Spacing="9">
                                <TextBlock Classes="phead" Text="RUNS" />
                                <ItemsControl ItemsSource="{Binding Runs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RepoFact">
                                            <Grid ColumnDefinitions="110,*" Margin="0,3">
                                                <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Detail}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Classes="panel" Margin="7,0,0,14">
                            <StackPanel Spacing="9">
                                <TextBlock Classes="phead" Text="INFRA" />
                                <TextBlock Classes="cell" Text="None" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HasInfra}" />
                                <ItemsControl ItemsSource="{Binding Infra}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RepoFact">
                                            <Grid ColumnDefinitions="110,*" Margin="0,3">
                                                <TextBlock Classes="name" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Detail}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Classes="panel" Margin="0,0,7,0">
                            <StackPanel Spacing="9">
                                <TextBlock Classes="phead" Text="OFFERS" />
                                <TextBlock Classes="cell" Text="Nothing" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HasOffers}" />
                                <ItemsControl ItemsSource="{Binding Offers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RepoFact">
                                            <Grid ColumnDefinitions="110,*" Margin="0,3">
                                                <TextBlock Classes="name" Text="{Binding Name}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Detail}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Classes="panel" Margin="7,0,0,0">
                            <StackPanel Spacing="9">
                                <TextBlock Classes="phead" Text="SETTINGS" />
                                <TextBlock Classes="cell" Text="None" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HasSettings}" />
                                <ItemsControl ItemsSource="{Binding Settings}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RepoFact">
                                            <Grid ColumnDefinitions="110,*" Margin="0,3">
                                                <TextBlock Classes="name" Text="{Binding Name}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Detail}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </ScrollViewer>

            <ContentControl Content="{Binding Editor}" IsVisible="{Binding Editor.IsEditing}" Margin="24,20,24,16" />
        </Grid>

        <!-- + Add starts with a choice, so neither form's fields show until you've said which you want. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" ZIndex="50" Background="#B3060A12" IsVisible="{Binding IsChooseOpen}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelChooseCommand}" />
            </Border.KeyBindings>
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" MaxWidth="680" Margin="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Add a repo" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                        <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Does the repo have a sprig.cs already, or are you writing one?" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Button x:Name="ChooseInRepo" Classes="choice" Command="{Binding OpenAddInRepoCommand}"
                                AutomationProperties.AutomationId="repo-add:in-repo">
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="It has a sprig.cs" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               Text="Use the one committed in the repo. Each workspace runs its own branch's version." />
                                </StackPanel>
                            </Border>
                        </Button>
                        <Button Grid.Column="1" Classes="choice" Command="{Binding OpenAddInSprigCommand}"
                                AutomationProperties.AutomationId="repo-add:in-sprig">
                            <Border Classes="card">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Write one in sprig" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                               Text="Kept in sprig, so nothing is written to the repo. Starts from the folder's sprig.cs, or a draft of its projects." />
                                </StackPanel>
                            </Border>
                        </Button>
                    </Grid>
                    <Button Classes="small" Content="Cancel" Command="{Binding CancelChooseCommand}" HorizontalAlignment="Right" Padding="14,7" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Adding a repo of the chosen kind: a folder and the ID orchestrations call it by -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" ZIndex="50" Background="#B3060A12" IsVisible="{Binding IsAddOpen}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelAddCommand}" />
                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
            </Border.KeyBindings>
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" MaxWidth="680" Margin="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding AddTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="{Binding AddExplanation}" />
                    <StackPanel Spacing="4">
                        <TextBlock Classes="phead" Text="REPO FOLDER" />
                        <controls:PathBox x:Name="AddPath" Path="{Binding AddFolder}" PickFolder="True" PickerTitle="{Binding AddPickerTitle}"
                                          Placeholder="path/to/a/repo" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="phead" Text="ID" />
                        <TextBox Text="{Binding AddId}" PlaceholderText="e.g. shop-web" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="What orchestrations call it: orchestration.UseRepo(&quot;the-id&quot;). Several can describe the same folder." />
                    </StackPanel>
                    <TextBlock Text="{Binding AddMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               IsVisible="{Binding AddFailed}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <Button Content="← Back" Command="{Binding BackToChooseCommand}" HorizontalAlignment="Left"
                                Background="Transparent" Foreground="{StaticResource MutedBrush}" Padding="6,7" />
                        <Button Grid.Column="1" Classes="small" Content="Cancel" Command="{Binding CancelAddCommand}" Padding="14,7" />
                        <Button Grid.Column="2" Content="Add to Repos" Command="{Binding AddCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="14,7" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- A new entry of the other kind, made from the selected one -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" ZIndex="50" Background="#B3060A12" IsVisible="{Binding IsDeriveOpen}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelDeriveCommand}" />
                <KeyBinding Gesture="Enter" Command="{Binding DeriveCommand}" />
            </Border.KeyBindings>
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" MaxWidth="640" Margin="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding DeriveTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="{Binding DeriveExplanation}" />
                    <StackPanel Spacing="4" IsVisible="{Binding !DeriveBlocked}">
                        <TextBlock Classes="phead" Text="NEW ID" />
                        <TextBox Text="{Binding DeriveId}" PlaceholderText="e.g. shop-web" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="What orchestrations call it: orchestration.UseRepo(&quot;the-id&quot;). Point an orchestration at it yourself when you want it to switch." />
                    </StackPanel>
                    <TextBlock Text="{Binding DeriveMessage}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}"
                               IsVisible="{Binding DeriveFailed}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Classes="small" Content="Cancel" Command="{Binding CancelDeriveCommand}" />
                        <Button Content="{Binding DeriveTitle}" Command="{Binding DeriveCommand}" IsEnabled="{Binding !DeriveBlocked}"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="14,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
