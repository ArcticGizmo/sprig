<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sprig.App.ViewModels"
             xmlns:core="clr-namespace:Sprig.Core.Stacks;assembly=Sprig.Core"
             xmlns:controls="clr-namespace:Sprig.App.Controls"
             xmlns:sys="using:System"
             x:Class="Sprig.App.Views.ReposView"
             x:DataType="vm:ReposViewModel">
    <Grid Margin="28,20,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="{StaticResource ListPaneMaxWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: add + list -->
        <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*" Margin="0,0,16,0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBlock Grid.Column="0" Text="Repos" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}" VerticalAlignment="Center" />
                <!-- AutomationProperties.AutomationId doubles as the coachmark anchor (see Coach/Anchors)
                     and as accessibility/UI-automation identity. One attribute, no coach code in the view. -->
                <Button Grid.Column="1" Content="Add repo" Command="{Binding OpenAddCommand}"
                        AutomationProperties.AutomationId="repos.add"
                        Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
            </Grid>

            <StackPanel Grid.Row="1" Spacing="8" Margin="0,0,0,16"
                        IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <TextBlock Foreground="{StaticResource OkBrush}" Text="{Binding Status}" />
            </StackPanel>

            <ListBox Grid.Row="2" IsVisible="{Binding HasRepos}"
                     ItemsSource="{Binding Repos}" SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="core:RegisteredRepo">
                        <!-- Anchor id is bound from the row's own data (repo.row:<name>), so a coachmark can
                             spotlight one specific repo among many — the list-row equivalent of the canvas's
                             per-port anchors. Resolved by the same visual-tree walk as any chrome anchor. -->
                        <StackPanel Spacing="2" Margin="2,6"
                                    AutomationProperties.AutomationId="{Binding Name, StringFormat='repo.row:{0}'}">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <!-- Right: configuration view (read-only) -->
        <Border Grid.Column="1" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="18">
            <Panel>
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="No repos registered yet.&#x0a;Click &quot;Add repo&quot; to point sprig at a git repo.">
                    <TextBlock.IsVisible>
                        <Binding Path="!HasRepos" />
                    </TextBlock.IsVisible>
                </TextBlock>
                <TextBlock Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center"
                           Text="Select a repo to view its&#x0a;.sprig.json configuration">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasRepos" />
                            <Binding Path="!HasSelected" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <ScrollViewer IsVisible="{Binding ShowReadOnly}" AutomationProperties.AutomationId="repo.detail">
                    <StackPanel Spacing="16">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Configuration" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TitleBrush}" />
                                <TextBlock Text="{Binding SelectedConfig.Name}" Foreground="{StaticResource AccentBrush}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                                <DropDownButton Content="Open in…" IsVisible="{Binding HasSelected}">
                                    <DropDownButton.Flyout>
                                        <MenuFlyout>
                                            <MenuItem Header="Explorer" Command="{Binding OpenInExplorerCommand}" />
                                            <MenuItem Header="VS Code" Command="{Binding OpenInVsCodeCommand}" />
                                            <MenuItem Header="Terminal" Command="{Binding OpenInTerminalCommand}" />
                                        </MenuFlyout>
                                    </DropDownButton.Flyout>
                                </DropDownButton>
                                <Button Content="Edit" Command="{Binding BeginEditCommand}"
                                        IsVisible="{Binding CanEdit}" />
                                <Button Content="Unregister" Command="{Binding RemoveCommand}"
                                        Foreground="{StaticResource DangerBrush}" IsVisible="{Binding HasSelected}"
                                        ToolTip.Tip="Remove this repo from sprig's registry. The .sprig.json on disk is left untouched." />
                                <Button Content="Delete config" Command="{Binding DeleteCommand}"
                                        Foreground="{StaticResource DangerBrush}" IsVisible="{Binding HasSelected}"
                                        ToolTip.Tip="Delete the .sprig.json from the repo and unregister it — a full reset." />
                            </StackPanel>
                        </Grid>

                        <!-- delete-config confirm bar: destructive, so it removes the file on disk -->
                        <Border IsVisible="{Binding ConfirmingDelete}" Background="{StaticResource PanelBgBrush}"
                                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Foreground="{StaticResource FgBrush}" TextWrapping="Wrap"
                                           Text="Delete this repo's .sprig.json from disk and unregister it? This resets the repo's sprig state — re-add it later to scaffold a fresh config. Existing workspaces are unaffected." />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Delete .sprig.json" Command="{Binding ConfirmDeleteCommand}"
                                            Foreground="{StaticResource DangerBrush}" />
                                    <Button Content="Cancel" Command="{Binding CancelDeleteCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- error -->
                        <TextBlock IsVisible="{Binding !SelectedConfig.Ok}" Foreground="{StaticResource DangerBrush}"
                                   TextWrapping="Wrap" Text="{Binding SelectedConfig.Error}" />

                        <!-- Fast path: a zero-input repo can stand up on its own, no stack needed. -->
                        <Border IsVisible="{Binding CanIsolate}" Background="{StaticResource PanelBgBrush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10"
                                Padding="14,12">
                            <StackPanel Spacing="10">
                                <StackPanel Spacing="2" IsVisible="{Binding !IsIsolating}">
                                    <TextBlock Text="This repo needs no inputs" FontWeight="SemiBold"
                                               Foreground="{StaticResource TitleBrush}" />
                                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                                               Text="Spin up an isolated workspace straight from it — no stack required." />
                                </StackPanel>
                                <Button Content="Isolate this repo  →" Command="{Binding BeginIsolateCommand}"
                                        IsVisible="{Binding !IsIsolating}" HorizontalAlignment="Left"
                                        Background="{StaticResource AccentBrush}" Foreground="#0B1220" />

                                <!-- inline workspace-name prompt -->
                                <StackPanel Spacing="8" IsVisible="{Binding IsIsolating}">
                                    <TextBlock Text="Workspace name" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                    <TextBox Text="{Binding IsolateName}" PlaceholderText="feature-x" />
                                    <TextBlock IsVisible="{Binding IsolateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                                               Text="{Binding IsolateError}" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button Content="Create" Command="{Binding ConfirmIsolateCommand}"
                                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                                        <Button Content="Cancel" Command="{Binding CancelIsolateCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- inputs -->
                        <StackPanel Spacing="6" IsVisible="{Binding SelectedConfig.HasInputs}">
                            <TextBlock Text="INPUTS (supplied by the stack)" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" />
                            <ItemsControl ItemsSource="{Binding SelectedConfig.Inputs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:InputRow">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1">
                                            <TextBlock Text="{Binding Name}" FontFamily="Consolas,monospace"
                                                       Foreground="{StaticResource FgBrush}" MinWidth="90" />
                                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center">
                                                <Run Text="e.g. " /><Run Text="{Binding Example}" />
                                            </TextBlock>
                                            <TextBlock FontSize="11" VerticalAlignment="Center" FontFamily="Consolas,monospace"
                                                       Foreground="{StaticResource AccentBrush}"
                                                       IsVisible="{Binding AllowedPorts, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <Run Text="ports " /><Run Text="{Binding AllowedPorts}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- modules -->
                        <StackPanel Spacing="12" IsVisible="{Binding SelectedConfig.HasModules}">
                            <TextBlock Text="MODULES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />

                            <!-- tab strip: one tab per module -->
                            <ListBox ItemsSource="{Binding SelectedConfig.Modules}"
                                     SelectedItem="{Binding SelectedConfig.SelectedModule, Mode=TwoWay}"
                                     Background="Transparent" Padding="0" BorderThickness="0">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="18,9" />
                                        <Setter Property="CornerRadius" Value="7" />
                                        <Setter Property="Background" Value="{StaticResource FormBgBrush}" />
                                    </Style>
                                    <Style Selector="ListBoxItem /template/ ContentPresenter">
                                        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="CornerRadius" Value="7" />
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="#2660A5FA" />
                                        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModuleTabView">
                                        <TextBlock Text="{Binding Name}" FontFamily="Consolas,monospace" FontSize="14"
                                                   FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- selected module detail -->
                            <StackPanel Spacing="14">
                                <TextBlock FontSize="11" FontFamily="Consolas,monospace" Foreground="{StaticResource MutedBrush}"
                                           IsVisible="{Binding SelectedConfig.SelectedModule.HasPath}">
                                    <Run Text="path: " /><Run Text="{Binding SelectedConfig.SelectedModule.Path}"
                                                                Foreground="{StaticResource AccentBrush}" />
                                </TextBlock>

                                <TextBlock Text="This module declares no env, compose or setup yet."
                                           FontSize="12" Foreground="{StaticResource MutedBrush}"
                                           IsVisible="{Binding SelectedConfig.SelectedModule.IsEmpty}" />

                                <!-- env -->
                                <StackPanel Spacing="6" IsVisible="{Binding SelectedConfig.SelectedModule.HasEnv}">
                                    <TextBlock Text="ENV OVERRIDES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding SelectedConfig.SelectedModule.Env}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:EnvGroup">
                                                <StackPanel Spacing="2" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding File}" FontStyle="Italic" Foreground="{StaticResource FgBrush}" />
                                                    <TextBlock FontSize="11" Margin="12,0,0,0" Foreground="{StaticResource MutedBrush}"
                                                               TextWrapping="Wrap" IsVisible="{Binding HasTemplates}">
                                                        <Run Text="seeded from: " /><Run Text="{Binding TemplatesSummary}" />
                                                    </TextBlock>
                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:KvRow">
                                                                <TextBlock FontFamily="Consolas,monospace" FontSize="12" Margin="12,0,0,0"
                                                                           Foreground="{StaticResource FgBrush}" TextWrapping="Wrap">
                                                                    <Run Text="{Binding Key}" /><Run Text=" = " /><Run Text="{Binding Value}" Foreground="{StaticResource AccentBrush}" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- compose -->
                                <StackPanel Spacing="6" IsVisible="{Binding SelectedConfig.SelectedModule.HasCompose}">
                                    <TextBlock Text="COMPOSE OVERRIDES" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding SelectedConfig.SelectedModule.Compose}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ComposeInfo">
                                                <StackPanel Spacing="2" Margin="0,0,0,6">
                                                    <TextBlock Text="{Binding File}" FontStyle="Italic" Foreground="{StaticResource FgBrush}" />
                                                    <ItemsControl ItemsSource="{Binding Overrides}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:KvRow">
                                                                <TextBlock FontFamily="Consolas,monospace" FontSize="12" Margin="12,0,0,0"
                                                                           Foreground="{StaticResource FgBrush}" TextWrapping="Wrap">
                                                                    <Run Text="{Binding Key}" /><Run Text=" → " /><Run Text="{Binding Value}" Foreground="{StaticResource AccentBrush}" />
                                                                </TextBlock>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- setup -->
                                <StackPanel Spacing="6" IsVisible="{Binding SelectedConfig.SelectedModule.HasSetup}">
                                    <TextBlock Text="SETUP (run in the module's directory after create)" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" />
                                    <ItemsControl ItemsSource="{Binding SelectedConfig.SelectedModule.Setup}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock FontFamily="Consolas,monospace" FontSize="12" Margin="12,0,0,0"
                                                           Foreground="{StaticResource FgBrush}" TextWrapping="Wrap">
                                                    <Run Text="$ " Foreground="{StaticResource MutedBrush}" /><Run Text="{Binding}" />
                                                </TextBlock>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="No modules declared — open Edit to add one." FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   IsVisible="{Binding !SelectedConfig.HasModules}" />

                    </StackPanel>
                </ScrollViewer>

            </Panel>
        </Border>

        <!-- Edit configuration (full-window modal) -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsEditing}" Background="#B0000000"
                Margin="-28,-20,-24,-16">
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Margin="28,20"
                    DataContext="{Binding Editor}" x:CompileBindings="True" x:DataType="vm:RepoEditViewModel">
                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,22,28,14">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}">
                                <Run Text="Edit " /><Run Text="{Binding Name}" Foreground="{StaticResource AccentBrush}" />
                            </TextBlock>
                            <TextBlock Text="Change the values this repo declares. Nothing is written until you save."
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        </StackPanel>
                        <DropDownButton Grid.Column="1" Content="Open in…" VerticalAlignment="Top">
                            <DropDownButton.Flyout>
                                <MenuFlyout>
                                    <MenuItem Header="Explorer"
                                              Command="{Binding $parent[UserControl].((vm:ReposViewModel)DataContext).OpenInExplorerCommand}" />
                                    <MenuItem Header="VS Code"
                                              Command="{Binding $parent[UserControl].((vm:ReposViewModel)DataContext).OpenInVsCodeCommand}" />
                                    <MenuItem Header="Terminal"
                                              Command="{Binding $parent[UserControl].((vm:ReposViewModel)DataContext).OpenInTerminalCommand}" />
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>

                    <!-- scrollable body. MaxWidth is pinned to the viewport so nested ItemsControls
                         can't measure themselves wider than the window (Avalonia lets a nested list
                         request infinite width otherwise, pushing the remove buttons off-screen). -->
                    <ScrollViewer Name="EditBody" Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
                        <Border Padding="28,0,36,0" MaxWidth="{Binding #EditBody.Bounds.Width}">
                            <StackPanel Spacing="20">

                            <!-- What sprig detected when it scaffolded this config. Only after an add that
                                 ran init; answers "where did all of this come from?" before the fields do. -->
                            <Border Background="#14346DF0" BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="16,14"
                                    IsVisible="{Binding $parent[UserControl].((vm:ReposViewModel)DataContext).HasScaffoldNotes}">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0" Text="SPRIG FILLED THIS IN FOR YOU" FontSize="10"
                                                   FontWeight="SemiBold" LetterSpacing="1.4"
                                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="Dismiss" FontSize="11" Padding="8,3"
                                                Background="Transparent" Foreground="{StaticResource MutedBrush}"
                                                Command="{Binding $parent[UserControl].((vm:ReposViewModel)DataContext).DismissScaffoldNotesCommand}" />
                                    </Grid>
                                    <TextBlock Text="It read this repo's env files and compose file and turned the port-shaped values it found into declared inputs. Review them below — nothing is written until you save."
                                               FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource FgBrush}" />
                                    <ItemsControl ItemsSource="{Binding $parent[UserControl].((vm:ReposViewModel)DataContext).ScaffoldNotes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="sys:String">
                                                <TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"
                                                           Margin="0,2" Foreground="{StaticResource MutedBrush}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- inputs card (shared across every module) -->
                            <Border Background="{StaticResource FormBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="18,16">
                            <StackPanel Spacing="8" AutomationProperties.AutomationId="repo.inputs">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="INPUTS (supplied by the stack)" FontSize="11"
                                               FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"
                                               VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add input" Command="{Binding AddInputCommand}"
                                            FontSize="11" Padding="8,3" />
                                </Grid>
                                <!-- column header: labels the row fields so the rows can stay compact -->
                                <Grid ColumnDefinitions="1.2*,0.9*,1.7*,1.1*,32" ColumnSpacing="8" Margin="2,0,0,0"
                                      IsVisible="{Binding HasInputs}">
                                    <TextBlock Grid.Column="0" Text="Name" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    <!-- "Example" alone read as a default, or as a value that gets used. It is
                                         neither: it documents the shape for whoever wires the stack. -->
                                    <TextBlock Grid.Column="1" Text="Example shape" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               ToolTip.Tip="Documentation only — never used as a value. Shows whoever wires the stack what to supply, e.g. 5000 or http://localhost:5000" />
                                    <TextBlock Grid.Column="2" Text="Description" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Grid.Column="3" Text="Allowed ports" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                               ToolTip.Tip="Optional. Restrict this input's port to a fixed set — e.g. pre-registered Auth0 callback ports. Ranges and lists: 8100-8103, 8100,8200" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Inputs}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:InputEditRow">
                                            <Grid ColumnDefinitions="1.2*,0.9*,1.7*,1.1*,32" ColumnSpacing="8" Margin="2,0,0,6">
                                                <TextBox Grid.Column="0" Text="{Binding Name, Mode=TwoWay}" MinWidth="0"
                                                         PlaceholderText="name" FontFamily="Consolas,monospace" />
                                                <TextBox Grid.Column="1" Text="{Binding Example, Mode=TwoWay}" MinWidth="0"
                                                         PlaceholderText="5000" />
                                                <TextBox Grid.Column="2" Text="{Binding Description, Mode=TwoWay}" MinWidth="0"
                                                         PlaceholderText="optional" />
                                                <!-- Advanced and almost always blank, so it hides behind a link
                                                     until wanted (and shows itself whenever a value exists). -->
                                                <Button Grid.Column="3" Content="restrict…" Command="{Binding RestrictCommand}"
                                                        IsVisible="{Binding ShowRestrictLink}" FontSize="11" Padding="0"
                                                        Background="Transparent" Foreground="{StaticResource MutedBrush}"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        ToolTip.Tip="Optional. Restrict this input's port to a fixed set — e.g. pre-registered Auth0 callback ports." />
                                                <TextBox Grid.Column="3" Text="{Binding AllowedPorts, Mode=TwoWay}" MinWidth="0"
                                                         IsVisible="{Binding ShowRestrictBox}"
                                                         PlaceholderText="8100-8103" FontFamily="Consolas,monospace"
                                                         ToolTip.Tip="Optional. Restrict this input's port to a fixed set — e.g. pre-registered Auth0 callback ports. Ranges and lists: 8100-8103, 8100,8200" />
                                                <Button Grid.Column="4" Content="✕" Command="{Binding RemoveCommand}"
                                                        Foreground="{StaticResource DangerBrush}" Padding="0" Width="32"
                                                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- quick add: inputs referenced by an override but not declared yet. Save stays
                                     blocked until these are gone (the validator flags each), but you can declare
                                     them as you go by clicking a chip. -->
                                <Border IsVisible="{Binding HasMissingInputRefs}" Margin="2,2,0,0"
                                        Background="{StaticResource FormBgBrush}" BorderBrush="{StaticResource WarnBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,8">
                                    <StackPanel Spacing="6">
                                        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource WarnBrush}"
                                                   Text="Referenced by an override but not declared yet — click to add (must be resolved before saving):" />
                                        <ItemsControl ItemsSource="{Binding MissingInputRefs}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="sys:String">
                                                    <Button Content="{Binding StringFormat='+ {0}'}" FontFamily="Consolas,monospace"
                                                            FontSize="11" Padding="8,3" Margin="0,0,6,6"
                                                            Command="{Binding $parent[ItemsControl].((vm:RepoEditViewModel)DataContext).QuickAddInputCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            </Border>

                            <!-- modules card: one tab per module (its own env/compose/setup); inputs above are shared -->
                            <Border Background="{StaticResource FormBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Padding="18,16">
                            <StackPanel Spacing="12" AutomationProperties.AutomationId="repo.modules">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="MODULES" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add module" Command="{Binding AddModuleCommand}"
                                            AutomationProperties.AutomationId="repo.addModule"
                                            FontSize="11" Padding="8,3" />
                                </Grid>

                                <!-- tab strip -->
                                <ListBox ItemsSource="{Binding Modules}" SelectedItem="{Binding SelectedModule, Mode=TwoWay}"
                                         Background="Transparent" Padding="0" BorderThickness="0"
                                         IsVisible="{Binding HasModules}">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="18,9" />
                                            <Setter Property="CornerRadius" Value="7" />
                                            <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
                                        </Style>
                                        <Style Selector="ListBoxItem /template/ ContentPresenter">
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="CornerRadius" Value="7" />
                                        </Style>
                                        <!-- selected tab: accent-tinted fill + accent border so it clearly reads as active -->
                                        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                            <Setter Property="Background" Value="#2660A5FA" />
                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ModuleEditTab">
                                            <TextBlock Text="{Binding Name}" FontFamily="Consolas,monospace" FontSize="14"
                                                       FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- empty state -->
                                <Border IsVisible="{Binding !HasModules}" Background="{StaticResource FormBgBrush}"
                                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="18">
                                    <StackPanel Spacing="10" HorizontalAlignment="Center">
                                        <TextBlock Text="No modules yet. A module is a slice of the repo — its own .env files, compose files and setup commands."
                                                   FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                                   TextAlignment="Center" MaxWidth="440" />
                                        <Button Content="+ Add module" Command="{Binding AddModuleCommand}" HorizontalAlignment="Center" />
                                    </StackPanel>
                                </Border>

                                <!-- selected module detail -->
                                <ContentControl Content="{Binding SelectedModule}">
                                    <ContentControl.ContentTemplate>
                                        <DataTemplate x:DataType="vm:ModuleEditTab">
                                            <StackPanel Spacing="16">

                                            <!-- module header: name, path, delete -->
                                            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="12">
                                                <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                                                    <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Top">
                                                        <TextBlock Text="Module name" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                                        <TextBox Text="{Binding Name, Mode=TwoWay}" MinWidth="0"
                                                                 Loaded="ModuleNameBoxLoaded"
                                                                 PlaceholderText="web" FontFamily="Consolas,monospace" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Top">
                                                        <TextBlock Text="Path (subdirectory, optional)" FontSize="11"
                                                                   Foreground="{StaticResource MutedBrush}"
                                                                   ToolTip.Tip="The module's directory (e.g. apps/web). Its .env/compose paths resolve under it, and setup runs there. Leave blank for the repo root." />
                                                        <AutoCompleteBox Text="{Binding Path, Mode=TwoWay}" MinWidth="0"
                                                                         FilterMode="None" MinimumPrefixLength="0" IsTextCompletionEnabled="False"
                                                                         Loaded="RepoPathBoxLoaded"
                                                                         PlaceholderText="apps/web (blank = repo root)" FontFamily="Consolas,monospace" />
                                                        <TextBlock IsVisible="{Binding ShowPathFound}" FontSize="11"
                                                                   Foreground="{StaticResource OkBrush}" Text="✓ Directory exists in the repo." />
                                                        <TextBlock IsVisible="{Binding ShowPathMissing}" FontSize="11" TextWrapping="Wrap"
                                                                   Foreground="{StaticResource WarnBrush}"
                                                                   Text="⚠ No such directory in the repo — check the path (setup would run somewhere that doesn't exist)." />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Delete module" Command="{Binding RemoveCommand}"
                                                            VerticalAlignment="Top" Margin="0,18,0,0" Padding="10,5"
                                                            Background="Transparent" Foreground="{StaticResource DangerBrush}"
                                                            BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" />
                                                </Grid>
                                            </Border>

                            <!-- env -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="ENV OVERRIDES" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add file" Command="{Binding AddEnvFileCommand}"
                                            FontSize="11" Padding="8,3" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Env}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:EnvFileEditRow">
                                            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <AutoCompleteBox Grid.Column="0" MinWidth="0"
                                                                         Text="{Binding File, Mode=TwoWay}"
                                                                         FilterMode="None" MinimumPrefixLength="0"
                                                                         IsTextCompletionEnabled="False"
                                                                         Loaded="RepoPathBoxLoaded"
                                                                         PlaceholderText=".env file (e.g. .env.local)" />
                                                        <Button Grid.Column="1" Content="✕" Command="{Binding RemoveCommand}"
                                                                Foreground="{StaticResource DangerBrush}" Padding="10,2" />
                                                    </Grid>
                                                    <!-- git-safety subtext: only gitignored files are truly safe to clobber -->
                                                    <TextBlock IsVisible="{Binding ShowTrackedWarning}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{StaticResource DangerBrush}"
                                                               Text="⚠ Tracked by git — can't override. Sprig only overrides gitignored files." />
                                                    <TextBlock IsVisible="{Binding ShowIgnoredOk}" FontSize="11"
                                                               Foreground="{StaticResource OkBrush}"
                                                               Text="✓ Gitignored — safe to override." />
                                                    <TextBlock IsVisible="{Binding ShowNotIgnoredWarning}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{StaticResource WarnBrush}"
                                                               Text="{Binding NotIgnoredMessage}" />

                                                    <!-- seed templates: an inset panel so it reads as its own thing, not part of the keys -->
                                                    <Border Background="{StaticResource FormBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                            BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,4,0,0">
                                                        <StackPanel Spacing="4">
                                                            <Grid ColumnDefinitions="*,Auto">
                                                                <TextBlock Grid.Column="0" Text="Seed from templates (optional)" FontSize="11"
                                                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                                                                           ToolTip.Tip="The worktree's copy of this file is seeded from these before sprig's override block is injected — point at committed templates like .env.template. Leave empty to seed from the target file itself." />
                                                                <Button Grid.Column="1" Content="+ Add template" Command="{Binding AddTemplateCommand}"
                                                                        FontSize="11" Padding="8,3" />
                                                            </Grid>
                                                            <ItemsControl ItemsSource="{Binding Templates}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate x:DataType="vm:TemplateFileRow">
                                                                        <StackPanel Spacing="2" Margin="0,2,0,0">
                                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                                <AutoCompleteBox Grid.Column="0" MinWidth="0" Text="{Binding Path, Mode=TwoWay}"
                                                                                         FilterMode="None" MinimumPrefixLength="0" IsTextCompletionEnabled="False"
                                                                                         Loaded="RepoPathBoxLoaded"
                                                                                         PlaceholderText=".env.template" FontFamily="Consolas,monospace" />
                                                                                <Button Grid.Column="1" Content="✕" Command="{Binding RemoveCommand}"
                                                                                        Foreground="{StaticResource DangerBrush}" Padding="10,2" />
                                                                            </Grid>
                                                                            <TextBlock IsVisible="{Binding ShowFound}" FontSize="11"
                                                                                       Foreground="{StaticResource OkBrush}" Text="✓ Found in the repo." />
                                                                            <TextBlock IsVisible="{Binding ShowMissing}" FontSize="11" TextWrapping="Wrap"
                                                                                       Foreground="{StaticResource WarnBrush}"
                                                                                       Text="⚠ No such file in the repo — it'll be skipped when seeding." />
                                                                        </StackPanel>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- override keys: a merged view of the file + its templates, each value clickable
                                                         to override (like the compose overlay). Wrapper keeps IsVisible bound to the
                                                         row; the control's own DataContext is the overlay. -->
                                                    <StackPanel IsVisible="{Binding HasOverlay}" Margin="0,4,0,0">
                                                        <controls:EnvOverlay DataContext="{Binding Overlay}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- compose: one card per overridden compose file, add/remove like env -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="DOCKER COMPOSE OVERRIDES" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add compose file" Command="{Binding AddComposeFileCommand}"
                                            FontSize="11" Padding="8,3" />
                                </Grid>
                                <ItemsControl ItemsSource="{Binding Compose}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ComposeFileEditRow">
                                            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
                                                <StackPanel Spacing="6">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                        <AutoCompleteBox Grid.Column="0" MinWidth="0" Text="{Binding File, Mode=TwoWay}"
                                                                         FilterMode="None" MinimumPrefixLength="0" IsTextCompletionEnabled="False"
                                                                         Loaded="RepoPathBoxLoaded"
                                                                         PlaceholderText="compose file (e.g. docker-compose.yml)" />
                                                        <Button Grid.Column="1" Content="✕" Command="{Binding RemoveCommand}"
                                                                Foreground="{StaticResource DangerBrush}" Padding="10,2" />
                                                    </Grid>
                                                    <!-- the override target must exist in the repo -->
                                                    <TextBlock IsVisible="{Binding ShowFound}" FontSize="11"
                                                               Foreground="{StaticResource OkBrush}" Text="✓ Found in the repo." />
                                                    <TextBlock IsVisible="{Binding ShowMissing}" FontSize="11" TextWrapping="Wrap"
                                                               Foreground="{StaticResource DangerBrush}"
                                                               Text="⚠ No such file in the repo — the override target must exist before you can save." />
                                                    <!-- wrapper keeps IsVisible bound to the row; the control's own DataContext is the overlay -->
                                                    <StackPanel IsVisible="{Binding HasOverlay}">
                                                        <controls:ComposeOverlay DataContext="{Binding Overlay}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- setup: free-form commands run at the worktree root after create -->
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="SETUP COMMANDS" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Add command" Command="{Binding AddSetupCommandCommand}"
                                            FontSize="11" Padding="8,3" />
                                </Grid>
                                <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                           Text="Run in order in the module's directory after the worktree is created (e.g. npm ci, dotnet restore). Each runs via your shell; a failure warns but won't undo the workspace." />
                                <ItemsControl ItemsSource="{Binding Setup}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SetupCommandRow">
                                            <Grid ColumnDefinitions="*,32" ColumnSpacing="8" Margin="2,0,0,6">
                                                <TextBox Grid.Column="0" Text="{Binding Command, Mode=TwoWay}" MinWidth="0"
                                                         PlaceholderText="npm ci" FontFamily="Consolas,monospace" />
                                                <Button Grid.Column="1" Content="✕" Command="{Binding RemoveCommand}"
                                                        Foreground="{StaticResource DangerBrush}" Padding="0" Width="32"
                                                        VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                                            </StackPanel>
                                        </DataTemplate>
                                    </ContentControl.ContentTemplate>
                                </ContentControl>
                            </StackPanel>
                            </Border>

                            </StackPanel>
                        </Border>
                    </ScrollViewer>

                    <!-- footer: the transaction boundary -->
                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
                            Padding="28,14">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                       Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding Error}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button Content="Save changes"
                                        Command="{Binding $parent[UserControl].((vm:ReposViewModel)DataContext).SaveEditCommand}"
                                        Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                                <Button Content="Cancel"
                                        Command="{Binding $parent[UserControl].((vm:ReposViewModel)DataContext).CancelEditCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                </Grid>
            </Border>
        </Border>

        <!-- Add-repo modal -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsAdding}" Background="#B0000000"
                Margin="-28,-20,-24,-16">
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="22" Width="460"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="Add a repo" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}" />
                    <TextBlock Text="Point sprig at a git repo to make it available to stacks."
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Repo folder" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <AutoCompleteBox x:Name="RepoPathBox" Grid.Column="0" MinWidth="0"
                                             Text="{Binding NewPath, Mode=TwoWay}"
                                             FilterMode="None" MinimumPrefixLength="0" IsTextCompletionEnabled="False"
                                             PlaceholderText="C:\path\to\repo" />
                            <Button Grid.Column="1" Content="Browse…" Click="BrowseRepoFolder" />
                        </Grid>
                    </StackPanel>

                    <!-- git-repo highlight: sprig can't create worktrees without one -->
                    <Border IsVisible="{Binding GitMissing}" CornerRadius="6" Padding="10,8"
                            Background="#3A1D1D" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1">
                        <TextBlock Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"
                                   Text="⚠ No git repository found here. Sprig creates isolated worktrees, so the folder must be a git repo — pick the repo's root." />
                    </Border>
                    <TextBlock IsVisible="{Binding GitOk}" Foreground="{StaticResource OkBrush}" FontSize="12"
                               Text="✓ Git repository detected." />

                    <TextBlock IsVisible="{Binding DetectHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" TextWrapping="Wrap"
                               Text="{Binding DetectHint}" />

                    <!-- module-structure choice: only for a new git repo with no .sprig.json yet -->
                    <StackPanel Spacing="10" IsVisible="{Binding NeedsModuleChoice}">
                        <TextBlock Text="How is this repo structured?" FontSize="12"
                                   Foreground="{StaticResource MutedBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="moduleStructure" Content="Single module"
                                         IsChecked="{Binding !MultiModule}" />
                            <RadioButton GroupName="moduleStructure" Content="Multiple modules"
                                         IsChecked="{Binding MultiModule, Mode=TwoWay}" />
                        </StackPanel>

                        <!-- single: scan the whole repo into one root module -->
                        <TextBlock IsVisible="{Binding !MultiModule}" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Sprig scans the whole repo and sets up one module at the root." />

                        <!-- multiple: define each module's name + path; each path is scanned in turn -->
                        <StackPanel Spacing="8" IsVisible="{Binding MultiModule}">
                            <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                       Text="Name each module and point it at a subdirectory. Sprig scans each path and scaffolds its env / compose. Inputs are shared across them." />
                            <Grid ColumnDefinitions="1.6*,1.1*,Auto" ColumnSpacing="8" Margin="0,0,0,-2">
                                <TextBlock Grid.Column="0" Text="Path (subdirectory)" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Grid.Column="1" Text="Name" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding ModuleSpecs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ModuleSpecRow">
                                        <StackPanel Spacing="2" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="1.6*,1.1*,Auto" ColumnSpacing="8">
                                                <AutoCompleteBox Grid.Column="0" MinWidth="0" Text="{Binding Path, Mode=TwoWay}"
                                                                 FilterMode="None" MinimumPrefixLength="0" IsTextCompletionEnabled="False"
                                                                 Loaded="ModuleSpecPathBoxLoaded" GotFocus="ModuleSpecPathBoxGotFocus"
                                                                 PlaceholderText="apps/web" FontFamily="Consolas,monospace" />
                                                <TextBox Grid.Column="1" Text="{Binding Name, Mode=TwoWay}" MinWidth="0"
                                                         PlaceholderText="web" FontFamily="Consolas,monospace" />
                                                <Button Grid.Column="2" Content="✕" Command="{Binding RemoveCommand}"
                                                        Foreground="{StaticResource DangerBrush}" Padding="10,2" />
                                            </Grid>
                                            <TextBlock IsVisible="{Binding ShowPathFound}" FontSize="11"
                                                       Foreground="{StaticResource OkBrush}" Text="✓ Directory exists in the repo." />
                                            <TextBlock IsVisible="{Binding ShowPathMissing}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource WarnBrush}"
                                                       Text="⚠ No such directory in the repo yet — the module is still created (empty) for you to fill in." />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ Add module" Command="{Binding AddModuleSpecRowCommand}"
                                    FontSize="11" Padding="8,3" HorizontalAlignment="Left" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding Error}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="{Binding AddButtonLabel}" Command="{Binding ConfirmAddCommand}"
                                IsEnabled="{Binding NewPath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                        <Button Content="Cancel" Command="{Binding CancelAddCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
