<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sprig.App.ViewModels"
             xmlns:logs="clr-namespace:Sprig.App.Logs"
             xmlns:controls="clr-namespace:Sprig.App.Controls"
             xmlns:planning="clr-namespace:Sprig.Engine.Planning;assembly=Sprig.Engine"
             x:Class="Sprig.App.Views.SproutsView"
             x:DataType="vm:SproutsViewModel">

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style Selector="TextBlock.phead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="SelectableTextBlock.cell">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector=":is(TextBlock).mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
        </Style>
        <Style Selector=":is(TextBlock).via">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <!-- Colours that change with state live in styles: a local Foreground would beat them. -->
        <Style Selector="TextBlock.state">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.msg">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="TextBlock.up">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="TextBlock.bad">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.busy">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Ellipse.dot">
            <Setter Property="Fill" Value="#6E6E82" />
        </Style>
        <Style Selector="Ellipse.dot.up">
            <Setter Property="Fill" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.busy">
            <Setter Property="Fill" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.warn">
            <Setter Property="Fill" Value="{StaticResource WarnBrush}" />
        </Style>
        <Style Selector="Ellipse.dot.bad">
            <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
        </Style>
        <!-- A job that finished went fine and needs nothing: still green, but faded so the eye passes over it. -->
        <Style Selector="Ellipse.dot.done">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.state.done">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <!-- Chromeless buttons for list rows and tabs: the Border inside carries hover and selection. -->
        <Style Selector="Button.flat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.flat /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.approw">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="2,0,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Border.approw:pointerover">
            <Setter Property="Background" Value="#262633" />
        </Style>
        <Style Selector="Border.approw.selected">
            <Setter Property="Background" Value="#262633" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Border.approw.selected TextBlock.appname">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- Always there so the menu can be found, but faint until the row is pointed at. -->
        <Style Selector="Button.more">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.approw:pointerover Button.more">
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <!-- A sprout in the overview opens on a double-click anywhere on its row; Open says so, and lights with the row. -->
        <Style Selector="Button.open TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Border.approw:pointerover Button.open TextBlock">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.more:pointerover">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
        </Style>
        <Style Selector="Button.more:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#33333F" />
        </Style>
        <!-- Opened by the view: a click in the browser, a middle-click in a new window; right-click to copy. Tag holds the url. -->
        <Style Selector="TextBlock.link">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.link:pointerover">
            <Setter Property="TextDecorations" Value="Underline" />
        </Style>
        <Style Selector="Button.chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        </Style>
        <Style Selector="Button.chip.on">
            <Setter Property="Background" Value="#262633" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.toggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
        </Style>
        <Style Selector="Button.toggle.on">
            <Setter Property="Background" Value="#262633" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Button.toggle.warnon">
            <Setter Property="Background" Value="#3A2F12" />
            <Setter Property="BorderBrush" Value="{StaticResource WarnBrush}" />
        </Style>
        <Style Selector="Border.rail">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
        </Style>
        <Style Selector="Button.flat:pointerover Border.rail">
            <Setter Property="Background" Value="#262633" />
        </Style>
        <Style Selector="Border.tab">
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0,6,0,8" />
        </Style>
        <Style Selector="Border.tab TextBlock.tablabel">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="Border.tab.on">
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="Border.tab.on TextBlock.tablabel">
            <Setter Property="Foreground" Value="{StaticResource TitleBrush}" />
        </Style>
        <Style Selector="ListBox.log">
            <Setter Property="Background" Value="#14141B" />
            <Setter Property="Padding" Value="0,6" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="ListBox.log.nowrap">
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="ListBox.log ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="ListBox.log ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2B3654" />
        </Style>
        <Style Selector="Border.logrow.error">
            <Setter Property="Background" Value="#1FF87171" />
        </Style>
        <Style Selector="TextBlock.logline">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MinHeight" Value="17" />
        </Style>
        <Style Selector="TextBlock.logline.error">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style Selector="TextBlock.logline.warn">
            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
        </Style>
        <Style Selector="ListBox.nowrap TextBlock.logline">
            <Setter Property="TextWrapping" Value="NoWrap" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,6" />
        </Style>
        <Style Selector="TextBox">
            <Setter Property="FontSize" Value="13" />
        </Style>
        <!-- Too narrow for the log and the details side by side: the details sit over the log's right edge instead. -->
        <Style Selector="Grid.narrow > Border#DetailsPanel">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="ZIndex" Value="10" />
            <Setter Property="BoxShadow" Value="-8 0 24 0 #80000000" />
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <!-- Shown in the new-sprout modal while it's open, and under the sprout's header otherwise. -->
        <DataTemplate x:Key="TrustPanel" x:DataType="vm:SproutsViewModel">
            <Border Classes="panel" BorderBrush="{StaticResource WarnBrush}" Padding="14,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Review the code" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding Review.Summary, StringFormat='{}{0}. What you started carries on once the code is approved.'}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{Binding Review.OpenLabel}" Command="{Binding Review.OpenCommand}" VerticalAlignment="Center"
                            Background="{StaticResource WarnBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="12,6" />
                </Grid>
            </Border>
        </DataTemplate>
        <StreamGeometry x:Key="PinIcon">M9 3h6l-1 6 4 4H6l4-4z M11.25 13h1.5v8h-1.5z</StreamGeometry>
    </UserControl.Resources>

    <Grid>
        <!-- Every sprout, for seeing them all at once and clearing out old ones -->
        <DockPanel IsVisible="{Binding !HasSelection}">
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,18,24,14">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="16">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock Text="Sprouts" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                        <TextBlock Text="{Binding OverviewSummary}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <ItemsControl Grid.Column="1" ItemsSource="{Binding OverviewChips}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OverviewChip">
                                <Button Classes="chip" Classes.on="{Binding IsOn}" Margin="0,0,6,0"
                                        Command="{Binding PickCommand}" CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Ellipse Classes="dot" Width="7" Height="7" VerticalAlignment="Center"
                                                 Classes.up="{Binding IsUpKind}" Classes.bad="{Binding IsFailedKind}" />
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Grid.Column="2" Content="+ New sprout" Command="{Binding OpenAddCommand}" IsEnabled="{Binding !IsWorking}"
                            Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="12,6"
                            VerticalAlignment="Center" />
                </Grid>
            </Border>

            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,9" MinHeight="44">
                <Grid ColumnDefinitions="280,*" ColumnSpacing="16">
                <TextBox x:Name="OverviewSearchBox" Text="{Binding OverviewSearch}" PlaceholderText="Search by sprout, trellis or branch"
                         FontSize="12.5" VerticalAlignment="Center" IsVisible="{Binding !IsEmpty}">
                    <TextBox.KeyBindings>
                        <KeyBinding Gesture="Escape" Command="{Binding ClearOverviewSearchCommand}" />
                    </TextBox.KeyBindings>
                </TextBox>
                <Panel Grid.Column="1">
                    <StackPanel Orientation="Horizontal" Spacing="12" IsVisible="{Binding NoneChecked}" VerticalAlignment="Center">
                        <TextBlock Text="Double-click a sprout to open it. Tick sprouts to bring up, take down or remove several at once." FontSize="12.5"
                                   Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        <Button Classes="flat" Command="{Binding SelectStaleCommand}" IsVisible="{Binding HasStale}" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StaleLabel}" FontSize="12.5" Foreground="{StaticResource AccentBrush}" />
                        </Button>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*" ColumnSpacing="8" IsVisible="{Binding HasChecked}">
                        <TextBlock Text="{Binding CheckedLabel}" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}"
                                   VerticalAlignment="Center" Margin="0,0,4,0" />
                        <Button Grid.Column="1" Classes="small" Content="Bring up" Command="{Binding BulkUpCommand}" IsEnabled="{Binding !IsWorking}" />
                        <Button Grid.Column="2" Classes="small" Content="Take down" Command="{Binding BulkDownCommand}" IsEnabled="{Binding !IsWorking}" />
                        <Button Grid.Column="3" Content="Remove…" Command="{Binding AskBulkRemoveCommand}" IsEnabled="{Binding !IsWorking}"
                                Background="Transparent" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}"
                                BorderThickness="1" Padding="10,3" FontSize="12" />
                        <Button Grid.Column="4" Classes="flat" Command="{Binding ClearCheckedCommand}" VerticalAlignment="Center">
                            <TextBlock Text="Clear" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                        </Button>
                        <TextBlock Grid.Column="5" Text="{Binding GuardNote}" FontSize="12" Foreground="{StaticResource WarnBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>
                </Panel>
                </Grid>
            </Border>

            <TextBlock DockPanel.Dock="Top" Margin="24,24" FontSize="13" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding IsEmpty}"
                       Text="No sprouts yet. + New sprout makes one of a trellis, or of a repo on its own." />
            <TextBlock DockPanel.Dock="Top" Margin="24,24" FontSize="13" Foreground="{StaticResource MutedBrush}" IsVisible="{Binding NoOverviewMatches}"
                       Text="No sprouts match. Clear the search or pick All to see them all." />

            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsEmpty}">
                <StackPanel MinWidth="1060">
                    <Grid ColumnDefinitions="40,190,120,140,150,140,*,130,70" ColumnSpacing="12" Margin="24,8,24,6">
                        <CheckBox IsChecked="{Binding AllChecked, Mode=OneWay}" Command="{Binding ToggleAllCheckedCommand}" ToolTip.Tip="Tick every one shown" />
                        <TextBlock Grid.Column="1" Classes="phead" Text="SPROUT" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="phead" Text="OF" VerticalAlignment="Center"
                                   ToolTip.Tip="The trellis it's a sprout of, or the repo it runs on its own" />
                        <TextBlock Grid.Column="3" Classes="phead" Text="STATE" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="4" Classes="phead" Text="APPS" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="5" Classes="phead" Text="PORTS" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="6" Classes="phead" Text="WORKTREES" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="7" Classes="phead" Text="LAST UP" VerticalAlignment="Center" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding OverviewRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:OverviewRow">
                                <Border Classes="approw" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush}" Padding="24,8"
                                        Cursor="Hand" ToolTip.Tip="Double-click to open" DoubleTapped="OnOverviewRowDoubleTapped"
                                        AutomationProperties.AutomationId="{Binding Key, StringFormat='overview:{0}'}">
                                    <Grid ColumnDefinitions="40,190,120,140,150,140,*,130,70" ColumnSpacing="12">
                                        <CheckBox IsChecked="{Binding IsChecked}" VerticalAlignment="Center" Cursor="Arrow" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TitleBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Branch}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Trellis}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                                            <Ellipse Classes="dot" Width="7" Height="7" VerticalAlignment="Center"
                                                     Classes.up="{Binding IsUp}" Classes.bad="{Binding IsFailed}" />
                                            <TextBlock Classes="state" Text="{Binding State}" FontSize="12.5"
                                                       Classes.up="{Binding IsUp}" Classes.bad="{Binding IsFailed}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="4" Classes="cell" Text="{Binding Apps}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Classes="cell mono" FontSize="12" Text="{Binding Ports}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Classes="cell state" Text="{Binding Worktrees}" VerticalAlignment="Center"
                                                   Classes.bad="{Binding WorktreesWarn}" />
                                        <TextBlock Grid.Column="7" Classes="cell via" Text="{Binding LastUp}" VerticalAlignment="Center" />
                                        <Button Grid.Column="8" Classes="flat open" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                CommandParameter="{Binding}" ToolTip.Tip="Open this sprout"
                                                Command="{Binding $parent[UserControl].((vm:SproutsViewModel)DataContext).OpenOverviewRowCommand}">
                                            <TextBlock Text="Open ›" FontSize="12.5" FontWeight="SemiBold" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- The sprout opened from the list. The page never scrolls: the list, the log and the details each scroll on their own. -->
        <DockPanel IsVisible="{Binding HasSelection}">
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,12,22,0">
                <StackPanel Spacing="10">
                    <Button Classes="flat" Command="{Binding BackToListCommand}" HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="sprout:back" ToolTip.Tip="Back to every sprout">
                        <TextBlock Text="← All sprouts" FontSize="12.5" Foreground="{StaticResource AccentBrush}" />
                    </Button>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Selected.Title}" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Classes="state" Text="{Binding Selected.State}" FontSize="12"
                                           Classes.up="{Binding Selected.IsUp}" Classes.bad="{Binding Selected.IsFailed}" />
                                <TextBlock Text="{Binding Selected.Branch}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock Text="{Binding Selected.Record.PortPolicy, StringFormat='{}{0} ports'}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button x:Name="LinksButton" Content="Links ▾" Padding="12,6" FontSize="12.5" IsVisible="{Binding HasSproutLinks}"
                                    ToolTip.Tip="The trellis's quick links, at this sprout's ports"
                                    Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}">
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedRight">
                                        <ItemsControl ItemsSource="{Binding SproutLinks}" MinWidth="220" Margin="4,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="planning:PlannedLink">
                                                    <StackPanel Margin="0,4" Spacing="1">
                                                        <TextBlock Classes="link" Text="{Binding Label, StringFormat='{}{0} ↗'}" Tag="{Binding Url}" FontSize="13" />
                                                        <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                                   FontFamily="Cascadia Mono,Consolas,monospace" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <Button Content="Start all" Command="{Binding StartAppsCommand}" Padding="12,6" FontSize="12.5"
                                    ToolTip.Tip="Every app, after what each depends on; a sprout that's down is brought up first"
                                    Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" />
                            <Button Content="Stop apps" Command="{Binding StopAppsCommand}" Padding="12,6" FontSize="12.5"
                                    Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" />
                            <Button Content="Take down" Command="{Binding DownCommand}" IsEnabled="{Binding !IsWorking}" Padding="12,6" FontSize="12.5"
                                    IsVisible="{Binding ShowTakeDown}" ToolTip.Tip="Stop its apps and infra. Its data, worktrees and ports are kept."
                                    Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" />
                            <Button Content="Bring up" Command="{Binding UpCommand}" IsEnabled="{Binding !IsWorking}" Padding="12,6" FontSize="12.5"
                                    IsVisible="{Binding ShowBringUp}" ToolTip.Tip="Its worktrees, env files and infra, without starting its apps."
                                    Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" />
                            <Button Content="⋯" Padding="10,6" FontSize="12.5" ToolTip.Tip="More"
                                    Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}">
                                <Button.Flyout>
                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                        <MenuItem Header="Bring up again" Command="{Binding UpCommand}" IsEnabled="{Binding !IsWorking}"
                                                  IsVisible="{Binding ShowTakeDown}" ToolTip.Tip="Write its env files and start its infra afresh" />
                                        <MenuItem Header="Remove…" Command="{Binding AskRemoveCommand}" IsEnabled="{Binding !IsWorking}" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- A failure can carry a service's log, so it scrolls in its own box rather than pushing the page down. -->
                    <Border IsVisible="{Binding Selected.IsFailed}" Background="#1AF87171" BorderBrush="#66F87171" BorderThickness="1"
                            CornerRadius="8" Padding="12,8">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <SelectableTextBlock Text="{Binding Selected.Record.Error}" FontSize="12" Foreground="{StaticResource DangerBrush}"
                                                 TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock Classes="msg" Text="{Binding FormMessage}" FontSize="12.5" TextWrapping="Wrap"
                               Classes.bad="{Binding FormFailed}" IsVisible="{Binding MessageOnPage}" />
                    <TextBlock Classes="msg" Text="{Binding AppsMessage}" FontSize="12.5" TextWrapping="Wrap"
                               Classes.bad="{Binding AppsMessageIsBad}" IsVisible="{Binding HasAppsMessage}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrustPanel}" IsVisible="{Binding TrustOnPage}" />

                    <StackPanel Orientation="Horizontal" Spacing="18">
                        <Button Classes="flat" Command="{Binding ShowAppsTabCommand}" HorizontalAlignment="Left">
                            <Border Classes="tab" Classes.on="{Binding OnAppsTab}">
                                <TextBlock Classes="tablabel" Text="Apps and logs" FontSize="13" FontWeight="SemiBold" />
                            </Border>
                        </Button>
                        <Button Classes="flat" Command="{Binding ShowInfraTabCommand}" HorizontalAlignment="Left">
                            <Border Classes="tab" Classes.on="{Binding OnInfraTab}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="tablabel" Text="Infra, worktrees and files" FontSize="13" FontWeight="SemiBold" />
                                    <Border Background="#3A2F12" CornerRadius="999" Padding="7,0" IsVisible="{Binding HasWarnings}">
                                        <TextBlock Text="{Binding WarningsBadge}" FontSize="11" Foreground="{StaticResource WarnBrush}" />
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The two tabs share the space under the header. In one panel, each fills it: as a DockPanel child that
                 isn't the last, the infra tab would be docked left at the width of whatever had loaded so far. -->
            <Panel>
            <!-- Infra, worktrees and files: the page's width up to 1200, centred -->
            <ScrollViewer IsVisible="{Binding OnInfraTab}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="22,18" Spacing="16" MaxWidth="1200" HorizontalAlignment="Stretch">
                    <Border Classes="panel" BorderBrush="#5C4A17" IsVisible="{Binding HasWarnings}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="phead" Text="WARNINGS" Foreground="{StaticResource WarnBrush}" />
                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProblemRow">
                                        <StackPanel Margin="0,3" Spacing="1">
                                            <TextBlock Classes="cell" Text="{Binding Message}" />
                                            <TextBlock Classes="cell via mono" Text="{Binding Where}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="phead" Text="INFRA (HOST PORT : CONTAINER PORT)" />
                            <ItemsControl ItemsSource="{Binding Infra}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SproutInfraRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="220,*">
                                                <TextBlock Classes="cell" Text="{Binding Name}" />
                                                <SelectableTextBlock Grid.Column="1" Classes="cell mono" Text="{Binding Ports}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel">
                        <StackPanel Spacing="6">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Classes="phead" Text="WORKTREES" />
                                <TextBlock Grid.Column="1" Classes="cell via" Text="asking git…" IsVisible="{Binding InfraLoading}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Worktrees}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WorktreeRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="160,*,220" ColumnSpacing="10">
                                                <TextBlock Classes="cell" Text="{Binding Repo}" />
                                                <SelectableTextBlock Grid.Column="1" Classes="cell via mono" Text="{Binding Folder}" />
                                                <TextBlock Grid.Column="2" Classes="cell up" Classes.bad="{Binding IsWarn}" Text="{Binding Status}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="phead" Text="FILES SPRIG WROTE" />
                            <ItemsControl ItemsSource="{Binding WrittenFiles}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WrittenFileRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="*,140,220" ColumnSpacing="10">
                                                <SelectableTextBlock Classes="cell mono" FontSize="12" Text="{Binding Path}" />
                                                <TextBlock Grid.Column="1" Classes="cell via" Text="{Binding What}" />
                                                <TextBlock Grid.Column="2" Classes="cell up" Classes.bad="{Binding IsWarn}" Text="{Binding Status}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Apps and logs -->
            <Grid IsVisible="{Binding OnAppsTab}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="240" MaxWidth="560" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- The list picks what the log shows: every app, or one -->
                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Margin="12,10,12,8" Spacing="8">
                        <ItemsControl ItemsSource="{Binding Chips}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StateChip">
                                    <Button Classes="chip" Classes.on="{Binding IsOn}" Margin="0,0,6,6"
                                            Command="{Binding PickCommand}" CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Ellipse Classes="dot" Width="7" Height="7" VerticalAlignment="Center"
                                                     Classes.up="{Binding IsReadyKind}" Classes.bad="{Binding IsProblemKind}" />
                                            <TextBlock Text="{Binding Label}" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBox Text="{Binding AppFilter}" PlaceholderText="{Binding Apps.Count, StringFormat='Filter {0} apps'}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{Binding ListCaption}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                            <Button Grid.Column="1" Classes="flat" Command="{Binding ToggleAllReposCommand}" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding FoldLabel}" FontSize="11.5" Foreground="{StaticResource AccentBrush}" />
                            </Button>
                        </Grid>
                    </StackPanel>
                    <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="AppList" ItemsSource="{Binding ListRows}" Margin="0,4,0,10">
                            <ItemsControl.DataTemplates>
                                <DataTemplate DataType="vm:AllAppsEntry" x:DataType="vm:AllAppsEntry">
                                    <Button Classes="flat" Command="{Binding $parent[UserControl].((vm:SproutsViewModel)DataContext).OpenAllAppsCommand}">
                                        <Border Classes="approw" Classes.selected="{Binding IsSelected}" Padding="12,8">
                                            <Grid ColumnDefinitions="22,*,Auto">
                                                <PathIcon Width="13" Height="13" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Left"
                                                          Data="M3 5h18v2H3z M3 11h18v2H3z M3 17h12v2H3z" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Classes="appname" Text="All apps" FontSize="13" Foreground="{StaticResource TitleBrush}" />
                                                    <TextBlock Text="{Binding Caption}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="11.5" VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                                <DataTemplate DataType="vm:AppListHeader" x:DataType="vm:AppListHeader">
                                    <Button Classes="flat" IsHitTestVisible="{Binding CanFold}" CommandParameter="{Binding}"
                                            Command="{Binding $parent[UserControl].((vm:SproutsViewModel)DataContext).ToggleRepoCommand}">
                                        <Grid ColumnDefinitions="14,Auto,*" Margin="12,10,12,4">
                                            <TextBlock Text="{Binding Chevron}" FontSize="10" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" LetterSpacing="1"
                                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Classes="state" Text="{Binding Caption}" FontSize="11" Margin="8,0,0,0"
                                                       Classes.bad="{Binding CaptionIsBad}" VerticalAlignment="Center" ToolTip.Tip="{Binding CaptionTip}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                                <DataTemplate DataType="vm:AppListEntry" x:DataType="vm:AppListEntry">
                                    <!-- Start, stop and pin are on a menu the view opens: right-click the row, or click its ⋮ -->
                                    <Border Classes="approw" Classes.selected="{Binding Row.IsSelected}" Padding="0,0,4,0">
                                        <Grid ColumnDefinitions="*,Auto">
                                        <Button Classes="flat" CommandParameter="{Binding Row}"
                                                Command="{Binding $parent[UserControl].((vm:SproutsViewModel)DataContext).OpenAppRowCommand}">
                                            <Grid ColumnDefinitions="22,*,Auto,Auto" Margin="12,6,4,6">
                                                <Ellipse Classes="dot" Width="8" Height="8" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                         Classes.up="{Binding Row.IsGood}" Classes.busy="{Binding Row.IsBusy}"
                                                         Classes.bad="{Binding Row.IsProblem}" Classes.done="{Binding Row.IsFinished}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Classes="appname" Text="{Binding Row.App}" FontSize="13"
                                                               Foreground="{StaticResource TitleBrush}" TextTrimming="CharacterEllipsis" />
                                                    <Grid ColumnDefinitions="Auto,*">
                                                        <TextBlock Text="{Binding Row.Repo, StringFormat='{}{0} · '}" IsVisible="{Binding InPinned}"
                                                                   FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                                                        <TextBlock Grid.Column="1" Classes="state" Text="{Binding Row.StateLine}" FontSize="11.5"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Row.StateLine}"
                                                                   Classes.up="{Binding Row.IsGood}" Classes.bad="{Binding Row.IsProblem}"
                                                                   Classes.busy="{Binding Row.IsBusy}" Classes.done="{Binding Row.IsFinished}" />
                                                    </Grid>
                                                </StackPanel>
                                                <PathIcon Grid.Column="2" Width="11" Height="11" Margin="6,0,0,0" VerticalAlignment="Center"
                                                          Data="{StaticResource PinIcon}" Foreground="{StaticResource AccentBrush}"
                                                          IsVisible="{Binding Row.IsPinned}" ToolTip.Tip="Pinned" />
                                                <TextBlock Grid.Column="3" Text="{Binding Row.Port}" FontSize="11.5" Margin="8,0,0,0"
                                                           FontFamily="Cascadia Mono,Consolas,monospace" VerticalAlignment="Center"
                                                           Foreground="{StaticResource MutedBrush}" />
                                            </Grid>
                                        </Button>
                                        <Button Grid.Column="1" Classes="flat more" Width="20" Height="26" VerticalAlignment="Center"
                                                ToolTip.Tip="Start, stop or pin" Click="OpenAppMenu">
                                            <TextBlock Text="⋮" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.DataTemplates>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>

                <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="Transparent"
                              BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" />

                <!-- The log the list picked, with the picked app's details beside it (over it, in a narrow window) -->
                <Grid x:Name="LogArea" Grid.Column="2" ColumnDefinitions="*,Auto">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LogTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                                    <TextBlock Classes="state" Text="{Binding LogSub}" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                               Classes.up="{Binding LogApp.IsGood, FallbackValue=False}"
                                               Classes.bad="{Binding LogApp.IsProblem, FallbackValue=False}"
                                               Classes.done="{Binding LogApp.IsFinished, FallbackValue=False}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" IsVisible="{Binding Logs.IsAll}" VerticalAlignment="Center">
                                    <Button Classes="toggle" Classes.on="{Binding StreamingList}" Command="{Binding StreamListCommand}"
                                            CornerRadius="6,0,0,6" Content="{Binding AllApps.Count, StringFormat='Apps in the list · {0}'}" />
                                    <Button Classes="toggle" Classes.on="{Binding StreamPinned}" Command="{Binding StreamPinsCommand}"
                                            CornerRadius="0,6,6,0" BorderThickness="0,1,1,1" IsEnabled="{Binding HasPins}"
                                            Content="{Binding PinnedCount, StringFormat='Pinned · {0}'}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsVisible="{Binding Logs.IsOne}" VerticalAlignment="Center">
                                    <Button Classes="small" Content="Start" IsVisible="{Binding !LogApp.IsAlive, FallbackValue=False}"
                                            Command="{Binding StartAppCommand}" CommandParameter="{Binding LogApp}" />
                                    <Button Classes="small" Content="Restart" IsVisible="{Binding LogApp.IsAlive, FallbackValue=False}"
                                            Command="{Binding StartAppCommand}" CommandParameter="{Binding LogApp}" />
                                    <Button Classes="small" Content="Stop" IsVisible="{Binding LogApp.IsAlive, FallbackValue=False}"
                                            Command="{Binding StopAppCommand}" CommandParameter="{Binding LogApp}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="280" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="LogSearch" Text="{Binding Logs.Search}" PlaceholderText="Search this log" FontSize="12.5" />
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="0">
                                    <Button Classes="toggle" Classes.on="{Binding Logs.ShowTimes}" Command="{Binding ToggleLogTimesCommand}"
                                            CornerRadius="6,0,0,6" Content="Timestamps" IsEnabled="{Binding Logs.HasTimes}"
                                            ToolTip.Tip="Show when each line was written" />
                                    <Button Classes="toggle" Classes.on="{Binding Logs.Wrap}" Command="{Binding ToggleLogWrapCommand}"
                                            CornerRadius="0,6,6,0" BorderThickness="0,1,1,1" Content="Wrap"
                                            ToolTip.Tip="Wrap long lines; off, they run on and the log scrolls sideways" />
                                </StackPanel>
                                <Button Grid.Column="3" Classes="toggle" Classes.warnon="{Binding Logs.ProblemsOnly}"
                                        Content="Warnings and errors" Click="ToggleProblems" />
                            </Grid>
                        </Border>
                        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Classes="cell via" Text="{Binding Logs.Summary}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="Drag or Shift+click lines, Ctrl+C to copy. Right-click a line for more." FontSize="11"
                                           Foreground="#6E6E82" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                            </Grid>
                        </Border>
                        <Grid>
                            <ListBox x:Name="LogList" Classes="log" Classes.nowrap="{Binding !Logs.Wrap}" ItemsSource="{Binding Logs.Lines}"
                                     SelectionMode="Multiple">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="logs:LogRow">
                                        <Border Classes="logrow" Classes.error="{Binding IsError}" Padding="12,0">
                                        <Grid ColumnDefinitions="Auto,Auto,*">
                                            <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12"
                                                       Foreground="#5F5F74" VerticalAlignment="Top" Width="88"
                                                       IsVisible="{Binding $parent[UserControl].((vm:SproutsViewModel)DataContext).Logs.TimesShown}" />
                                            <Button Grid.Column="1" Classes="flat" Width="110" Margin="0,0,10,0" VerticalAlignment="Top"
                                                    IsVisible="{Binding $parent[UserControl].((vm:SproutsViewModel)DataContext).Logs.IsAll}"
                                                    ToolTip.Tip="Open its own log" CommandParameter="{Binding}"
                                                    Command="{Binding $parent[UserControl].((vm:SproutsViewModel)DataContext).OpenAppOfLineCommand}">
                                                <TextBlock Text="{Binding Label}" Foreground="{Binding LabelBrush}" TextAlignment="Right"
                                                           FontFamily="Cascadia Mono,Consolas,monospace" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                            <controls:AnsiLine Grid.Column="2" Line="{Binding}" Classes="logline"
                                                               Classes.error="{Binding IsError}" Classes.warn="{Binding IsWarning}" />
                                        </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Button IsVisible="{Binding Logs.IsPaused}" Command="{Binding Logs.JumpToLatestCommand}"
                                    HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,14"
                                    Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold"
                                    CornerRadius="999" Padding="14,7" FontSize="12.5" Content="{Binding Logs.PausedText}" />
                        </Grid>
                    </DockPanel>

                    <!-- Folded: a strip on the right edge that opens the details again -->
                    <Button Grid.Column="1" Classes="flat" Width="30" VerticalAlignment="Stretch" VerticalContentAlignment="Stretch"
                            IsVisible="{Binding !DetailsOpen}" Command="{Binding ToggleDetailsCommand}" ToolTip.Tip="Show the app's details">
                        <Border Classes="rail" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0" Padding="0,12">
                            <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Top">
                                <TextBlock Text="‹" FontSize="16" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
                                <LayoutTransformControl HorizontalAlignment="Center">
                                    <LayoutTransformControl.LayoutTransform>
                                        <RotateTransform Angle="90" />
                                    </LayoutTransformControl.LayoutTransform>
                                    <TextBlock Text="DETAILS" FontSize="10.5" FontWeight="SemiBold" LetterSpacing="1.5"
                                               Foreground="{StaticResource MutedBrush}" />
                                </LayoutTransformControl>
                            </StackPanel>
                        </Border>
                    </Button>

                    <!-- The picked app's details: beside the log rather than above it -->
                    <Border x:Name="DetailsPanel" Grid.Column="1" Width="300" IsVisible="{Binding DetailsOpen}" Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="16,10,16,14" Spacing="14">
                                <Button Classes="flat" Command="{Binding ToggleDetailsCommand}" ToolTip.Tip="Fold the details away">
                                    <Grid ColumnDefinitions="*,Auto" Background="Transparent">
                                        <TextBlock Classes="phead" Text="DETAILS" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="›" FontSize="16" Foreground="{StaticResource MutedBrush}" Margin="6,0" />
                                    </Grid>
                                </Button>
                                <TextBlock Classes="cell via" Text="Pick an app in the list to see its details."
                                           IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNull}}" />
                                <StackPanel Spacing="14" IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Details.Repo}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
                                    <TextBlock Text="{Binding Details.Name}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                                    <TextBlock Classes="state" Text="{Binding PickedApp.StateLine}" FontSize="12" TextWrapping="Wrap"
                                               Classes.up="{Binding PickedApp.IsGood, FallbackValue=False}"
                                               Classes.bad="{Binding PickedApp.IsProblem, FallbackValue=False}"
                                               Classes.done="{Binding PickedApp.IsFinished, FallbackValue=False}" />
                                </StackPanel>
                                <StackPanel Spacing="6" IsVisible="{Binding Details.HasLinks, FallbackValue=False}">
                                    <TextBlock Classes="phead" Text="QUICK LINKS" />
                                    <ItemsControl ItemsSource="{Binding Details.Links}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="planning:PlannedLink">
                                                <TextBlock Classes="link" Text="{Binding Label, StringFormat='{}{0} ↗'}" Tag="{Binding Url}" FontSize="13"
                                                           Margin="0,2" ToolTip.Tip="{Binding Url}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <Grid ColumnDefinitions="84,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="7" ColumnSpacing="10">
                                    <TextBlock Classes="cell via" Text="Url" />
                                    <TextBlock Grid.Column="1" Classes="cell mono link" FontSize="12" Text="{Binding Details.Url}" Tag="{Binding Details.Url}"
                                               ToolTip.Tip="Click to open · middle-click for a new window · right-click to copy" />
                                    <TextBlock Grid.Row="1" Classes="cell via" Text="Folder" />
                                    <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="cell mono" FontSize="12" Text="{Binding Details.Folder}" />
                                    <TextBlock Grid.Row="2" Classes="cell via" Text="Values in" />
                                    <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="cell" FontSize="12" Text="{Binding Details.ValuesIn}" />
                                    <TextBlock Grid.Row="3" Classes="cell via" Text="Starts after" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Classes="cell" FontSize="12" Text="{Binding Details.StartsAfter}" />
                                    <TextBlock Grid.Row="4" Classes="cell via" Text="Ready when" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Classes="cell" FontSize="12" Text="{Binding Details.ReadyWhen}" />
                                    <TextBlock Grid.Row="5" Classes="cell via" Text="Restarts" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Classes="cell" FontSize="12" Text="{Binding PickedApp.Restarts}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Classes="small" Content="Open folder" Command="{Binding OpenFolderCommand}" />
                                    <Button Classes="small" Content="Copy env" Click="CopyEnv" />
                                </StackPanel>
                                <StackPanel Spacing="4" IsVisible="{Binding Details.HasSettings, FallbackValue=False}">
                                    <TextBlock Classes="phead" Text="VALUES" />
                                    <ItemsControl ItemsSource="{Binding Details.Settings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SettingRow">
                                                <Border Classes="row">
                                                    <StackPanel Spacing="1">
                                                        <TextBlock Classes="cell mono" FontSize="11.5" Text="{Binding Key}" Foreground="{StaticResource TitleBrush}" />
                                                        <SelectableTextBlock Classes="cell mono" FontSize="11.5" Text="{Binding Value}" />
                                                        <TextBlock Classes="cell via" FontSize="11" Text="{Binding Via}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <SelectableTextBlock Classes="cell via" FontSize="11" Text="{Binding Details.LogFile, StringFormat='Log file: {0}'}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
            </Panel>
        </DockPanel>

        <!-- Remove -->
        <Border ZIndex="50" Background="#B3060A12" IsVisible="{Binding ConfirmingRemove}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelRemoveCommand}" />
            </Border.KeyBindings>
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" MaxWidth="560" Margin="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Selected.Title, StringFormat='Remove {0}?'}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}" />
                    <TextBlock Classes="cell" Text="Its containers and their data (databases included) are deleted, and so are its worktrees. Sprig refuses if a worktree has changes that aren't committed." />
                    <CheckBox IsChecked="{Binding DeleteBranch}" IsVisible="{Binding CanDeleteBranch}"
                              Content="Also delete its branch (refused if it has commits no other branch or remote has)" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Keep it" Command="{Binding CancelRemoveCommand}" Background="{StaticResource ButtonBgBrush}"
                                Foreground="{StaticResource FgBrush}" Padding="14,7" />
                        <Button Content="Remove it" Command="{Binding RemoveCommand}" Background="{StaticResource DangerBrush}"
                                Foreground="#0B1220" FontWeight="SemiBold" Padding="14,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Remove several -->
        <Border ZIndex="50" Background="#B3060A12" IsVisible="{Binding ConfirmingBulkRemove}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelBulkRemoveCommand}" />
            </Border.KeyBindings>
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" MaxWidth="560" Margin="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding CheckedLabel, StringFormat='Remove {0}?'}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}" />
                    <TextBlock Classes="cell" Text="Each one's containers and their data are deleted, and so are its worktrees. Any with changes that aren't committed are skipped, and the summary says which." />
                    <TextBlock Classes="cell" Foreground="{StaticResource WarnBrush}" Text="{Binding GuardNote}"
                               IsVisible="{Binding GuardNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <CheckBox IsChecked="{Binding BulkDeleteBranches}"
                              Content="Also delete their branches (each refused if it has commits no other branch or remote has)" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Keep them" Command="{Binding CancelBulkRemoveCommand}" Background="{StaticResource ButtonBgBrush}"
                                Foreground="{StaticResource FgBrush}" Padding="14,7" />
                        <Button Content="Remove them" Command="{Binding BulkRemoveCommand}" Background="{StaticResource DangerBrush}"
                                Foreground="#0B1220" FontWeight="SemiBold" Padding="14,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- The files waiting for approval: over the new-sprout form too, which waits on them -->
        <ContentControl ZIndex="60" Content="{Binding Review}" IsVisible="{Binding Review.IsOpen}" />

        <!-- New sprout -->
        <Border ZIndex="50" Background="#B3060A12" IsVisible="{Binding IsAddOpen}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelAddCommand}" />
                <KeyBinding Gesture="Enter" Command="{Binding CreateCommand}" />
            </Border.KeyBindings>
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" MaxWidth="560" Margin="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="New sprout" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasTrellises}"
                               Text="Add a repo on the Repos page, or a trellis on the Trellises page, first." />
                    <StackPanel Spacing="10" IsVisible="{Binding HasTrellises}">
                        <StackPanel Spacing="4">
                            <TextBlock Classes="phead" Text="TRELLIS OR REPO" />
                            <ComboBox ItemsSource="{Binding TrellisNames}" SelectedItem="{Binding NewTrellis}" HorizontalAlignment="Stretch" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="phead" Text="NAME" />
                            <TextBox x:Name="NewNameBox" Text="{Binding NewName}" PlaceholderText="{Binding NewNameHint}" />
                        </StackPanel>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="phead" Text="WHERE IT RUNS" />
                            <RadioButton GroupName="new-where" IsChecked="{Binding NewHasWorktrees}"
                                         Content="In worktrees of its own, on a branch of its own" />
                            <RadioButton GroupName="new-where" IsChecked="{Binding NewInPlace}"
                                         Content="In place, where the repos are checked out (one such sprout at a time)" />
                        </StackPanel>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding NewHasWorktrees}">
                            <StackPanel Spacing="4">
                                <TextBlock Classes="phead" Text="BRANCH" />
                                <TextBox Text="{Binding NewBranch}" PlaceholderText="Default: the sprout's name" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Classes="phead" Text="STARTING FROM" />
                                <TextBox Text="{Binding NewFrom}" PlaceholderText="Each repo's default branch"
                                         ToolTip.Tip="Used only when the branch doesn't exist yet" />
                            </StackPanel>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock Classes="phead" Text="PORTS" />
                            <RadioButton GroupName="new-ports" IsChecked="{Binding NewStablePorts}"
                                         Content="Keep the ports it's given until it's removed" />
                            <RadioButton GroupName="new-ports" IsChecked="{Binding NewRandomPorts}"
                                         Content="Fresh ports each time it comes up" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Classes="msg" Text="{Binding FormMessage}" FontSize="12.5" TextWrapping="Wrap"
                               Classes.bad="{Binding FormFailed}" IsVisible="{Binding MessageInModal}" />
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource TrustPanel}" IsVisible="{Binding TrustInModal}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Cancel" Command="{Binding CancelAddCommand}"
                                Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="14,7" />
                        <Button Content="Sprout it" Command="{Binding CreateCommand}" IsVisible="{Binding HasTrellises}"
                                IsEnabled="{Binding !IsWorking}"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="14,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
