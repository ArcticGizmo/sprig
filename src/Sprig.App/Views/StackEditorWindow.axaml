<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sprig.App.ViewModels"
        xmlns:controls="clr-namespace:Sprig.App.Controls"
        xmlns:coach="clr-namespace:Sprig.App.Coach"
        x:Class="Sprig.App.Views.StackEditorWindow"
        x:DataType="vm:StacksViewModel"
        Title="{Binding OverlayTitle}"
        Width="1080" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBgBrush}"
        Icon="/Assets/sprig.ico">

    <!-- The whole editor sits under a coach layer so a guided-tour step can still spotlight the canvas
         and the Create button now that the builder lives in its own resizable window. -->
    <Grid>
        <DockPanel x:Name="EditorRoot" LastChildFill="True" Margin="22">
            <TextBlock DockPanel.Dock="Top" Text="{Binding OverlayTitle}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}" VerticalAlignment="Center" Margin="0,0,0,14" />

            <!-- Name + capacity — always visible: you name the stack, size its pool, then wire it on the canvas. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,16,120" Margin="0,0,0,14">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBox Text="{Binding NewName, Mode=TwoWay}" PlaceholderText="e.g. web+api" />
                    <TextBlock IsVisible="{Binding HasNameError}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}" Text="{Binding NameError}" />
                    <TextBlock IsVisible="{Binding !HasNameError}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Used for the worktree folder, branch and CLI — letters, numbers, and . _ + - (no spaces)." />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Capacity" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               ToolTip.Tip="The most workspaces this stack's pool may hold at once." />
                    <TextBox Text="{Binding NewCapacity, Mode=TwoWay}" PlaceholderText="3" />
                    <TextBlock IsVisible="{Binding HasCapacityError}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}" Text="{Binding CapacityError}" />
                    <TextBlock IsVisible="{Binding !HasCapacityError}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Text="max workspaces at once" />
                </StackPanel>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
                <TextBlock IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{StaticResource DangerBrush}" Text="{Binding Error}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{Binding OverlayCta}" Command="{Binding CreateCommand}"
                            AutomationProperties.AutomationId="stack.create"
                            Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                    <Button Content="Cancel" Command="{Binding CancelCreateCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Guidance and legend stay pinned; only the canvas scrolls. The canvas fills whatever
                 vertical space is left between them, so the text is never pushed off-screen. -->
            <DockPanel LastChildFill="True">
                <!-- The repo graph is the stack editor. The "Guess owners" assist sits at the top. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="12" Margin="0,0,0,8">
                    <Button Content="⌕ Guess owners" Command="{Binding GuessOwnersCommand}"
                            VerticalAlignment="Center" Padding="10,4" FontSize="11"
                            ToolTip.Tip="Infer each unowned port's owner from its name (e.g. api_port → api). Only fills blanks — your picks are kept." />
                </StackPanel>

                <!-- Leads with what has already happened, since the canvas arrives wired now. -->
                <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,8" IsVisible="{Binding CanAutoWire}">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource FgBrush}"
                               Text="Each input has been wired to a port by convention. Review it and change anything that isn't what you meant — two repos only share a port if you say so." />
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Repos are nodes; a port with an owner and one other consumer draws as an owner→consumer line, and anything shared becomes a counted chip. Hover a repo or a line to reveal port names. Click a repo to edit its inputs, a chip to name its owner, or a line to change/clear it. Drag a node to tidy." />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !CanAutoWire}"
                           Text="Add a repo to start — use the ＋ add repo node on the canvas. sprig reads the inputs it declares and wires them to ports for you." />

                <!-- Legend pinned to the bottom. -->
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <TextBlock Text="→ owner → consumer" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="⬡ shared ports" Foreground="#FBBF24" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="● port" Foreground="#4ADE80" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="● composite" Foreground="#1F9D54" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="● literal" Foreground="#FB923C" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="● undefined port" Foreground="{StaticResource DangerBrush}" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="○ empty" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="★ provides" Foreground="{StaticResource OkBrush}" FontSize="11" />
                </WrapPanel>

                <!-- A persistent ports rail on the left: create / rename / remove / reorder ports, accept
                     ones a binding references but the stack hasn't defined yet, and spot at a glance which
                     ports nothing uses. Reflection bindings (CompileBindings off) keep the per-row
                     StackPortRow commands and the window-VM commands simple. -->
                <DockPanel LastChildFill="True">
                    <Border DockPanel.Dock="Left" x:CompileBindings="False" Width="236"
                            Background="{StaticResource FormBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="Ports" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource TitleBrush}" Margin="0,0,0,8" />
                            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                <TextBox Grid.Column="0" Text="{Binding DefinedPortEntry}" PlaceholderText="new port name" FontSize="12">
                                    <TextBox.KeyBindings>
                                        <KeyBinding Gesture="Enter" Command="{Binding AddDefinedPortCommand}" />
                                    </TextBox.KeyBindings>
                                </TextBox>
                                <Button Grid.Column="1" Content="＋" Command="{Binding AddDefinedPortCommand}" Margin="4,0,0,0"
                                        ToolTip.Tip="Define this port" />
                            </Grid>

                            <!-- Referenced but undefined — quick-add each into existence. -->
                            <StackPanel DockPanel.Dock="Bottom" IsVisible="{Binding HasUndeclaredPorts}" Spacing="4" Margin="0,8,0,0">
                                <TextBlock Text="Not yet defined" FontSize="10.5" FontWeight="SemiBold"
                                           Foreground="{StaticResource DangerBrush}" />
                                <ItemsControl ItemsSource="{Binding UndeclaredPorts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,3">
                                                <TextBlock Grid.Column="0" Text="{Binding}" FontSize="12"
                                                           Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                                                <Button Grid.Column="1" Content="＋ add" FontSize="10" Padding="6,1"
                                                        Command="{Binding $parent[Window].DataContext.AcceptPortCommand}"
                                                        CommandParameter="{Binding}" ToolTip.Tip="Define this port" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- The defined ports themselves — rename inline, remove, and dim/flag the unused. -->
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <Panel>
                                    <TextBlock Text="No ports defined yet." FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !HasPorts}" />
                                    <ItemsControl ItemsSource="{Binding Ports}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border IsVisible="{Binding Name, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                                        Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="6,3" Margin="0,0,0,4">
                                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                                        <!-- view mode: name + previewed port number + unused flag -->
                                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5"
                                                                    VerticalAlignment="Center" IsVisible="{Binding !Editing}">
                                                            <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                                                                       TextTrimming="CharacterEllipsis" Foreground="{StaticResource OkBrush}" />
                                                            <TextBlock Text="{Binding Preview, StringFormat=':{0}'}" FontSize="10"
                                                                       VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                                                                       ToolTip.Tip="Previewed host port number (order decides it)" />
                                                            <Border Background="#3A2A12" CornerRadius="4" Padding="4,0" VerticalAlignment="Center"
                                                                    IsVisible="{Binding !InUse}" ToolTip.Tip="No input references this port">
                                                                <TextBlock Text="unused" FontSize="9.5" Foreground="#FBBF24" />
                                                            </Border>
                                                        </StackPanel>
                                                        <Button Grid.Column="1" Content="↑" FontSize="10" Padding="3,0" Background="Transparent"
                                                                IsVisible="{Binding !Editing}" ToolTip.Tip="Move up (lower port number)"
                                                                Command="{Binding $parent[Window].DataContext.MovePortUpCommand}" CommandParameter="{Binding}" />
                                                        <Button Grid.Column="2" Content="↓" FontSize="10" Padding="3,0" Background="Transparent"
                                                                IsVisible="{Binding !Editing}" ToolTip.Tip="Move down (higher port number)"
                                                                Command="{Binding $parent[Window].DataContext.MovePortDownCommand}" CommandParameter="{Binding}" />
                                                        <Button Grid.Column="3" Content="✎" FontSize="10" Padding="3,0" Background="Transparent"
                                                                IsVisible="{Binding !Editing}" Command="{Binding StartEditCommand}" ToolTip.Tip="Rename" />
                                                        <Button Grid.Column="4" Content="✕" FontSize="10" Padding="3,0" Background="Transparent"
                                                                IsVisible="{Binding !Editing}" ToolTip.Tip="Remove"
                                                                Command="{Binding $parent[Window].DataContext.RemoveNamedPortCommand}"
                                                                CommandParameter="{Binding Name}" />
                                                        <!-- rename mode -->
                                                        <TextBox Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding EditName}" FontSize="12"
                                                                 IsVisible="{Binding Editing}">
                                                            <TextBox.KeyBindings>
                                                                <KeyBinding Gesture="Enter"
                                                                            Command="{Binding $parent[Window].DataContext.CommitPortRenameCommand}"
                                                                            CommandParameter="{Binding}" />
                                                                <KeyBinding Gesture="Escape" Command="{Binding CancelEditCommand}" />
                                                            </TextBox.KeyBindings>
                                                        </TextBox>
                                                        <Button Grid.Column="3" Content="✓" FontSize="10" Padding="3,0" IsVisible="{Binding Editing}"
                                                                Command="{Binding $parent[Window].DataContext.CommitPortRenameCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Grid.Column="4" Content="✕" FontSize="10" Padding="3,0" IsVisible="{Binding Editing}"
                                                                Command="{Binding CancelEditCommand}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Panel>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <!-- The graph canvas fills the remaining space; its own ScrollViewer is the only scrollbar. -->
                    <Border Background="{StaticResource FormBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <controls:RepoGraphCanvas Graph="{Binding BuilderRepoGraph}" IsEditable="True"
                                                      AutomationProperties.AutomationId="stack.graph"
                                                      HorizontalAlignment="Center"
                                                      SetOwnerCommand="{Binding SetPortOwnerCommand}"
                                                      EditRepoCommand="{Binding EditRepoInputsCommand}"
                                                      AddableRepos="{Binding AddableRepos}"
                                                      AddRepoCommand="{Binding AddStackRepoCommand}"
                                                      RemoveRepoCommand="{Binding RemoveStackRepoCommand}" />
                        </ScrollViewer>
                    </Border>
                </DockPanel>
            </DockPanel>
        </DockPanel>

        <!-- Coach layer for the editor window. DataContext + AnchorRoot are set in code-behind (AttachCoach);
             left null otherwise so it stays inert (e.g. static docs captures). -->
        <coach:CoachOverlay x:Name="Coachmarks" />

        <!-- Per-repo input editor, opened by clicking a node on the repo graph. Each input is a token box
             over the repo's bindings, so the graph's pins and lines redraw live behind this. Clicking the
             scrim (handled in code-behind) or Done closes it. -->
        <Border x:Name="RepoEditorScrim" Background="#B0000000"
                IsVisible="{Binding RepoEditor, Converter={x:Static ObjectConverters.IsNotNull}}"
                PointerPressed="OnScrimPressed">
            <Border DataContext="{Binding RepoEditor}" x:DataType="vm:RepoInputEditorViewModel"
                    Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="20"
                    Width="540" MaxHeight="640" HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock Text="{Binding RepoName, StringFormat='Edit {0}'}" FontSize="16"
                                       FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                            <TextBlock Text="Set what fills each input — the graph updates as you go."
                                       FontSize="11.5" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseCommand}"
                                Padding="8,2" VerticalAlignment="Top" />
                    </Grid>

                    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="Reference a port with ${sprig.ports.NAME}; define ports on the main screen." />
                        <Button Grid.Column="1" Content="Done" Command="{Binding CloseCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RepoInputRowViewModel">
                                    <Grid ColumnDefinitions="150,*" Margin="0,0,4,12">
                                        <StackPanel Grid.Column="0" Spacing="1" Margin="0,0,10,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Input}" FontSize="12.5" Foreground="{StaticResource FgBrush}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Example}" FontSize="10.5" Foreground="{StaticResource MutedBrush}"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding Example, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>

                                        <!-- The full custom editor (autocomplete + highlighting), same as everywhere else. A
                                             reference to a port that isn't defined yet shows red until it's accepted on the
                                             main screen's "Defined ports" panel. -->
                                        <controls:SprigTokenBox Grid.Column="1" VerticalAlignment="Center"
                                                                Value="{Binding Expression, Mode=TwoWay}" Variables="{Binding Variables}"
                                                                Watermark="literal or ${sprig.ports.NAME}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>
    </Grid>
</Window>
