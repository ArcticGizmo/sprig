<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Sprig.App.ViewModels"
        xmlns:controls="clr-namespace:Sprig.App.Controls"
        xmlns:coach="clr-namespace:Sprig.App.Coach"
        x:Class="Sprig.App.Views.StackEditorWindow"
        x:DataType="vm:StacksViewModel"
        Title="{Binding OverlayTitle}"
        Width="1080" Height="780" MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource PanelBgBrush}"
        Icon="/Assets/sprig.ico">

    <!-- The whole editor sits under a coach layer so a guided-tour step can still spotlight the canvas
         and the Create button now that the builder lives in its own resizable window. -->
    <Grid>
        <DockPanel x:Name="EditorRoot" LastChildFill="True" Margin="22">
            <TextBlock DockPanel.Dock="Top" Text="{Binding OverlayTitle}" FontSize="18" FontWeight="SemiBold"
                       Foreground="{StaticResource TitleBrush}" VerticalAlignment="Center" Margin="0,0,0,14" />

            <!-- Name + capacity — always visible: you name the stack, size its pool, then wire it on the canvas. -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,16,120" Margin="0,0,0,14">
                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock Text="Name" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                    <TextBox Text="{Binding NewName, Mode=TwoWay}" PlaceholderText="e.g. web+api" />
                    <TextBlock IsVisible="{Binding HasNameError}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}" Text="{Binding NameError}" />
                    <TextBlock IsVisible="{Binding !HasNameError}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Used for the worktree folder, branch and CLI — letters, numbers, and . _ + - (no spaces)." />
                </StackPanel>
                <StackPanel Grid.Column="2" Spacing="4">
                    <TextBlock Text="Capacity" Foreground="{StaticResource MutedBrush}" FontSize="12"
                               ToolTip.Tip="The most workspaces this stack's pool may hold at once." />
                    <TextBox Text="{Binding NewCapacity, Mode=TwoWay}" PlaceholderText="3" />
                    <TextBlock IsVisible="{Binding HasCapacityError}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource DangerBrush}" Text="{Binding CapacityError}" />
                    <TextBlock IsVisible="{Binding !HasCapacityError}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}" Text="max workspaces at once" />
                </StackPanel>
            </Grid>
            <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,14,0,0">
                <TextBlock IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Foreground="{StaticResource DangerBrush}" Text="{Binding Error}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{Binding OverlayCta}" Command="{Binding CreateCommand}"
                            AutomationProperties.AutomationId="stack.create"
                            Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                    <Button Content="Cancel" Command="{Binding CancelCreateCommand}" />
                </StackPanel>
            </StackPanel>

            <!-- Guidance and legend stay pinned; only the canvas scrolls. The canvas fills whatever
                 vertical space is left between them, so the text is never pushed off-screen. -->
            <DockPanel LastChildFill="True">
                <!-- View switch: the patchbay (port-centric wiring) vs the repo graph (repo-centric
                     dependencies). Same edit surface, two lenses on the same build. The "Guess owners"
                     assist only makes sense on the graph, so it rides alongside and shows there. -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" HorizontalAlignment="Center"
                            Spacing="12" Margin="0,0,0,8">
                    <ToggleSwitch IsChecked="{Binding GraphView}" OffContent="Patchbay" OnContent="Repo graph"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Switch between the port patchbay and the repo dependency graph" />
                    <Button Content="⌕ Guess owners" Command="{Binding GuessOwnersCommand}"
                            IsVisible="{Binding GraphView}" VerticalAlignment="Center" Padding="10,4" FontSize="11"
                            ToolTip.Tip="Infer each unowned port's owner from its name (e.g. api_port → api). Only fills blanks — your picks are kept." />
                </StackPanel>

                <!-- Leads with what has already happened, since the canvas arrives wired now. -->
                <StackPanel DockPanel.Dock="Top" Spacing="3" Margin="0,0,0,8" IsVisible="{Binding CanAutoWire}">
                    <TextBlock FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource FgBrush}"
                               Text="Each input has been wired to a port by convention. Review it and change anything that isn't what you meant — two repos only share a port if you say so." />
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding !GraphView}"
                               Text="Drag a port onto an input to rewire it, or drag an input back to a source to unbind it. Click a port to rename it, an input to set a literal value, a ƒ node to edit a transform, or a line to select it." />
                    <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               IsVisible="{Binding GraphView}"
                               Text="Repos are nodes; a port with an owner and one other consumer draws as an owner→consumer line, and anything shared becomes a counted chip. Click a chip to name its owner (turning it into a line), or a line to change/clear it. Drag a node to tidy." />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"
                           Foreground="{StaticResource MutedBrush}" IsVisible="{Binding !CanAutoWire}"
                           Text="Add a repo below to start. sprig reads the inputs it declares and wires them to ports for you." />

                <!-- Column headers, aligned to the canvas columns (patchbay only). -->
                <Grid DockPanel.Dock="Top" HorizontalAlignment="Center" Width="820" ColumnDefinitions="194,342,284" Margin="0,0,0,8"
                      IsVisible="{Binding !GraphView}">
                    <TextBlock Grid.Column="0" Text="SOURCE" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    <Button Grid.Column="0" Content="✦ Tidy" Command="{Binding CleanupCommand}"
                            IsVisible="{Binding CanCleanup}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Padding="8,2" FontSize="10"
                            ToolTip.Tip="Reorder sources and repos to reduce line crossings" />
                    <TextBlock Grid.Column="1" Text="TRANSFORM" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                    <TextBlock Grid.Column="2" Text="REPO" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                </Grid>

                <!-- Legend pinned to the bottom, per view. -->
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" IsVisible="{Binding !GraphView}">
                    <TextBlock Text="■ plain" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="■ transform" Foreground="{StaticResource DevBrush}" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="■ producer port" Foreground="{StaticResource OkBrush}" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="■ unbound" Foreground="{StaticResource DangerBrush}" FontSize="11" />
                </WrapPanel>
                <WrapPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" IsVisible="{Binding GraphView}">
                    <TextBlock Text="■ owner → consumer line" Foreground="{StaticResource AccentBrush}" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="■ shared port chip" Foreground="#FBBF24" FontSize="11" Margin="0,0,14,0" />
                    <TextBlock Text="■ owns a port" Foreground="{StaticResource OkBrush}" FontSize="11" />
                </WrapPanel>

                <!-- The canvas fills the remaining space; its own ScrollViewer is the only scrollbar.
                     Both lenses live here; the toggle shows one. -->
                <Border Background="{StaticResource FormBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <Panel>
                            <controls:WiringCanvas Graph="{Binding BuilderWiring}" IsEditable="True"
                                                   IsVisible="{Binding !GraphView}"
                                                   AutomationProperties.AutomationId="stack.canvas"
                                                   HorizontalAlignment="Center"
                                                   WireCommand="{Binding WirePinCommand}"
                                                   UnwireCommand="{Binding UnwirePinCommand}"
                                                   WireWorkspaceCommand="{Binding WireWorkspaceCommand}"
                                                   CreatePortCommand="{Binding CreatePortCommand}"
                                                   SetExpressionCommand="{Binding SetExpressionCommand}"
                                                   Variables="{Binding BindingVariables}"
                                                   RenamePortCommand="{Binding RenamePortCommand}"
                                                   RemovePortCommand="{Binding RemoveNamedPortCommand}"
                                                   AddPortCommand="{Binding AddNamedPortCommand}"
                                                   AppendSourceCommand="{Binding AppendSourceCommand}"
                                                   AddableRepos="{Binding AddableRepos}"
                                                   AddRepoCommand="{Binding AddStackRepoCommand}"
                                                   RemoveRepoCommand="{Binding RemoveStackRepoCommand}"
                                                   ReorderRepoCommand="{Binding ReorderRepoCommand}"
                                                   ReorderPortCommand="{Binding ReorderPortCommand}"
                                                   AutoWireCommand="{Binding AutoWireCommand}" />
                            <controls:RepoGraphCanvas Graph="{Binding BuilderRepoGraph}" IsEditable="True"
                                                      IsVisible="{Binding GraphView}"
                                                      AutomationProperties.AutomationId="stack.graph"
                                                      HorizontalAlignment="Center"
                                                      SetOwnerCommand="{Binding SetPortOwnerCommand}" />
                        </Panel>
                    </ScrollViewer>
                </Border>
            </DockPanel>
        </DockPanel>

        <!-- Coach layer for the editor window. DataContext + AnchorRoot are set in code-behind (AttachCoach);
             left null otherwise so it stays inert (e.g. static docs captures). -->
        <coach:CoachOverlay x:Name="Coachmarks" />
    </Grid>
</Window>
