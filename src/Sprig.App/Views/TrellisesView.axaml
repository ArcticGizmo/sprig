<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sprig.App.ViewModels"
             xmlns:controls="clr-namespace:Sprig.App.Controls"
             x:Class="Sprig.App.Views.TrellisesView"
             x:DataType="vm:TrellisesViewModel">

    <UserControl.Styles>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource PanelBgBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,16" />
        </Style>
        <Style Selector="TextBlock.phead">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.5" />
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,monospace" />
        </Style>
        <Style Selector="TextBlock.via">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
            <Setter Property="FontSize" Value="11.5" />
        </Style>
        <!-- Colours that change with state live in styles: a local Foreground would beat them. -->
        <Style Selector="TextBlock.msg">
            <Setter Property="Foreground" Value="{StaticResource OkBrush}" />
        </Style>
        <Style Selector="TextBlock.severity">
            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
        </Style>
        <Style Selector="TextBlock.bad">
            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
        </Style>
        <Style Selector="Border.row">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="0,6" />
        </Style>
        <Style Selector="TextBlock.source">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        </Style>
        <Style Selector="TextBlock.source.virtual">
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        </Style>
        <Style Selector="TextBlock.source.missing">
            <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
        </Style>
        <Style Selector="Button.small">
            <Setter Property="Background" Value="{StaticResource ButtonBgBrush}" />
            <Setter Property="Foreground" Value="{StaticResource FgBrush}" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="FontSize" Value="12" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="320,*">

        <!-- Registered trellises -->
        <Border Grid.Column="0" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="20,24,16,16">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Trellises" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="+ New" Command="{Binding OpenNewCommand}" VerticalAlignment="Center"
                                IsEnabled="{Binding !IsEditing}"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="12,5" />
                    </Grid>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="A trellis puts repos together. Make one here, kept in sprig, or add a .trellis.cs from any folder." />
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,6,0,0" />
                </StackPanel>

                <TextBlock DockPanel.Dock="Top" Margin="0,12,0,0" FontSize="12.5" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" IsVisible="{Binding IsEmpty}"
                           Text="None yet. + New makes one from a few repo folders, with nothing committed to them." />

                <Grid RowDefinitions="*,Auto,*">
                <!-- Locked while a definition is open, so unsaved edits can't be left behind by picking another. -->
                <ListBox ItemsSource="{Binding Trellises}" SelectedItem="{Binding Selected}" Background="Transparent" Margin="0,8,0,0"
                         IsEnabled="{Binding !IsEditing}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:TrellisItem">
                            <StackPanel Spacing="2" Margin="0,2">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                                <TextBlock Text="{Binding Folder}" FontSize="11.5" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="File missing" FontSize="11.5" Foreground="{StaticResource DangerBrush}" IsVisible="{Binding Missing}" />
                                <TextBlock Text="Not approved yet" FontSize="11.5" Foreground="{StaticResource WarnBrush}"
                                           IsVisible="{Binding NeedsApproval}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Repos: a folder and the definition that describes it, for trellises to use by ID -->
                <StackPanel Grid.Row="1" Spacing="8" Margin="0,14,0,0">
                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                        <TextBlock Text="Repos" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Classes="small" Content="+ Add" Command="{Binding OpenRepoFormCommand}" IsEnabled="{Binding !IsEditing}"
                                ToolTip.Tip="Add a repo folder: its own sprig.cs if it has one, otherwise a draft kept in sprig" />
                    </Grid>
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" IsVisible="{Binding !HasRepoEntries}"
                               Text="None yet. Trellises use these by ID: trellis.UseRepo(&quot;shop-web&quot;)." />
                </StackPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding RepoEntries}" SelectedItem="{Binding SelectedRepo}" Background="Transparent"
                         Margin="0,6,0,0" IsEnabled="{Binding !IsEditing}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:RepoItem">
                            <StackPanel Spacing="2" Margin="0,2">
                                <TextBlock Text="{Binding Id}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                                <TextBlock Text="{Binding DisplayFolder}" FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Classes="source" Text="{Binding Kind}" FontSize="11.5" Classes.virtual="{Binding !InRepo}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                </Grid>
            </DockPanel>
        </Border>

        <!-- The selected trellis: its repos and plan, or one of its definitions open in the editor -->
        <Grid Grid.Column="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding !IsEditing}">
            <StackPanel Margin="28,24,28,28" Spacing="18" MaxWidth="1100" HorizontalAlignment="Stretch">

                <TextBlock IsVisible="{Binding NothingSelected}" Margin="0,40,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}"
                           Text="Select a trellis to see what a sprout of it would get, or a repo to see its definition." HorizontalAlignment="Center" />

                <!-- The selected repo -->
                <StackPanel Spacing="16" IsVisible="{Binding HasRepoSelection}">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding SelectedRepo.Id}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                            <TextBlock Text="{Binding SelectedRepo.DisplayFolder}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Edit definition" Command="{Binding EditSelectedRepoCommand}" VerticalAlignment="Top"
                                IsEnabled="{Binding !SelectedRepo.Missing, FallbackValue=False}"
                                Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="12,6" />
                        <Button Grid.Column="2" Content="{Binding SelectedRepo.SwitchLabel, FallbackValue=''}" Command="{Binding SwitchSelectedRepoCommand}"
                                VerticalAlignment="Top" ToolTip.Tip="Switch where its definition is kept; every trellis that uses it follows"
                                Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="12,6" />
                        <Button Grid.Column="3" Content="Remove" Command="{Binding DeleteSelectedRepoCommand}" VerticalAlignment="Top"
                                Background="Transparent" Foreground="{StaticResource DangerBrush}"
                                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Padding="12,5" />
                    </Grid>
                    <Border Classes="panel" BorderBrush="{StaticResource DangerBrush}" IsVisible="{Binding ConfirmingRepoDelete}">
                        <StackPanel Spacing="10">
                            <TextBlock Classes="cell" TextWrapping="Wrap"
                                       Text="Take it off the Repos list? One written in sprig is deleted; a repo's own sprig.cs is left where it is. Trellises that use it by ID will say it's missing." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Keep it" Command="{Binding CancelRepoDeleteCommand}" Background="{StaticResource ButtonBgBrush}"
                                        Foreground="{StaticResource FgBrush}" Padding="12,5" />
                                <Button Content="Remove it" Command="{Binding DeleteSelectedRepoCommand}" Background="{StaticResource DangerBrush}"
                                        Foreground="#0B1220" FontWeight="SemiBold" Padding="12,5" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Classes="panel">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                                <TextBlock Classes="cell via" Text="Kept" />
                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding SelectedRepo.Kind}" />
                                <TextBlock Grid.Row="1" Classes="cell via" Text="File" />
                                <SelectableTextBlock Grid.Row="1" Grid.Column="1" Classes="cell mono" FontSize="12"
                                                     Text="{Binding SelectedRepo.DisplayFile}" />
                                <TextBlock Grid.Row="2" Classes="cell via" Text="In a trellis" />
                                <SelectableTextBlock Grid.Row="2" Grid.Column="1" Classes="cell mono" FontSize="12" Text="{Binding SelectedRepo.Usage}" />
                                <TextBlock Grid.Row="3" Classes="cell via" Text="Used by" />
                                <TextBlock Grid.Row="3" Grid.Column="1" Classes="cell" Text="No trellis yet" Foreground="{StaticResource MutedBrush}"
                                           IsVisible="{Binding !HasRepoUsedBy}" />
                                <ItemsControl Grid.Row="3" Grid.Column="1" ItemsSource="{Binding RepoUsedBy}" IsVisible="{Binding HasRepoUsedBy}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <TextBlock Classes="cell" Text="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                            <TextBlock Classes="msg" Text="{Binding RepoCheck}" FontSize="12.5" TextWrapping="Wrap" Classes.bad="{Binding RepoCheckBad}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8" IsVisible="{Binding HasSelection}">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                        <TextBlock Text="{Binding Selected.DisplayPath}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Edit trellis" Command="{Binding EditTrellisCommand}" VerticalAlignment="Top"
                            IsEnabled="{Binding !Selected.Missing, FallbackValue=False}" ToolTip.Tip="Open the trellis's C# in the editor"
                            Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="12,6" />
                    <Button Grid.Column="2" Content="Plan again" Command="{Binding ReplanCommand}" VerticalAlignment="Top"
                            Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="12,6" />
                    <Button Grid.Column="3" Content="Remove" Command="{Binding RemoveCommand}" CommandParameter="{Binding Selected}"
                            VerticalAlignment="Top" Background="Transparent" Foreground="{StaticResource DangerBrush}"
                            BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" Padding="12,5" />
                </Grid>

                <StackPanel Spacing="8" IsVisible="{Binding IsBusy}">
                    <ProgressBar IsIndeterminate="True" Height="4" />
                    <TextBlock Text="{Binding BusyText}" FontSize="12.5" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <!-- Approval before anything runs -->
                <Border Classes="panel" BorderBrush="{StaticResource WarnBrush}" IsVisible="{Binding HasPendingTrust}">
                    <StackPanel Spacing="10">
                        <TextBlock Classes="phead" Text="APPROVE BEFORE RUNNING" Foreground="{StaticResource WarnBrush}" />
                        <TextBlock FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource FgBrush}"
                                   Text="These definitions are C# that sprig runs with your permissions. Read them first if you didn't write them. Approval covers this exact content; any change asks again." />
                        <ItemsControl ItemsSource="{Binding PendingTrust}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PendingTrustItem">
                                    <StackPanel Margin="0,3" Spacing="1">
                                        <TextBlock Classes="cell mono" Text="{Binding Path}" />
                                        <TextBlock Classes="cell via" Text="{Binding Why}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                                   IsVisible="{Binding PendingIsTrellis}"
                                   Text="The trellis is what names its repos, so any of their sprig.cs files you haven't approved are asked about next, once it has run." />
                        <Button Content="Approve and run" Command="{Binding ApproveAllCommand}" HorizontalAlignment="Left"
                                Background="{StaticResource WarnBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="14,7" />
                    </StackPanel>
                </Border>

                <!-- Problems that stopped the plan -->
                <Border Classes="panel" BorderBrush="{StaticResource DangerBrush}" IsVisible="{Binding HasLoadProblems}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="phead" Text="COULDN'T PLAN" Foreground="{StaticResource DangerBrush}" />
                        <ItemsControl ItemsSource="{Binding LoadProblems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProblemRow">
                                    <StackPanel Margin="0,3" Spacing="1">
                                        <TextBlock Classes="cell via mono" Text="{Binding Where}" />
                                        <TextBlock Classes="cell mono" Text="{Binding Message}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Where each repo's definition comes from, and what can be done about it -->
                <Border Classes="panel" IsVisible="{Binding HasRepos}">
                    <StackPanel Spacing="6">
                        <TextBlock Classes="phead" Text="REPOS AND THEIR DEFINITIONS" />
                        <ItemsControl ItemsSource="{Binding Repos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:TrellisRepoRow">
                                    <Border Classes="row">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="1">
                                                <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Classes="cell via mono" Text="{Binding DisplayDir}" />
                                                <TextBlock Classes="cell source" Text="{Binding Source}" FontSize="12"
                                                           Classes.virtual="{Binding InSprig}" Classes.missing="{Binding Undescribed}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <Button Classes="small" Content="Edit" IsVisible="{Binding CanEdit}" CommandParameter="{Binding}"
                                                        Command="{Binding $parent[UserControl].((vm:TrellisesViewModel)DataContext).EditRepoCommand}" />
                                                <Button Classes="small" Content="{Binding SwitchLabel}" IsVisible="{Binding CanSwitch}"
                                                        ToolTip.Tip="{Binding SwitchTip}" CommandParameter="{Binding}"
                                                        Command="{Binding $parent[UserControl].((vm:TrellisesViewModel)DataContext).SwitchRepoCommand}" />
                                                <Button Classes="small" Content="Add to Repos" IsVisible="{Binding CanAddToRepos}"
                                                        ToolTip.Tip="Use this repo through the Repos list, so where its definition is kept can be switched"
                                                        CommandParameter="{Binding}"
                                                        Command="{Binding $parent[UserControl].((vm:TrellisesViewModel)DataContext).AddToReposCommand}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- The plan -->
                <StackPanel Spacing="18" IsVisible="{Binding Plan, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <TextBlock Text="{Binding Plan.Summary}" FontSize="13" Foreground="{StaticResource FgBrush}" />

                    <Border Classes="panel" IsVisible="{Binding Plan.HasProblems}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="phead" Text="PROBLEMS" />
                            <ItemsControl ItemsSource="{Binding Plan.Problems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ProblemRow">
                                        <Grid ColumnDefinitions="70,*" Margin="0,3">
                                            <TextBlock Classes="cell severity" Text="{Binding Severity}" Classes.bad="{Binding IsError}" />
                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Classes="cell" Text="{Binding Message}" />
                                                <TextBlock Classes="cell via mono" Text="{Binding Where}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel" IsVisible="{Binding Plan.HasWiring}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="phead" Text="WIRING BETWEEN REPOS" />
                            <ItemsControl ItemsSource="{Binding Plan.Wiring}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:WiringRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="200,190,30,*">
                                                <TextBlock Classes="cell" Text="{Binding Consumer}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Classes="cell mono" Text="{Binding Key}" />
                                                <TextBlock Grid.Column="2" Classes="cell" Text="←" Foreground="{StaticResource AccentBrush}" />
                                                <StackPanel Grid.Column="3" Spacing="1">
                                                    <TextBlock Classes="cell" Text="{Binding Provider}" />
                                                    <TextBlock Classes="cell via mono" Text="{Binding Value}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Classes="panel">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="phead" Text="PORTS (A PREVIEW; LEASED WHEN A SPROUT COMES UP)" />
                            <ItemsControl ItemsSource="{Binding Plan.Ports}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:PortRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="160,160,100,80,*">
                                                <TextBlock Classes="cell via" Text="{Binding Owner}" />
                                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Resource}" />
                                                <TextBlock Grid.Column="2" Classes="cell" Text="{Binding Endpoint}" />
                                                <TextBlock Grid.Column="3" Classes="cell mono" Text="{Binding Port}" FontWeight="SemiBold"
                                                           Classes.bad="{Binding Failed}" />
                                                <TextBlock Grid.Column="4" Classes="cell via" Text="{Binding Pin, StringFormat='pin {0}'}"
                                                           IsVisible="{Binding Pin, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Plan.Apps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Spacing="18" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppSection">
                                <Border Classes="panel">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingRow">
                                                    <Border Classes="row">
                                                        <Grid ColumnDefinitions="230,*">
                                                            <StackPanel Spacing="1">
                                                                <TextBlock Classes="cell mono" Text="{Binding Key}" />
                                                                <TextBlock Classes="cell via" Text="{Binding File}" IsVisible="{Binding HasFile}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" Spacing="1">
                                                                <TextBlock Classes="cell mono" Text="{Binding Value}" Classes.bad="{Binding Unresolved}" />
                                                                <TextBlock Classes="cell via" Text="{Binding Via}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="panel" IsVisible="{Binding Plan.HasContainers}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="phead" Text="CONTAINERS SPRIG ADDS" />
                            <ItemsControl ItemsSource="{Binding Plan.Containers}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ContainerRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="140,110,200,*">
                                                <TextBlock Classes="cell via" Text="{Binding Owner}" />
                                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="2" Classes="cell mono" Text="{Binding Image}" />
                                                <StackPanel Grid.Column="3" Spacing="1">
                                                    <TextBlock Classes="cell mono" Text="{Binding Ports}" />
                                                    <TextBlock Classes="cell via" Text="{Binding Volumes}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Plan.Compose}" IsVisible="{Binding Plan.HasCompose}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AppSection">
                                <Border Classes="panel">
                                    <StackPanel Spacing="6">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource MutedBrush}" />
                                        <ItemsControl ItemsSource="{Binding Rows}" Margin="0,6,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SettingRow">
                                                    <Border Classes="row">
                                                        <Grid ColumnDefinitions="230,*">
                                                            <TextBlock Classes="cell mono" Text="{Binding Key}" />
                                                            <StackPanel Grid.Column="1" Spacing="1">
                                                                <TextBlock Classes="cell mono" Text="{Binding Value}" Classes.bad="{Binding Unresolved}" />
                                                                <TextBlock Classes="cell via" Text="{Binding Via}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="panel" IsVisible="{Binding Plan.HasGroups}">
                        <StackPanel Spacing="6">
                            <TextBlock Classes="phead" Text="GROUPS" />
                            <ItemsControl ItemsSource="{Binding Plan.Groups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:GroupRow">
                                        <Border Classes="row">
                                            <Grid ColumnDefinitions="120,*">
                                                <TextBlock Classes="cell" Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Classes="cell" Text="{Binding Apps}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- One definition open in the editor; saving approves it and plans again -->
        <DockPanel IsVisible="{Binding IsEditing}" Margin="24,20,24,16">
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding EditingTitle}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                    <TextBlock Text="{Binding EditingNote}" FontSize="12" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="Save" Command="{Binding SaveCommand}" IsEnabled="{Binding IsDirty}" VerticalAlignment="Top"
                        HotKey="Ctrl+S" ToolTip.Tip="Save, approve and plan again (Ctrl+S)"
                        Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="14,6" />
                <Button Grid.Column="2" Content="Close" Command="{Binding CloseEditorCommand}" VerticalAlignment="Top"
                        Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="14,6" />
            </Grid>
            <Border DockPanel.Dock="Top" Margin="0,10,0,0" Padding="12,8" CornerRadius="8" Background="#3A2F12"
                    IsVisible="{Binding ConfirmingDiscard}">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <TextBlock Text="It has changes you haven't saved." FontSize="12.5" Foreground="{StaticResource WarnBrush}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Keep editing" Command="{Binding KeepEditingCommand}"
                            Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="10,4" />
                    <Button Grid.Column="2" Content="Discard them" Command="{Binding CloseEditorCommand}"
                            Background="Transparent" Foreground="{StaticResource DangerBrush}" BorderBrush="{StaticResource DangerBrush}"
                            BorderThickness="1" Padding="10,3" />
                </Grid>
            </Border>
            <!-- Always takes its line, so the editor below doesn't jump when a message comes or goes -->
            <TextBlock DockPanel.Dock="Top" Classes="msg" Margin="0,8,0,0" Height="18" Text="{Binding EditorStatus}" FontSize="12.5"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding EditorStatus}"
                       Classes.bad="{Binding EditorStatusBad}" />
            <Border Margin="0,12,0,0" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <controls:CodeEditor Text="{Binding EditorText}" Host="{Binding Language}" />
            </Border>
        </DockPanel>
        </Grid>

        <!-- A new trellis kept in sprig -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" ZIndex="50" Background="#B3060A12" IsVisible="{Binding IsNewOpen}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelNewCommand}" />
            </Border.KeyBindings>
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" MaxWidth="680" Margin="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="New trellis" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Kept in sprig, so nothing is written to your repos. A repo with its own sprig.cs uses it; one without gets a definition kept in sprig, drafted from what's in its folder. Edit any of them afterwards." />
                    <StackPanel Spacing="4">
                        <TextBlock Classes="phead" Text="NAME" />
                        <TextBox Text="{Binding NewName}" PlaceholderText="e.g. storefront" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="phead" Text="REPO FOLDERS" />
                        <ItemsControl ItemsSource="{Binding NewRepoDirs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                        <TextBlock Classes="cell mono" Text="{Binding}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Content="✕" Padding="8,2" Background="Transparent" ToolTip.Tip="Leave it out"
                                                Foreground="{StaticResource MutedBrush}" CommandParameter="{Binding}"
                                                Command="{Binding $parent[UserControl].((vm:TrellisesViewModel)DataContext).RemoveNewRepoCommand}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <controls:PathBox Path="{Binding NewRepoPath}" PickFolder="True" PickerTitle="Choose a repo folder"
                                              Placeholder="path/to/a/repo" />
                            <Button Grid.Column="1" Content="Add" Command="{Binding AddNewRepoCommand}" VerticalAlignment="Center"
                                    Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="12,6" />
                        </Grid>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <CheckBox IsChecked="{Binding NewWorktrees}" Content="Give each sprout its own worktrees, branching from" VerticalAlignment="Center" />
                        <TextBox Text="{Binding NewFrom}" Width="140" IsEnabled="{Binding NewWorktrees}" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding NewRandomPorts}" Content="Fresh random ports each time a sprout comes up (otherwise each keeps its own)" />
                    <TextBlock Classes="msg" Text="{Binding NewMessage}" FontSize="12" TextWrapping="Wrap" Classes.bad="{Binding NewFailed}"
                               IsVisible="{Binding NewMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,4,0,0">
                        <Button Content="Add an existing .trellis.cs instead" Command="{Binding SwitchToAddCommand}" Padding="0"
                                Background="Transparent" Foreground="{StaticResource AccentBrush}" FontSize="12.5" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelNewCommand}"
                                Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="14,7" />
                        <Button Grid.Column="2" Content="Create trellis" Command="{Binding CreateNewCommand}" IsEnabled="{Binding !IsBusy}"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="14,7" />
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- A repo for the Repos list: written in sprig, or referencing the repo's own sprig.cs -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" ZIndex="50" Background="#B3060A12" IsVisible="{Binding IsRepoFormOpen}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelRepoFormCommand}" />
                <KeyBinding Gesture="Enter" Command="{Binding SubmitRepoFormCommand}" />
            </Border.KeyBindings>
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" MaxWidth="640" Margin="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding RepoFormTitle}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Text="{Binding RepoFormHelp}" />
                    <StackPanel Spacing="4">
                        <TextBlock Classes="phead" Text="REPO FOLDER" />
                        <controls:PathBox Path="{Binding RepoFormFolder}" PickFolder="True" PickerTitle="Choose the repo's folder"
                                          Placeholder="path/to/a/repo" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="phead" Text="ID" />
                        <TextBox Text="{Binding RepoFormId}" PlaceholderText="e.g. shop-web" />
                        <TextBlock FontSize="11.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                                   Text="What trellises call it: trellis.UseRepo(&quot;the-id&quot;). Several can describe the same folder." />
                    </StackPanel>
                    <TextBlock Classes="msg" Text="{Binding RepoFormMessage}" FontSize="12" TextWrapping="Wrap" Classes.bad="{Binding RepoFormFailed}"
                               IsVisible="{Binding RepoFormMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Cancel" Command="{Binding CancelRepoFormCommand}"
                                Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="14,7" />
                        <Button Content="Add to Repos" Command="{Binding SubmitRepoFormCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="14,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Deleting a trellis kept in sprig -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" ZIndex="50" Background="#B3060A12" IsVisible="{Binding ConfirmingRemove}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelRemoveCommand}" />
            </Border.KeyBindings>
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource DangerBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" MaxWidth="560" Margin="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="{Binding Selected.Name, StringFormat='Delete {0}?'}" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}" />
                    <TextBlock Classes="cell" Text="It's kept only in sprig, so its file goes too. Definitions it uses stay for other trellises. Take down or remove its sprouts first: without the trellis they can't be brought up again." />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Keep it" Command="{Binding CancelRemoveCommand}" Background="{StaticResource ButtonBgBrush}"
                                Foreground="{StaticResource FgBrush}" Padding="14,7" />
                        <Button Content="Delete it" Command="{Binding RemoveCommand}" CommandParameter="{Binding Selected}"
                                Background="{StaticResource DangerBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="14,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Add a trellis: a modal so the path has the room a narrow list column can't give it. -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" ZIndex="50" Background="#B3060A12" IsVisible="{Binding IsAddOpen}">
            <Border.KeyBindings>
                <KeyBinding Gesture="Escape" Command="{Binding CancelAddCommand}" />
                <KeyBinding Gesture="Enter" Command="{Binding AddCommand}" />
            </Border.KeyBindings>
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="28,24" MaxWidth="680" Margin="32"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                <StackPanel Spacing="12">
                    <TextBlock Text="Add a trellis" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}" />
                    <TextBlock FontSize="12.5" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                               Text="Choose a .trellis.cs file. It's listed straight away; nothing in it runs until you approve it." />
                    <controls:PathBox x:Name="AddPath" Path="{Binding NewPath}" FileSuffix=".trellis.cs"
                                      PickerTitle="Choose a trellis file" Placeholder="path/to/storefront.trellis.cs" />
                    <TextBlock Classes="msg" Text="{Binding AddMessage}" FontSize="12" TextWrapping="Wrap"
                               Classes.bad="{Binding AddFailed}"
                               IsVisible="{Binding AddMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                        <Button Content="Cancel" Command="{Binding CancelAddCommand}"
                                Background="{StaticResource ButtonBgBrush}" Foreground="{StaticResource FgBrush}" Padding="14,7" />
                        <Button Content="Add trellis" Command="{Binding AddCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" FontWeight="SemiBold" Padding="14,7" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
