<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sprig.App.ViewModels"
             x:Class="Sprig.App.Views.WorkspacesView"
             x:DataType="vm:WorkspacesViewModel">
    <Grid Margin="28,20,24,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="{StaticResource ListPaneMaxWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left: header + list -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*" Margin="0,0,16,0">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Workspaces" FontSize="22" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}" />
                    <ProgressBar IsIndeterminate="True" Width="90" Height="4" VerticalAlignment="Center"
                                 IsVisible="{Binding Busy}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="New workspace" Command="{Binding NewWorkspaceCommand}"
                            AutomationProperties.AutomationId="workspace.new"
                            ToolTip.Tip="Ad-hoc create — lets you stand up a subset of a stack's repos. The usual path is Checkout on a pool below." />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                </StackPanel>
            </Grid>

            <!-- Grouped by pool: one card per stack (capacity + checkout), its workspaces listed under it.
                 The rows across every pool share a single selection (VM.Selected), so picking one anywhere
                 drives the detail pane and deselects the rest. -->
            <ScrollViewer Grid.Row="1" IsVisible="{Binding HasPools}" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Pools}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PoolGroupViewModel">
                            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel Spacing="8">
                                    <!-- Pool header: stack · capacity · status · checkout -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Grid.Column="0" Spacing="1" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Stack}" FontWeight="SemiBold" FontSize="14"
                                                           Foreground="{StaticResource TitleBrush}" />
                                                <TextBlock Text="{Binding CapacitySummary}" FontSize="12" VerticalAlignment="Center"
                                                           Foreground="{StaticResource AccentBrush}" IsVisible="{Binding IsPool}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StatusSummary}" FontSize="11"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       IsVisible="{Binding StatusSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="Checkout" VerticalAlignment="Center"
                                                FontSize="12" Padding="12,4" IsVisible="{Binding IsPool}"
                                                IsEnabled="{Binding CanCheckout}"
                                                ToolTip.Tip="{Binding CheckoutBlockedReason}"
                                                Background="{StaticResource AccentBrush}" Foreground="#0B1220"
                                                Command="{Binding $parent[UserControl].((vm:WorkspacesViewModel)DataContext).CheckoutCommand}"
                                                CommandParameter="{Binding}" />
                                    </Grid>

                                    <!-- Empty pool: nothing built yet -->
                                    <TextBlock IsVisible="{Binding IsEmptyPool}" FontSize="11" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="No workspaces built yet — Checkout builds the first one." />

                                    <!-- Workspaces in this pool -->
                                    <ListBox IsVisible="{Binding HasWorkspaces}" ItemsSource="{Binding Workspaces}"
                                             Background="Transparent" Padding="0"
                                             SelectedItem="{Binding $parent[UserControl].((vm:WorkspacesViewModel)DataContext).Selected, Mode=TwoWay}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WorkspaceItemViewModel">
                                                <Grid ColumnDefinitions="Auto,*" Margin="0,3">
                                                    <!-- claimed ● / free ○ dot -->
                                                    <TextBlock Grid.Column="0" Text="●" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                               IsVisible="{Binding Claimed}" Foreground="{StaticResource OkBrush}" />
                                                    <TextBlock Grid.Column="0" Text="○" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"
                                                               IsVisible="{Binding Free}" Foreground="{StaticResource MutedBrush}" />
                                                    <StackPanel Grid.Column="1" Spacing="1">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" />
                                                            <TextBlock Text="⚠ degraded" FontSize="11" VerticalAlignment="Center"
                                                                       IsVisible="{Binding SetupFailed}" Foreground="{StaticResource WarnBrush}" />
                                                        </StackPanel>
                                                        <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}"
                                                                   TextTrimming="CharacterEllipsis">
                                                            <Run Text="{Binding StateSummary}" /><Run Text="   " /><Run Text="{Binding AgeSummary}" />
                                                        </TextBlock>
                                                        <TextBlock IsVisible="{Binding IsPartial}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource WarnBrush}">
                                                            <Run Text="partial · " /><Run Text="{Binding PartialSummary}" />
                                                        </TextBlock>
                                                        <TextBlock IsVisible="{Binding TeardownFailed}" FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource WarnBrush}"
                                                                   Text="teardown failed — retry to finish" />
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Right: detail card -->
        <Border Grid.Column="1" Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="18">
            <Panel>
                <!-- empty: no pools at all (no stacks upstream) — point back to Stacks -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Spacing="12"
                            IsVisible="{Binding !HasPools}">
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}"
                               Text="Workspaces come from a stack's pool — and you don't have a stack yet. Build one first, then check out a workspace from it." />
                    <Button Content="Build a stack  →" Command="{Binding BuildStackCommand}"
                            Background="{StaticResource AccentBrush}" Foreground="#0B1220" HorizontalAlignment="Center" />
                </StackPanel>

                <!-- pools exist, nothing selected: point at Checkout -->
                <TextBlock VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="440" Foreground="{StaticResource MutedBrush}"
                           Text="Pick a workspace to see its detail — or Checkout from a pool to claim one.">
                    <TextBlock.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="HasPools" />
                            <Binding Path="!HasSelected" />
                        </MultiBinding>
                    </TextBlock.IsVisible>
                </TextBlock>

                <!-- detail -->
                <ScrollViewer IsVisible="{Binding HasSelected}" AutomationProperties.AutomationId="workspace.detail">
                    <StackPanel Spacing="16">

                        <!-- title + drift -->
                        <StackPanel Spacing="2">
                            <TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="SemiBold"
                                       Foreground="{StaticResource TitleBrush}" />
                            <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                                <Run Text="stack: " /><Run Text="{Binding Selected.Stack}" />
                                <Run Text="   status: " /><Run Text="{Binding Selected.Status}" />
                                <Run Text="   drift: " /><Run Text="{Binding Selected.Drift, FallbackValue='—'}" />
                            </TextBlock>
                            <!-- Pool state: claimed (with its label) or free, plus how long ago. -->
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="●" FontSize="12" VerticalAlignment="Center"
                                           IsVisible="{Binding Selected.Claimed}" Foreground="{StaticResource OkBrush}" />
                                <TextBlock Text="○" FontSize="12" VerticalAlignment="Center"
                                           IsVisible="{Binding Selected.Free}" Foreground="{StaticResource MutedBrush}" />
                                <TextBlock FontSize="12" VerticalAlignment="Center" Foreground="{StaticResource FgBrush}">
                                    <Run Text="{Binding Selected.StateSummary}" /><Run Text="   " /><Run Text="{Binding Selected.AgeSummary}" />
                                </TextBlock>
                                <TextBlock Text="⚠ degraded — setup failed" FontSize="12" VerticalAlignment="Center"
                                           IsVisible="{Binding Selected.SetupFailed}" Foreground="{StaticResource WarnBrush}" />
                            </StackPanel>
                            <!-- A partial workspace holds only some of its stack's repos; say which are
                                 missing (and which stack ports went unprovisioned as a result). -->
                            <TextBlock IsVisible="{Binding Selected.IsPartial}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource WarnBrush}">
                                <Run Text="partial workspace — " /><Run Text="{Binding Selected.PartialSummary}" />
                            </TextBlock>
                            <!-- A kept record from a teardown that couldn't finish; list what's left and
                                 how to fix it. Removing again (once the blocker's gone) resumes the sweep. -->
                            <TextBlock IsVisible="{Binding Selected.TeardownFailed}" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{StaticResource WarnBrush}">
                                <Run Text="teardown incomplete — record kept so you can retry. Remaining:" />
                                <LineBreak /><Run Text="{Binding Selected.TeardownSummary}" />
                            </TextBlock>
                        </StackPanel>

                        <!-- lifecycle toolbar -->
                        <WrapPanel Orientation="Horizontal">
                            <WrapPanel.Styles>
                                <Style Selector="Button">
                                    <Setter Property="Margin" Value="0,0,8,8" />
                                </Style>
                            </WrapPanel.Styles>
                            <Button Content="Claim" Command="{Binding ClaimCommand}"
                                    IsVisible="{Binding Selected.Free}"
                                    Background="{StaticResource AccentBrush}" Foreground="#0B1220"
                                    ToolTip.Tip="Check out this free workspace from its pool — give the checkout a label and choose how to handle its leftover state." />
                            <Button Content="Release" Command="{Binding ReleaseCommand}"
                                    IsVisible="{Binding Selected.Claimed}"
                                    Background="{StaticResource AccentBrush}" Foreground="#0B1220"
                                    ToolTip.Tip="Hand this workspace back to its pool: stop its containers (nothing removed), keep all disk state. It stays free to take — reclaim it as-is anytime." />
                            <Button Content="Reconcile" Command="{Binding ReconcileCommand}"
                                    ToolTip.Tip="Diagnose (read-only): check each worktree against the record." />
                            <Button Content="Repair" Command="{Binding RepairCommand}"
                                    AutomationProperties.AutomationId="workspace.repair"
                                    ToolTip.Tip="Fix drift: prune stale registrations and remove orphaned folders. Healthy worktrees are never touched." />
                            <Button Content="Destroy" Command="{Binding RemoveCommand}"
                                    Foreground="{StaticResource DangerBrush}" />
                        </WrapPanel>

                        <!-- remove confirm bar -->
                        <Border IsVisible="{Binding ConfirmingRemove}" Background="{StaticResource PanelBgBrush}"
                                BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="14">
                            <StackPanel Spacing="10">
                                <TextBlock Foreground="{StaticResource FgBrush}" TextWrapping="Wrap"
                                           Text="Tear down this workspace? Infra is stopped and volumes wiped; worktrees removed." />
                                <CheckBox IsChecked="{Binding RemoveForce, Mode=TwoWay}"
                                          Content="Also delete the sprig--&lt;workspace&gt; branch (loses commits made in the worktree)" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button Content="Confirm teardown" Command="{Binding ConfirmRemoveCommand}"
                                            Foreground="{StaticResource DangerBrush}" />
                                    <Button Content="Cancel" Command="{Binding CancelRemoveCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- status / error -->
                        <TextBlock IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource OkBrush}" Text="{Binding StatusMessage}" TextWrapping="Wrap" />
                        <!-- Selectable so the error (often an exception message) can be copied for debugging. -->
                        <SelectableTextBlock IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding Error}" />

                        <!-- docker status -->
                        <StackPanel Spacing="8" IsVisible="{Binding Selected.HasInfra}"
                                    AutomationProperties.AutomationId="workspace.docker">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="DOCKER" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                    <Button Content="Refresh" Command="{Binding RefreshStatusCommand}"
                                            FontSize="11" Padding="8,3"
                                            ToolTip.Tip="Re-probe this workspace's containers." />
                                    <DropDownButton Content="Manage" FontSize="11" Padding="8,3"
                                                    ToolTip.Tip="Start, stop or inspect this workspace's Docker infrastructure.">
                                        <DropDownButton.Flyout>
                                            <MenuFlyout>
                                                <MenuItem Header="Up" Command="{Binding UpCommand}"
                                                          ToolTip.Tip="docker compose up — start this workspace's infra." />
                                                <MenuItem Header="Down" Command="{Binding DownCommand}"
                                                          ToolTip.Tip="docker compose down — stop and remove this workspace's containers (volumes kept)." />
                                                <MenuItem Header="Reset" Command="{Binding ResetCommand}"
                                                          ToolTip.Tip="Restart the infra (down then up); volumes are kept." />
                                                <MenuItem Header="Open in Docker" Command="{Binding OpenDockerCommand}"
                                                          ToolTip.Tip="Open Docker Desktop to inspect this workspace's sprig-&lt;name&gt; project." />
                                            </MenuFlyout>
                                        </DropDownButton.Flyout>
                                    </DropDownButton>
                                </StackPanel>
                            </Grid>

                            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6" Padding="14">
                                <StackPanel Spacing="2">
                                    <ItemsControl ItemsSource="{Binding Selected.Containers}"
                                                  IsVisible="{Binding Selected.ShowContainers}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ContainerLineViewModel">
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" FontFamily="Consolas,monospace"
                                                               FontSize="12" Foreground="{StaticResource FgBrush}"
                                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="11"
                                                               VerticalAlignment="Center" IsVisible="{Binding Running}"
                                                               Foreground="{StaticResource OkBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding State}" FontSize="11"
                                                               VerticalAlignment="Center" IsVisible="{Binding !Running}"
                                                               Foreground="{StaticResource MutedBrush}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock IsVisible="{Binding Selected.ShowNoContainers}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource MutedBrush}"
                                               Text="No containers running — use Up to start this workspace's infra." />
                                    <TextBlock IsVisible="{Binding Selected.ShowDockerUnavailable}" FontSize="12" TextWrapping="Wrap"
                                               Foreground="{StaticResource WarnBrush}"
                                               Text="⚠ Docker isn't reachable — is Docker Desktop running?" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- repos -->
                        <ItemsControl ItemsSource="{Binding Selected.Repos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RepoLineViewModel">
                                    <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" Spacing="4">
                                                <StackPanel Orientation="Horizontal" Spacing="10">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               Foreground="{StaticResource TitleBrush}" />
                                                    <TextBlock Text="{Binding Branch}" FontSize="11"
                                                               Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StateLabel}" FontSize="11" VerticalAlignment="Center"
                                                               IsVisible="{Binding StateHealthy}" Foreground="{StaticResource OkBrush}" />
                                                    <TextBlock Text="{Binding StateLabel}" FontSize="11" VerticalAlignment="Center"
                                                               IsVisible="{Binding StateProblem}" Foreground="{StaticResource DangerBrush}" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding Inputs}" FontFamily="Consolas,monospace" FontSize="12"
                                                           Foreground="{StaticResource FgBrush}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding WorktreePath}" FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <DropDownButton Grid.Column="1" Content="Open in…" VerticalAlignment="Top"
                                                            FontSize="11" Padding="8,3" Margin="10,0,0,0">
                                                <DropDownButton.Flyout>
                                                    <MenuFlyout>
                                                        <MenuItem Header="Explorer"
                                                                  Command="{Binding $parent[UserControl].((vm:WorkspacesViewModel)DataContext).OpenRepoInExplorerCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="VS Code"
                                                                  Command="{Binding $parent[UserControl].((vm:WorkspacesViewModel)DataContext).OpenRepoInVsCodeCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="Terminal"
                                                                  Command="{Binding $parent[UserControl].((vm:WorkspacesViewModel)DataContext).OpenRepoInTerminalCommand}"
                                                                  CommandParameter="{Binding}" />
                                                    </MenuFlyout>
                                                </DropDownButton.Flyout>
                                            </DropDownButton>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                    </StackPanel>
                </ScrollViewer>
            </Panel>
        </Border>

        <!-- Create overlay -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsCreating}" Background="#B0000000"
                Margin="-28,-20,-24,-16">
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="22" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="New workspace" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Stack" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <ComboBox ItemsSource="{Binding AvailableStacks}" SelectedItem="{Binding NewStack, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <!-- Partial workspace: untick a repo you don't need this time. Only shown when the
                         stack has more than one repo (nothing to choose otherwise). -->
                    <StackPanel Spacing="4" IsVisible="{Binding CanChooseRepos}">
                        <TextBlock Text="Repos" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <ItemsControl ItemsSource="{Binding NewRepos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkspaceRepoChoiceViewModel">
                                    <CheckBox IsChecked="{Binding Included, Mode=TwoWay}" Content="{Binding Name}"
                                              Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock IsVisible="{Binding PartialHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Text="{Binding PartialHint}" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{StaticResource WarnBrush}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Workspace name" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <TextBox Text="{Binding NewName, Mode=TwoWay}" PlaceholderText="e.g. feature-x" />
                    </StackPanel>
                    <CheckBox IsChecked="{Binding StartInfraOnCreate, Mode=TwoWay}"
                              Content="Start its Docker infrastructure now"
                              ToolTip.Tip="Runs docker compose up right after creating. Ignored if the stack has no infra." />

                    <!-- Proactive engine check: if "start infra" is asked for but Docker Desktop isn't
                         running, say so now (with a way to fix it) instead of failing after create. -->
                    <Border IsVisible="{Binding ShowDockerWarning}" CornerRadius="6" Padding="10,8"
                            Background="{StaticResource FormBgBrush}" BorderBrush="{StaticResource WarnBrush}" BorderThickness="1">
                        <StackPanel Spacing="8">
                            <TextBlock Foreground="{StaticResource WarnBrush}" FontSize="12" TextWrapping="Wrap"
                                       Text="⚠ Docker isn't running. Start Docker Desktop and recheck, or the workspace will be created without starting its infra (you can start it later from the Workspaces list)." />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Open Docker Desktop" Command="{Binding OpenDockerDesktopCommand}"
                                        FontSize="12" Padding="8,3" />
                                <Button Content="Recheck" Command="{Binding RecheckDockerCommand}"
                                        FontSize="12" Padding="8,3" IsEnabled="{Binding !CheckingDocker}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock IsVisible="{Binding CheckingDocker}" Foreground="{StaticResource MutedBrush}" FontSize="11"
                               Text="Checking Docker…" />

                    <TextBlock IsVisible="{Binding CreateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding CreateError}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Create" Command="{Binding CreateCommand}"
                                AutomationProperties.AutomationId="workspace.create"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                        <Button Content="Cancel" Command="{Binding CancelCreateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- Checkout overlay -->
        <Border Grid.Column="0" Grid.ColumnSpan="2" IsVisible="{Binding IsCheckingOut}" Background="#B0000000"
                Margin="-28,-20,-24,-16">
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="22" Width="440"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TitleBrush}">
                        <Run Text="Checkout — " /><Run Text="{Binding CheckoutStack}" />
                    </TextBlock>

                    <!-- Target: reuse a free workspace, or build a new one within capacity. -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="Workspace" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <RadioButton GroupName="checkoutTarget" Content="Reuse a free workspace"
                                     IsEnabled="{Binding CanReuseWorkspace}"
                                     IsChecked="{Binding CheckoutReuse, Mode=TwoWay}" />
                        <ComboBox ItemsSource="{Binding CheckoutFreeWorkspaces}" SelectedItem="{Binding CheckoutTarget, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" Margin="24,0,0,0"
                                  IsVisible="{Binding CheckoutReuse}" IsEnabled="{Binding CheckoutReuse}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkspaceItemViewModel">
                                    <TextBlock>
                                        <Run Text="{Binding Name}" /><Run Text="  ·  " /><Run Text="{Binding StateSummary}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <RadioButton GroupName="checkoutTarget" Content="Build a new workspace"
                                     IsEnabled="{Binding CanCheckoutNew}"
                                     IsChecked="{Binding CheckoutNew, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Handling: only when reusing. as-is resumes; fresh resyncs everything to base (wipes
                         volumes); refresh resyncs a chosen subset. -->
                    <StackPanel Spacing="6" IsVisible="{Binding ShowHandling}">
                        <TextBlock Text="Handling" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <RadioButton GroupName="checkoutMode" IsChecked="{Binding ModeAsIs, Mode=TwoWay}"
                                     Content="As-is — resume exactly as it was left"
                                     ToolTip.Tip="Fastest: no git changes, volumes and installed deps kept." />
                        <RadioButton GroupName="checkoutMode" IsChecked="{Binding ModeFresh, Mode=TwoWay}"
                                     Content="Fresh — resync every repo to base, wipe volumes"
                                     ToolTip.Tip="Clean base and clean DB; installed deps kept (setup reconciles them)." />
                        <RadioButton GroupName="checkoutMode" IsChecked="{Binding ModeRefresh, Mode=TwoWay}"
                                     Content="Refresh some repos — resync only the ones you pick"
                                     ToolTip.Tip="Move chosen repos to base; the rest stay as they are, volumes kept." />
                        <ItemsControl ItemsSource="{Binding CheckoutRefreshRepos}" Margin="24,2,0,0"
                                      IsVisible="{Binding ShowRefreshRepos}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:WorkspaceRepoChoiceViewModel">
                                    <CheckBox IsChecked="{Binding Included, Mode=TwoWay}" Content="{Binding Name}" Margin="0,1" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Label: required, describes what this checkout is for. -->
                    <StackPanel Spacing="4">
                        <TextBlock Text="Label" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <TextBox Text="{Binding CheckoutLabel, Mode=TwoWay}" PlaceholderText="e.g. billing-bug repro" />
                    </StackPanel>

                    <TextBlock IsVisible="{Binding CheckoutError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding CheckoutError}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Checkout" Command="{Binding ConfirmCheckoutCommand}"
                                AutomationProperties.AutomationId="pool.checkout.confirm"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                        <Button Content="Cancel" Command="{Binding CancelCheckoutCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
