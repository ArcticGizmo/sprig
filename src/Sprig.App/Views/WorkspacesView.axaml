<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Sprig.App.ViewModels"
             x:Class="Sprig.App.Views.WorkspacesView"
             x:DataType="vm:WorkspacesViewModel">
    <Grid RowDefinitions="Auto,*" Margin="0">

        <!-- Header / toolbar -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="28,20,24,12">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                <TextBlock Text="Workspaces" FontSize="22" FontWeight="SemiBold"
                           Foreground="{StaticResource TitleBrush}" />
                <ProgressBar IsIndeterminate="True" Width="90" Height="4" VerticalAlignment="Center"
                             IsVisible="{Binding Busy}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="New workspace" Command="{Binding NewWorkspaceCommand}"
                        Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" />
            </StackPanel>
        </Grid>

        <!-- Master / detail -->
        <Grid Grid.Row="1" ColumnDefinitions="300,*">

            <ListBox Grid.Column="0" Margin="16,0,8,16"
                     ItemsSource="{Binding Workspaces}"
                     SelectedItem="{Binding Selected, Mode=TwoWay}">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:WorkspaceItemViewModel">
                        <StackPanel Spacing="2" Margin="4,6">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock FontSize="11" Foreground="{StaticResource MutedBrush}">
                                <Run Text="{Binding Stack}" /><Run Text="  ·  " /><Run Text="{Binding Status}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty state: no stack upstream — a workspace needs one, so point back to Stacks. -->
            <StackPanel Grid.Column="1" Margin="24" VerticalAlignment="Top" MaxWidth="460" Spacing="12">
                <StackPanel.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!HasWorkspaces" />
                        <Binding Path="!HasAnyStacks" />
                    </MultiBinding>
                </StackPanel.IsVisible>
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="Workspaces are created from a stack — and you don't have one yet. Build a stack first, then spin up a workspace from it." />
                <Button Content="Build a stack  →" Command="{Binding BuildStackCommand}"
                        Background="{StaticResource AccentBrush}" Foreground="#0B1220" HorizontalAlignment="Left" />
            </StackPanel>

            <!-- Empty state: stacks exist, just no workspaces yet. -->
            <TextBlock Grid.Column="1" Margin="24" VerticalAlignment="Top"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"
                       Text="No workspaces yet. Click &quot;New workspace&quot; above to create your first isolated workspace from a stack.">
                <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="!HasWorkspaces" />
                        <Binding Path="HasAnyStacks" />
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>

            <!-- Empty state: have workspaces, none selected -->
            <TextBlock Grid.Column="1" Margin="24" VerticalAlignment="Top"
                       Foreground="{StaticResource MutedBrush}"
                       Text="Select a workspace from the list.">
                <TextBlock.IsVisible>
                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="HasWorkspaces" />
                        <Binding Path="!HasSelected" />
                    </MultiBinding>
                </TextBlock.IsVisible>
            </TextBlock>

            <!-- Detail -->
            <ScrollViewer Grid.Column="1" IsVisible="{Binding HasSelected}" Margin="16,0,24,16">
                <StackPanel Spacing="16">

                    <!-- title + drift -->
                    <StackPanel Spacing="2">
                        <TextBlock Text="{Binding Selected.Name}" FontSize="20" FontWeight="SemiBold"
                                   Foreground="{StaticResource TitleBrush}" />
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}">
                            <Run Text="stack: " /><Run Text="{Binding Selected.Stack}" />
                            <Run Text="   status: " /><Run Text="{Binding Selected.Status}" />
                            <Run Text="   drift: " /><Run Text="{Binding Selected.Drift, FallbackValue='—'}" />
                        </TextBlock>
                    </StackPanel>

                    <!-- lifecycle toolbar -->
                    <WrapPanel Orientation="Horizontal">
                        <WrapPanel.Styles>
                            <Style Selector="Button">
                                <Setter Property="Margin" Value="0,0,8,8" />
                            </Style>
                        </WrapPanel.Styles>
                        <Button Content="Up" Command="{Binding UpCommand}"
                                IsVisible="{Binding Selected.HasInfra}" />
                        <Button Content="Down" Command="{Binding DownCommand}"
                                IsVisible="{Binding Selected.HasInfra}" />
                        <Button Content="Reset" Command="{Binding ResetCommand}"
                                IsVisible="{Binding Selected.HasInfra}" />
                        <Button Content="Reconcile" Command="{Binding ReconcileCommand}"
                                ToolTip.Tip="Diagnose (read-only): check each worktree against the record." />
                        <Button Content="Repair" Command="{Binding RepairCommand}"
                                ToolTip.Tip="Fix drift: prune stale registrations and remove orphaned folders. Healthy worktrees are never touched." />
                        <Button Content="Open folder" Command="{Binding OpenCommand}" />
                        <Button Content="Remove" Command="{Binding RemoveCommand}"
                                Foreground="{StaticResource DangerBrush}" />
                    </WrapPanel>

                    <!-- remove confirm bar -->
                    <Border IsVisible="{Binding ConfirmingRemove}" Background="{StaticResource PanelBgBrush}"
                            BorderBrush="{StaticResource DangerBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Foreground="{StaticResource FgBrush}"
                                       Text="Tear down this workspace? Infra is stopped and volumes wiped; worktrees removed." />
                            <CheckBox IsChecked="{Binding RemoveForce, Mode=TwoWay}"
                                      Content="Also delete the sprig/&lt;workspace&gt; branch (loses commits made in the worktree)" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Confirm teardown" Command="{Binding ConfirmRemoveCommand}"
                                        Foreground="{StaticResource DangerBrush}" />
                                <Button Content="Cancel" Command="{Binding CancelRemoveCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- status / error -->
                    <TextBlock IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource OkBrush}" Text="{Binding StatusMessage}" />
                    <TextBlock IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding Error}" />

                    <!-- repos -->
                    <ItemsControl ItemsSource="{Binding Selected.Repos}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:RepoLineViewModel">
                                <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                                    <StackPanel Spacing="4">
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TitleBrush}" />
                                            <TextBlock Text="{Binding Branch}" FontSize="11"
                                                       Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding StateLabel}" FontSize="11" VerticalAlignment="Center"
                                                       IsVisible="{Binding StateHealthy}" Foreground="{StaticResource OkBrush}" />
                                            <TextBlock Text="{Binding StateLabel}" FontSize="11" VerticalAlignment="Center"
                                                       IsVisible="{Binding StateProblem}" Foreground="{StaticResource DangerBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Inputs}" FontFamily="Consolas,monospace" FontSize="12"
                                                   Foreground="{StaticResource FgBrush}" />
                                        <TextBlock Text="{Binding WorktreePath}" FontSize="11"
                                                   Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Create overlay -->
        <Border Grid.Row="1" IsVisible="{Binding IsCreating}" Background="#B0000000">
            <Border Background="{StaticResource PanelBgBrush}" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="22" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="New workspace" FontSize="18" FontWeight="SemiBold"
                               Foreground="{StaticResource TitleBrush}" />
                    <StackPanel Spacing="4">
                        <TextBlock Text="Stack" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <ComboBox ItemsSource="{Binding AvailableStacks}" SelectedItem="{Binding NewStack, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock Text="Workspace name" Foreground="{StaticResource MutedBrush}" FontSize="12" />
                        <TextBox Text="{Binding NewName, Mode=TwoWay}" PlaceholderText="e.g. feature-x" />
                    </StackPanel>
                    <TextBlock IsVisible="{Binding CreateError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Text="{Binding CreateError}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Create" Command="{Binding CreateCommand}"
                                Background="{StaticResource AccentBrush}" Foreground="#0B1220" />
                        <Button Content="Cancel" Command="{Binding CancelCreateCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
