<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sprig.Core\Sprig.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test suite drives the dispatcher through the internal Run(args, ISprigPaths) seam. -->
    <InternalsVisibleTo Include="Sprig.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- `sprig update` drives Velopack directly (check/download/apply). Keep the version in step
         with Sprig.App's reference — both must resolve the same feed/package format. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- The command framework: routing, parsing and hierarchical help. Flows transitively to
         Sprig.Tests, which drives the CommandApp through CliApp's Run(args, ISprigPaths) seam. -->
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ships alongside the GUI in the Velopack package as `sprig.exe`: the command users type, and
         the name the CLI's own help prints. sprig-gui.exe is the app; sprig.exe is the CLI. -->
    <AssemblyName>sprig</AssemblyName>
    <Product>Sprig</Product>
    <Company>Sprig</Company>
  </PropertyGroup>

</Project>
