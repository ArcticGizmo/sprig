<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sprig.Core\Sprig.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test suite drives the dispatcher through the internal Run(args, ISprigPaths) seam. -->
    <InternalsVisibleTo Include="Sprig.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- `sprig update` drives Velopack directly (check/download/apply). Keep the version in step
         with Sprig.App's reference — both must resolve the same feed/package format. -->
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- The command framework: routing, parsing and hierarchical help. Flows transitively to
         Sprig.Tests, which drives the CommandApp through CliApp's Run(args, ISprigPaths) seam. -->
    <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ships alongside the GUI in the Velopack package as `sprig.exe`: the command users type, and
         the name the CLI's own help prints. sprig-gui.exe is the app; sprig.exe is the CLI. -->
    <AssemblyName>sprig</AssemblyName>
    <Product>Sprig</Product>
    <Company>Sprig</Company>
  </PropertyGroup>

  <!-- Publish-only: sprig.exe ships in the same folder as the GUI, whose runtime is trimmed to what the
       GUI uses. A single file carries its own trimmed runtime, so it neither depends on nor overwrites
       the GUI's. Trimming strips the framework's precompiled code, which costs every command ~230ms of
       JIT at startup; ReadyToRun puts it back (~17MB) because the shell shims make the CLI interactive.
       Partial trim, STJ reflection and the quiet analyzer for the same reasons as Sprig.App. -->
  <PropertyGroup>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>true</JsonSerializerIsReflectionEnabledByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
