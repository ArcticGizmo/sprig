{
  // The sample API is SELF-DESCRIBING. It declares what it PROVIDES: an `api` capability
  // (its own port, plus a `url` built from that port) and a `db` capability (its database
  // port). Nothing external "supplies" these — the repo owns them, and a map wires other
  // repos to them by capability name.
  "schema": 3,
  "name": "sample-api",
  // A repo's provides/needs/env/compose/setup live inside a MODULE. This sample is a single
  // slice at the repo root, so it has one module, "app". A monorepo would list several —
  // apps/web, apps/api — each with its own path, provides, needs, env and compose.
  "modules": [
    {
      "name": "app",
      "path": "",
      "provides": [
        {
          "capability": "api",
          "outputs": {
            "port": { "port": true },
            "url": "http://localhost:${sprig.api.port}"
          }
        },
        {
          "capability": "db",
          "outputs": { "port": { "port": true } }
        }
      ],
      "env": [
        {
          "file": ".env",
          "templates": [".env.template"],
          "set": {
            "PORT": "${sprig.api.port}",
            "DATABASE_URL": "postgres://sample:sample@localhost:${sprig.db.port}/sample"
          }
        }
      ],
      "compose": [
        {
          "file": "docker-compose.yml",
          "overrides": [
            { "path": ["services", "db", "container_name"], "template": "sample-db--${sprig.workspace}" },
            { "path": ["services", "db", "ports", "0"], "template": "${sprig.db.port}:5432" }
          ]
        }
      ]
    }
  ]
}
