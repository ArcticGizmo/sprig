{
  // The sample web app needs its own port AND a URL for the API. Note that it does not
  // know the API's port — it asks for a finished `apiUrl`, and the stack composes one.
  "schema": 2,
  "name": "sample-web",
  "inputs": [
    { "name": "port", "example": "3000", "description": "Port this web app listens on" },
    { "name": "apiUrl", "example": "http://localhost:5000", "description": "Where to reach the sample API" }
  ],
  "env": [
    {
      "file": ".env",
      "templates": [".env.template"],
      "set": {
        "PORT": "${sprig.port}",
        "VITE_API_URL": "${sprig.apiUrl}"
      }
    }
  ]
}
