<Project Sdk="Microsoft.NET.Sdk">

  <!-- The only project allowed unsafe code: the source-generated COM interop needs it, and keeping that here leaves
       the rest of sprig unable to write pointer code without the compiler objecting. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

</Project>
