<Project Sdk="Microsoft.NET.Sdk">

  <!-- What sprig.cs definitions reference (#:package ArcticGizmo.Sprig.Sdk). Kept free of engine and UI dependencies
       so a definition restores and compiles quickly in any editor. The release workflow packs it at the tag's version,
       which is also the version a released sprig writes into new definitions. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sprig</RootNamespace>
    <Version>0.8.2</Version>
    <!-- Docs ship for IntelliSense. Undocumented members (CS1591) and partial param docs (CS1573) are allowed. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>ArcticGizmo.Sprig.Sdk</PackageId>
    <Authors>ArcticGizmo</Authors>
    <Company>ArcticGizmo</Company>
    <Title>Sprig SDK</Title>
    <Description>What a sprig.cs definition is written against: describe a repo's apps, infra and settings in C#, and sprig runs it, or any branch of it, in isolation with its own ports, data and env files.</Description>
    <PackageTags>sprig;worktree;dev-environment;docker-compose;orchestration</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/ArcticGizmo/sprig</PackageProjectUrl>
    <RepositoryUrl>https://github.com/ArcticGizmo/sprig</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sprig.Tests" />
  </ItemGroup>

</Project>
