<Project Sdk="Microsoft.NET.Sdk">

  <!-- What sprig.cs definitions reference (#:package Sprig.Sdk). Kept free of engine and UI dependencies so a
       definition restores and compiles quickly in any editor. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sprig</RootNamespace>
    <PackageId>Sprig.Sdk</PackageId>
    <Version>0.1.0-exp</Version>
    <IsPackable>true</IsPackable>
    <!-- Docs ship for IntelliSense. Undocumented members (CS1591) and partial param docs (CS1573) are allowed
         while the SDK's shape is still a spike; revisit before the SDK is published. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sprig.Tests" />
  </ItemGroup>

</Project>
